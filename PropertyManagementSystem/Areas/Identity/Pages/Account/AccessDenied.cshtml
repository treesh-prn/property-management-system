@page
@model AccessDeniedModel
@inject PropertyManagementSystem.Services.IRoleService RoleService
@{
    ViewData["Title"] = "Access denied";
    var assignedRoles = (await RoleService.GetRolesAsync(User)).ToList();
    var hasAssignedRole = assignedRoles.Count > 0;
}

<main class="container-tight py-5">
    <div class="request-empty-state" role="alert">
        <span class="request-empty-icon text-danger" aria-hidden="true"><i class="ti ti-lock"></i></span>
        <h1>@(hasAssignedRole ? "Access denied" : "Role required")</h1>
        @if (hasAssignedRole)
        {
            <p>You do not have permission to open this page with your current role.</p>
        }
        else
        {
            <p>Your account does not have an assigned GFMS role. You are not allowed to create or manage reservations yet.</p>
            <p class="text-secondary">Please contact the system administrator to request access.</p>
        }
        <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-primary">
            <i class="ti ti-home" aria-hidden="true"></i> Return Home
        </a>
    </div>
</main>
