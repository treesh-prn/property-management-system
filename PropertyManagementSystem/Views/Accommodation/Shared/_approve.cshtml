@model PropertyManagementSystem.Models.ReservationViewModel;
@*APPROVE MODAL*@
<div class="modal modal-blur fade" id="modal-approve-@Model.ReservationDetails.FirstOrDefault().ReservationDetailId" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-md modal-dialog-centered" role="document">
        <div class="modal-content">
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            <div class="modal-status bg-info"></div>
            <div class="modal-body text-center py-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="icon mb-2 text-info icon-lg" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M12 9v4" /><path d="M10.363 3.591l-8.106 13.534a1.914 1.914 0 0 0 1.636 2.871h16.214a1.914 1.914 0 0 0 1.636 -2.87l-8.106 -13.536a1.914 1.914 0 0 0 -3.274 0z" /><path d="M12 16h.01" /></svg>
                <h3>Save assignments and approve?</h3>
                <div class="text-secondary">
                    @if (Model.ReservationHeader.Status == "FOR ADMIN APPROVER'S APPROVAL" ||
                         Model.ReservationHeader.Status == "FOR ADMIN MANAGER'S APPROVAL")
                    {
                        <span>All selected guest rooms will be validated and saved with this approval.</span>
                    }
                    else
                    {
                        <span>Do you want to approve this reservation?</span>
                    }
                </div>
            </div>
            <form asp-action="UpdateReservationStatus" method="post" data-guest-room-approval-form>
                @Html.AntiForgeryToken()
                <input type="hidden" name="action" value="Approve" />
                <div data-assignment-fields></div>
                <div class="modal-footer">
                    <div class="w-100">
                        <input type="hidden" value="@Model.ReservationHeader.Status" />
                        <div class="row">
                            <div class="col">
                                <a href="#" class="btn w-100" data-bs-dismiss="modal">
                                    Go Back
                                </a>
                            </div>
                            <div class="col">
                                <button type="submit" class="btn btn-success w-100">
                                    <i class="ti ti-check m-1"></i> Approve
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                <input type="hidden" name="ReservationDetailId" value="@Model.ReservationDetails.FirstOrDefault().ReservationDetailId">
                <input type="hidden" name="ReservationId" value="@Model.ReservationDetails.FirstOrDefault().ReservationId" />
            </form>
        </div>
    </div>
</div>
@*APPROVE MODAL*@
