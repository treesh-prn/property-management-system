@model PropertyManagementSystem.Models.ReservationViewModel
@inject PropertyManagementSystem.Services.IRoleService RoleService
@{
    var employee = await RoleService.GetUserName(User);
}
<form asp-action="UpdateReservationDetails" asp-controller="Accommodation" method="post">
    view
    <input type="hidden" name="ReservationId" value="@Model.ReservationHeader.ReservationId">
    <div class="modal-body">
        <div class="row mb-3">
            <div class="col-lg-2">
                <label class="form-label">Guest Name</label>
            </div>
            <div class="col-lg-3">
                <label class="form-label">Company</label>
            </div>
            <div class="col-lg-2">
                <label class="form-label">Relationship</label>
            </div>
            <div class="col-lg-3">
                <label class="form-label">Guesthouse</label>
            </div>
            <div class="col-lg-2">
                <label class="form-label">Room</label>
            </div>
        </div>
        <div id="dynamic-rows">
            @foreach (var detail in Model.ReservationDetails)
            {
                <div class="row mb-3">
                    <input type="hidden" class="form-control" name="@detail.ReservationDetailId" placeholder="Guest Name" value="@detail.ReservationDetailId" read>
                    <div class="col-lg-2">
                        @* <label class="form-label">Guest Name</label> *@
                        <input type="text" class="form-control" name="_guests[]" placeholder="Guest Name" value="@detail.GuestName" readonly>
                    </div>
                    <div class="col-lg-3">
                        @* <label class="form-label">Company</label> *@
                        <input type="text" class="form-control" name="_company[]" placeholder="Company" value="@detail.Company" readonly>
                    </div>
                    <div class="col-lg-2">
                        @* <label class="form-label">Relationship</label> *@
                        <input type="text" class="form-control" name="_relationship[]" placeholder="Input Relationship if applicable" value="@detail.Relationship" readonly>
                    </div>

                    <div class="col-lg-3">
                        @(
                            Html.Kendo().DropDownList()
                            .Name($"_facilityId_{detail.ReservationDetailId}")
                            .DataTextField("FacilityName")
                            .DataValueField("FacilityId")
                            .Value(detail.FacilityId.ToString())
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("GetFacility", "Accommodation");
                                });
                            })
                            .HtmlAttributes(new { style = "width: 100%; font-family: var(--tblr-font-sans-serif); font-size: .875rem; font-weight: 500; border-color: var(--tblr-bg-forms); opacity: .8;" })
                            .OptionLabel("Select Facility")
                            )
                    </div>
                    <div class="col-lg-2">
                        @(
                            Html.Kendo().DropDownList()
                            .Name($"_roomId_{detail.ReservationDetailId}")
                            .DataTextField("RoomName")
                            .DataValueField("RoomId")
                            .Value(detail.RoomId.ToString())
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("GetRoom", "FunctionRoom");
                                });
                            })
                            .HtmlAttributes(new { style = "width: 100%; font-family: var(--tblr-font-sans-serif); font-size: .875rem; font-weight: 500; border-color: var(--tblr-bg-forms); opacity: .8;" })
                            .OptionLabel("Select Room")
                            )
                    </div>
                </div>
            }
        </div>
        <div class="row mb-3">
            <label class="form-label">Duration of Stay</label>
            <div class="col-lg-6">
                <label class="form-label required">Arrival Date and Time</label>
                @(
                    Html.Kendo().DateTimePicker()
                    .Name("StartDate")
                    .Value(Model.ReservationDetails.FirstOrDefault()?.StartDate)
                    .DateInput(true)
                    .Format("yyyy/MM/dd HH:mm:ss.fff")
                    .ParseFormats(new string[] { "yyyy/MM/dd HH:mm:ss.fff", "yyyy-MM-ddTHH:mm:ss.fffZ" })
                    .HtmlAttributes(new { style = "width: 100%; font-size: 15px; font-weight: bold; border-color: var(--tblr-muted); opacity: .8;", @readonly = "readonly" })
                    )
            </div>
            <div class="col-lg-6">
                <label class="form-label required">Departure Date and Time</label>
                @(
                    Html.Kendo().DateTimePicker()
                    .Name("EndDate")
                    .Value(Model.ReservationDetails.FirstOrDefault()?.EndDate)
                    .Format("yyyy/MM/dd HH:mm:ss.fff")
                    .ParseFormats(new string[] { "yyyy/MM/dd HH:mm:ss.fff", "yyyy-MM-ddTHH:mm:ss.fffZ" })
                    .HtmlAttributes(new { style = "width: 100%; font-size: 15px; font-weight: bold; border-color: var(--tblr-muted); opacity: .8;", @readonly = "readonly" })
                    )
            </div>
        </div>
        <div class="col-lg-12">
            <label class="form-label">
                Purpose
                <span class="form-label-description">26/50</span>
            </label>
            <textarea class="form-control" rows="3" name="Purpose" disabled>@Model.ReservationDetails.FirstOrDefault()?.Purpose</textarea>
        </div>
    </div>
    <div class="modal-footer">
        <div class="ms-auto">
            @if (Model.ReservationHeader.Requestor == employee.Fullname && Model.ReservationHeader.Status != "CANCELLED" && Model.ReservationHeader.Status != "DISAPPROVED")
            {
                @if (Model.ReservationDetails.First().StartDate >= DateTime.Today.AddHours(DateTime.Now.Hour - 1))
                {
                    <button type="button" class="btn btn-red m-1" data-bs-toggle="modal" data-bs-target="#modal-danger">
                        <span>
                            <i class="ti ti-x m-1"></i>
                        </span>
                        Cancel
                    </button>
                    <a href="@Url.Action("ReservationList", "Accommodation")" class="btn btn-primary">
                        Go Back
                    </a>
                }
                else
                {
                    <a href="@Url.Action("ReservationList", "Accommodation")" class="btn btn-primary">
                        Go Back
                    </a>
                }
            }
            else
            {
                <a href="@Url.Action("ReservationList", "Accommodation")" class="btn btn-primary">
                    Go Back
                </a>
            }
        </div>
    </div>
</form>
@*CANCEL MODAL*@
<div class="modal modal-blur fade" id="modal-danger" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-md modal-dialog-centered" role="document">
        <div class="modal-content">
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            <div class="modal-status bg-danger"></div>
            <div class="modal-body text-center py-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="icon mb-2 text-danger icon-lg" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M12 9v4" /><path d="M10.363 3.591l-8.106 13.534a1.914 1.914 0 0 0 1.636 2.871h16.214a1.914 1.914 0 0 0 1.636 -2.87l-8.106 -13.536a1.914 1.914 0 0 0 -3.274 0z" /><path d="M12 16h.01" /></svg>
                <h3>Are you sure?</h3>
                <div class="text-secondary">Do you really want to cancel this reservation? This action cannot be undone.</div>
            </div>
            <form id="delete-form" action="@Url.Action("CancelReservation", "Global")" method="post">
                @Html.AntiForgeryToken()
                <div class="m-1">
                    <div>
                        <label class="form-label">Reason <span class="form-label-description"></span></label>
                        <textarea class="form-control" rows="2" name="Remarks" required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <div class="w-100">
                        <input type="hidden" value="@Model.ReservationHeader.Status" />
                        <div class="row">
                            <div class="col">
                                <a href="#" class="btn w-100" data-bs-dismiss="modal">
                                    Go Back
                                </a>
                            </div>
                            <div class="col">
                                <button type="submit" class="btn btn-danger w-100" id="confirm-delete">
                                    Cancel
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                <input type="hidden" name="reservationType" value="@Model.ReservationHeader.ReservationType" />
                <input type="hidden" name="ReservationId" value="@Model.ReservationHeader.ReservationId" />
            </form>
        </div>
    </div>
</div>
@*CANCEL DELETE MODAL*@