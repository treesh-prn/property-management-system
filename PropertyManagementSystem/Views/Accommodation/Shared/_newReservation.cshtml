@model PropertyManagementSystem.Models.ReservationViewModel
@using PropertyManagementSystem.Services
@inject IReservationAuthorizationService ReservationAuthorization
@{
    var actor = await ReservationAuthorization.GetActorAsync(User);
    var canChooseCostCenter = ReservationCreationPolicy.CanChooseCostCenter(actor);
    var canContinue = canChooseCostCenter || ReservationCreationPolicy.Resolve(actor, null, null) != null;
}
@*NEW RESERVATION MODAL *@
<div class="modal modal-blur fade" id="modal-newReservation" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content reservation-modal">
            <div class="modal-header">
                <div>
                    <span class="reservation-eyebrow">Guesthouse booking</span>
                    <h5 class="modal-title">New Reservation</h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="fcFRM1" asp-controller="Accommodation" asp-action="CreateReservation" method="post">
                <div class="modal-body">
                    @if (!canContinue)
                    {
                        <div class="alert alert-warning">Your employee profile must include your name, email, company and department before you can create a reservation.</div>
                    }
                    <div class="reservation-modal-intro">
                        <i class="ti ti-user-check"></i>
                        <div>
                            <strong>Confirm requestor details</strong>
                            <span>These details will be used for approval routing and reservation updates.</span>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-lg-6">
                            <label class="form-label required">Requestor Name</label>
                            <input class="form-control" name="_requestor" type="text" value="@ReservationCreationPolicy.GetRequestorName(actor)" readonly>
                        </div>
                        <div class="col-lg-6">
                            <label class="form-label required">Requestor Email</label>
                            <input class="form-control" name="_requestorEmail" type="email" value="@ReservationCreationPolicy.GetRequestorEmail(actor)" readonly>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label required">Charge to Company</label>
                        @(Html.Kendo().DropDownList()
                            .Name("_company")
                            .DataTextField("Company")
                            .DataValueField("Id")
                            .Value(actor.CompanyId?.ToString())
                            .Enable(canChooseCostCenter)
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("getCompanies", "Global");
                                });
                            })
                            .HtmlAttributes(new { style = "width: 100%; font-size: 15px; font-weight: bold; border-color: var(--tblr-muted); opacity: .8;" })
                            .OptionLabel("Select Company")
                            )
                    </div>
                    <div class="mb-3">
                        <label class="form-label required">Charge to Department</label>
                        @(Html.Kendo().DropDownList()
                            .Name("_department")
                            .DataTextField("DepartmentName")
                            .DataValueField("Id")
                            .CascadeFrom(canChooseCostCenter ? "_company" : string.Empty)
                            .Value(actor.DepartmentId?.ToString())
                            .Enable(canChooseCostCenter)
                            .OptionLabel("Select Department")
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("getDepartments", "Global").Data("filterDepartments");
                                }).ServerFiltering(true);
                            })
                            .HtmlAttributes(new { style = "width: 100%; font-size: 15px; font-weight: bold; border-color: var(--tblr-muted); opacity: .8;" })
                            )
                    </div>
                </div>
                <div class="modal-footer">
                    <button id="svbtn15" type="submit" disabled="@(!canContinue)" class="btn btn-primary ms-auto">
                        <i class="ti ti-arrow-right"></i>
                        Continue
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>
@*END - NEW RESERVATION MODAL *@
