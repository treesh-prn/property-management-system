@model PropertyManagementSystem.Models.ReservationViewModel
@inject PropertyManagementSystem.Services.IRoleService RoleService
@{
    var employee = await RoleService.GetUserName(User);
}
@*NEW RESERVATION MODAL *@
<div class="modal modal-blur fade" id="modal-newReservation" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">New Reservation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="fcFRM1" asp-controller="Accommodation" asp-action="CreateReservation" method="post">
                <div class="modal-body">
                    <div class="form-selectgroup-boxes row mb-3">
                        <label class="form-label required">Request Type</label>
                        <div class="col-lg-6">
                            <label class="form-selectgroup-item">
                                <input type="radio" name="_isPersonal" value="false" class="form-selectgroup-input" checked>
                                <span class="form-selectgroup-label d-flex align-items-center p-2">
                                    <span class="me-3">
                                        <span class="form-selectgroup-check"></span>
                                    </span>
                                    <span class="form-selectgroup-label-content">
                                        <span class="form-selectgroup-title strong mb-1">Corporate</span>
                                    </span>
                                </span>
                            </label>
                        </div>
                        <div class="col-md-6 col-lg-6">
                            <label class="form-selectgroup-item">
                                <input type="radio" name="_isPersonal" value="true" class="form-selectgroup-input">
                                <span class="form-selectgroup-label d-flex align-items-center p-2">
                                    <span class="me-3">
                                        <span class="form-selectgroup-check"></span>
                                    </span>
                                    <span class="form-selectgroup-label-content">
                                        <span class="form-selectgroup-title strong m-1">Personal</span>
                                    </span>
                                </span>
                            </label>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-lg-6">
                            <label class="form-label required">Requestor Name</label>
                            <input class="form-control" name="_requestor" type="text" value="@employee.Fullname" readonly>
                        </div>
                        <div class="col-lg-6">
                            <label class="form-label required">Employee Id</label>
                            <input class="form-control" name="_employeeId" value="@employee.EmployeeID" readonly>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-lg-12">
                            <label class="form-label required">Requestor Email</label>
                            <input class="form-control" name="_requestorEmail" type="email" value="@employee.Email" readonly>
                        </div>
                    </div>
                    <div id="chargeTo">
                        <div class="mb-3">
                            <label class="form-label required">Charge to Company:</label>
                            @(Html.Kendo().DropDownList()
                                .Name("_company")
                                .DataTextField("Company")
                                .DataValueField("Id")
                                .Value(employee.CompanyId.ToString())
                                .DataSource(source =>
                                {
                                    source.Read(read =>
                                    {
                                        read.Action("getCompanies", "Global");
                                    });
                                })
                                .HtmlAttributes(new { style = "width: 100%; font-size: 15px; font-weight: bold; border-color: var(--tblr-muted); opacity: .8;" })
                                .OptionLabel("Select Company")
                                )
                        </div>
                        <div class="mb-3">
                            <label class="form-label required">Charge to Department</label>
                            @(Html.Kendo().DropDownList()
                                .Name("_department")
                                .DataTextField("DepartmentName")
                                .DataValueField("Id")
                                .CascadeFrom("_company")
                                .Value(employee.DepartmentId.ToString())
                                .DataSource(source =>
                                {
                                    source.Read(read =>
                                    {
                                        read.Action("getDepartments", "Global").Data("filterDepartments");
                                    }).ServerFiltering(true);
                                })
                                .HtmlAttributes(new { style = "width: 100%; font-size: 15px; font-weight: bold; border-color: var(--tblr-muted); opacity: .8;" })
                                )
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button id="svbtn15" type="submit" class="btn btn btn-success ms-auto">Create</button>
                </div>
            </form>

        </div>
    </div>
</div>
@*END - NEW RESERVATION MODAL *@