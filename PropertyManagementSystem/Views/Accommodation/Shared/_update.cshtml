@model PropertyManagementSystem.Models.ReservationViewModel
@inject PropertyManagementSystem.Services.IRoleService RoleService
@{
    var employee = await RoleService.GetUserName(User);
}
<div class="card-header reservation-update-trigger-bar">
    <button type="button" class="btn btn-primary ms-auto" data-bs-toggle="modal" data-bs-target="#modal-update">
        <i class="ti ti-pencil" aria-hidden="true"></i>
        Edit Reservation
    </button>
</div>
<partial name="~/Views/Accommodation/Shared/_reservationDetails.cshtml" model="Model" />
<div class="card-body legacy-accommodation-summary">
    <div class="row align-items-start">
        <div class="col-2">
            <img src="@Url.Content("~/img/facility-room.jpg")" alt="Accommodation" class="rounded img-fluid">
        </div>
        <div class="col-9">
            <div class="text-primary h3 d-flex align-items-center">
                <!-- Reservation Code -->
                <span>@Model.ReservationHeader.ReservationCode</span>

                <!-- Status placed at the end of the reservation code with a space -->
                <span class="ms-3">
                    <!-- Margin for spacing -->
                    @if (Model.ReservationHeader.Status == "APPROVED")
                    {
                        <span class='status status-teal'>
                            <span class='status-dot status-dot-animated'></span>@Model.ReservationHeader.Status
                        </span>
                    }
                    else if (Model.ReservationHeader.Status == "FOR DEPARTMENT HEAD'S APPROVAL" || Model.ReservationHeader.Status == "FOR ADMIN APPROVER'S APPROVAL" || Model.ReservationHeader.Status == "FOR ADMIN MANAGER'S APPROVAL")
                    {
                        <span class='status status-teal'>
                            <span class='status-dot status-dot-animated'></span>FOR APPROVAL
                        </span>
                    }
                    else if (Model.ReservationHeader.Status == "CANCELLED" || Model.ReservationHeader.Status == "DISAPPROVED")
                    {
                        <span class='status status-red'>
                            <span class='status-dot status-dot-animated'></span>@Model.ReservationHeader.Status
                        </span>
                    }
                    else
                    {
                        <span class='status status-blue'>
                            <span class='status-dot status-dot-animated'></span>@Model.ReservationHeader.Status
                        </span>
                    }
                </span>
            </div>

            <div class="row mt-3">
                <!-- Rest of the content remains the same -->
                <div class="col-lg-3 col-md-6 mb-4">
                    <div class="datagrid-item">
                        <div class="datagrid-title text-primary">Requestor</div>
                        <div class="datagrid-content">@Model.ReservationHeader.Requestor</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 mb-4">
                    <div class="datagrid-item">
                        <div class="datagrid-title text-primary">Email</div>
                        <div class="datagrid-content">@Model.ReservationHeader.RequestorEmail</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 mb-4">
                    <div class="datagrid-item">
                        <div class="datagrid-title text-primary">Department</div>
                        <div class="datagrid-content">@Model.Department.DepartmentCode</div>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6 mb-4">
                    <div class="datagrid-item">
                        <div class="datagrid-title text-primary">Date Filed</div>
                        <div class="datagrid-content">@Model.ReservationHeader.DateFiled</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@if (false)
{
    <div class="accordion legacy-accommodation-details" id="accordion-example">
        <div class="accordion-item">
            <h2 class="accordion-header" id="heading-1">
                <button class="accordion-button " type="button" data-bs-toggle="collapse" data-bs-target="#collapse-1" aria-expanded="true">
                    RESERVATION DETAILS
                </button>
            </h2>
            <div id="collapse-1" class="accordion-collapse collapse show" data-bs-parent="#accordion-example">
                <div class="accordion-body pt-0">
                    <div class="card-body">
                        <div class="row align-items-start">
                            <div class="col-2">
                            </div>
                            <div class="col-9">
                                <div class="row mt-3">
                                    <div class="col-lg-3 col-md-6 mb-4">
                                        <div class="datagrid-item">
                                            <div class="datagrid-title text-primary">Guest Name</div>
                                            @foreach (var guest in Model.ReservationDetails)
                                            {
                                                <div class="datagrid-content">@guest.GuestName</div>
                                            }
                                        </div>
                                    </div>
                                    <div class="col-lg-3 col-md-6 mb-4">
                                        <div class="datagrid-item">
                                            <div class="datagrid-title text-primary">Company</div>
                                            @foreach (var comp in Model.ReservationDetails)
                                            {
                                                <div class="datagrid-content">@comp.Company</div>
                                            }
                                        </div>
                                    </div>
                                    @if (Model.ReservationDetails.FirstOrDefault().FacilityId != 0)
                                    {
                                        <div class="col-lg-3 col-md-6 mb-4">
                                            <div class="datagrid-item">
                                                <div class="datagrid-title text-primary">Facility Name</div>
                                                @foreach (var fac in Model.ReservationDetails)
                                                {
                                                    <div class="datagrid-content">@fac.Facility.FacilityName</div>
                                                }
                                            </div>
                                        </div>
                                        <div class="col-lg-3 col-md-6 mb-4">
                                            <div class="datagrid-item">
                                                <div class="datagrid-title text-primary">Room Name</div>
                                                @foreach (var room in Model.ReservationDetails)
                                                {
                                                    <div class="datagrid-content">@room.Room.RoomName</div>
                                                }
                                            </div>
                                        </div>
                                    }
                                    <div class="col-lg-3 col-md-6 mb-4">
                                        <div class="datagrid-item">
                                            <div class="datagrid-title text-primary">Arrival Date and Time</div>
                                            <div class="datagrid-content">@Model.ReservationDetails.FirstOrDefault().StartDate</div>
                                        </div>
                                    </div>
                                    <div class="col-lg-3 col-md-6 mb-4">
                                        <div class="datagrid-item">
                                            <div class="datagrid-title text-primary">Departure Date and Time</div>
                                            <div class="datagrid-content">@Model.ReservationDetails.FirstOrDefault().EndDate</div>
                                        </div>
                                    </div>

                                    <div class="col-lg-3 col-md-6 mb-4">
                                        <div class="datagrid-item">
                                            <div class="datagrid-title text-primary">Purpose</div>
                                            <div class="datagrid-content">
                                                @Model.ReservationDetails.FirstOrDefault().Purpose
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
<form asp-action="UpdateReservationStatus" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="ReservationDetailId" value="@Model.ReservationDetails.FirstOrDefault().ReservationDetailId">
    <input type="hidden" name="ReservationId" value="@Model.ReservationDetails.FirstOrDefault().ReservationId">
    <div class="card-footer d-flex justify-content-between align-items-center">
        <a href="@Url.Action("ReservationList", "Accommodation")" class="btn btn-link link-secondary">
            Go Back
        </a>
        <div class="ms-auto">
            @if (PropertyManagementSystem.Services.ReservationOwnership.IsOwner(
                    Model.ReservationHeader,
                    User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
                        ?? User.FindFirst("email")?.Value
                        ?? User.Identity?.Name,
                    employee?.Email) &&
                Model.ReservationHeader.Status != "CANCELLED" &&
                Model.ReservationHeader.Status != "DISAPPROVED")
            {
                if (Model.ReservationDetails.FirstOrDefault()?.StartDate >= DateTime.Now.AddHours(1))
                {
                    <button type="button" class="btn btn-red m-1" data-bs-toggle="modal" data-bs-target="#modal-cancel-@Model.ReservationHeader.ReservationId">
                        <span>
                            <i class="ti ti-x m-1"></i>
                        </span>
                        Cancel
                    </button>

                }
            }
        </div>
    </div>
</form>
@*ASSIGN FACILITY MODAL*@
<div class="modal modal-blur fade" id="modal-update" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered update-workflow-dialog" role="document">
        <div class="modal-content update-workflow-modal">
            <div class="modal-header">
                <div class="update-workflow-heading">
                    <span class="update-workflow-icon" aria-hidden="true"><i class="ti ti-bed"></i></span>
                    <div>
                        <span class="reservation-eyebrow">Guesthouse reservation</span>
                        <h5 class="modal-title">Edit Reservation</h5>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="UpdateReservationDetails" asp-controller="Accommodation" method="post" class="update-workflow-form" data-accommodation-schedule-form>

                <input type="hidden" name="ReservationId" value="@Model.ReservationHeader.ReservationId">
                <div class="modal-body update-workflow-body">
                    <section class="edit-guest-section" aria-labelledby="editGuestSectionTitle">
                        <div class="edit-guest-section-heading">
                            <span class="edit-guest-section-accent" aria-hidden="true"></span>
                            <h3 id="editGuestSectionTitle">Guesthouse Reservation Form</h3>
                        </div>
                        <div id="dynamic-rows" class="edit-guest-list">
                        @for (var guestIndex = 0; guestIndex < Model.ReservationDetails.Count; guestIndex++)
                        {
                            var detail = Model.ReservationDetails[guestIndex];
                            <div class="row g-3 mb-3 guest-row">
                                <div class="col-lg-5">
                                    <label class="form-label required">Guest Name</label>
                                    <input type="text" class="form-control" name="_guests[]" placeholder="Guest Name" value="@detail.GuestName" required>
                                </div>
                                <div class="col-lg-3">
                                    <label class="form-label required">Company</label>
                                    <select class="form-select guest-company-select"
                                            name="_company[]"
                                            data-selected-value="@detail.Company"
                                            required>
                                        <option value="">Select company</option>
                                    </select>
                                </div>
                                <div class="col-lg-3">
                                    <label class="form-label">Relationship <span class="form-label-description">Optional</span></label>
                                    <input type="text" class="form-control" name="_relationship[]" placeholder="Relationship to requestor" value="@detail.Relationship">
                                </div>
                                <div class="col-lg-1 guest-row-actions">
                                    @if (guestIndex > 0)
                                    {
                                        <button type="button" class="btn btn-outline-danger btn-icon remove-row" aria-label="Remove guest">
                                            <i class="ti ti-trash" aria-hidden="true"></i>
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                        </div>
                        <div class="guest-list-actions edit-guest-list-actions">
                            <button type="button" id="add-row" class="btn btn-outline-primary">
                                <i class="ti ti-plus" aria-hidden="true"></i>Add Another Guest
                            </button>
                            <span id="guest-row-count" class="text-secondary">@Model.ReservationDetails.Count @(Model.ReservationDetails.Count == 1 ? "guest" : "guests")</span>
                        </div>
                    </section>
                    <div class="reservation-section-title"><i class="ti ti-calendar-time" aria-hidden="true"></i>Duration of stay</div>
                    <div class="row mb-3">
                        <div class="col-lg-6">
                            <label class="form-label required">Arrival Date and Time</label>
                            @(
                                Html.Kendo().DateTimePicker()
                                .Name("StartDate")
                                .Value(Model.ReservationDetails.FirstOrDefault()?.StartDate)
                                .DateInput(true)
                                .Format("MM/dd/yyyy hh:mm tt")
                                .TimeFormat("hh:mm tt")
                                .Interval(30)
                                .ParseFormats(new string[] { "MM/dd/yyyy HH:mm", "MM/dd/yyyy hh:mm tt", "yyyy/MM/dd HH:mm:ss.fff", "yyyy-MM-ddTHH:mm:ss.fffZ" })
                                .Events(e => e.Open("onAccommodationDateTimePickerOpen"))
                                .HtmlAttributes(new { style = "width: 100%; font-family: var(--tblr-font-sans-serif); font-size: 15px; font-weight: 500; background-color: var(--tblr-bg-forms); opacity: .8;", required = "required", aria_describedby = "accommodationUpdateScheduleValidation" })
                                )
                        </div>
                        <div class="col-lg-6">
                            <label class="form-label required">Departure Date and Time</label>
                            @(
                                Html.Kendo().DateTimePicker()
                                .Name("EndDate")
                                .Value(Model.ReservationDetails.FirstOrDefault()?.EndDate)
                                .Format("MM/dd/yyyy hh:mm tt")
                                .TimeFormat("hh:mm tt")
                                .Interval(30)
                                .ParseFormats(new string[] { "MM/dd/yyyy HH:mm", "MM/dd/yyyy hh:mm tt", "yyyy/MM/dd HH:mm:ss.fff", "yyyy-MM-ddTHH:mm:ss.fffZ" })
                                .Events(e => e.Open("onAccommodationDateTimePickerOpen"))
                                .HtmlAttributes(new { style = "width: 100%; font-family: var(--tblr-font-sans-serif); font-size: 15px; font-weight: 500; background-color: var(--tblr-bg-forms); opacity: .8;", required = "required", aria_describedby = "accommodationUpdateScheduleValidation" })
                                )
                        </div>
                    </div>
                    <div id="accommodationUpdateScheduleValidation"
                         class="alert alert-danger py-2 px-3 mb-3"
                         role="alert"
                         aria-live="polite"
                         hidden>
                        Departure date and time must be later than arrival date and time.
                    </div>
                    <div class="col-lg-12">
                        <div>
                            <label class="form-label">
                                Purpose
                                <span id="charCount" class="form-label-description">0/50</span>
                            </label>
                            <textarea class="form-control" rows="3" name="purpose" id="purposeTextarea" maxlength="50" required>@Model.ReservationDetails.FirstOrDefault()?.Purpose</textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer update-workflow-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                        Cancel
                    </button>
                    <div class="ms-auto">
                        @if (Model.ReservationHeader.Status != "CANCELLED" && Model.ReservationHeader.Status != "DISAPPROVED" && Model.ReservationHeader.Status != "APPROVED")
                        {
                            <button type="submit" class="btn btn-primary ms-auto">
                                <i class="ti ti-device-floppy" aria-hidden="true"></i>
                                Save Changes
                            </button>
                        }
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
@*END OF MODAL*@

<partial name="~/Views/Accommodation/Shared/_cancel.cshtml" model="Model" />
