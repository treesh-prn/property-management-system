@model PropertyManagementSystem.Models.ReservationViewModel
@inject PropertyManagementSystem.Services.IRoleService RoleService
@{
    var employee = await RoleService.GetUserName(User);
    var activeRole = await RoleService.GetActiveRoleAsync(User);
}
<div class="card">
    @if (Model.ReservationHeader.Requestor == employee.Fullname && Model.ReservationHeader.Status != "CANCELLED" && Model.ReservationHeader.Status != "DISAPPROVED")
    {
        if (Model.ReservationDetails.FirstOrDefault()?.StartDate >= DateTime.Now.AddHours(1))
        {
            <div class="card-header">
                <button type="button" class="btn btn-primary ms-auto" data-bs-toggle="modal" data-bs-target="#modal-update">
                    Update Reservation
                </button>
            </div>
        }
    }
    <div class="card-body">
        <div class="row align-items-start">
            <div class="col-2">
                <img src="@Url.Content("~/img/facility-room.jpg")" alt="Accommodation" class="rounded img-fluid">
            </div>
            <div class="col-9">
                <div class="text-primary h3 d-flex align-items-center">
                    <!-- Reservation Code -->
                    <span>@Model.ReservationHeader.ReservationCode</span>

                    <!-- Status placed at the end of the reservation code with a space -->
                    <span class="ms-3">
                        <!-- Margin for spacing -->
                        @if (Model.ReservationHeader.Status == "APPROVED")
                        {
                            <span class='status status-teal'>
                                <span class='status-dot status-dot-animated'></span>@Model.ReservationHeader.Status
                            </span>
                        }
                        else if (Model.ReservationHeader.Status == "FOR DEPARTMENT HEAD'S APPROVAL" || Model.ReservationHeader.Status == "FOR ADMIN APPROVER'S APPROVAL" || Model.ReservationHeader.Status == "FOR ADMIN MANAGER'S APPROVAL")
                        {
                            <span class='status status-teal'>
                                <span class='status-dot status-dot-animated'></span>FOR APPROVAL
                            </span>
                        }
                        else if (Model.ReservationHeader.Status == "CANCELLED" || Model.ReservationHeader.Status == "DISAPPROVED")
                        {
                            <span class='status status-red'>
                                <span class='status-dot status-dot-animated'></span>@Model.ReservationHeader.Status
                            </span>
                        }
                        else
                        {
                            <span class='status status-blue'>
                                <span class='status-dot status-dot-animated'></span>@Model.ReservationHeader.Status
                            </span>
                        }
                    </span>
                </div>

                <div class="row mt-3">
                    <!-- Rest of the content remains the same -->
                    <div class="col-lg-3 col-md-6 mb-4">
                        <div class="datagrid-item">
                            <div class="datagrid-title text-primary">Requestor</div>
                            <div class="datagrid-content">@Model.ReservationHeader.Requestor</div>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6 mb-4">
                        <div class="datagrid-item">
                            <div class="datagrid-title text-primary">Employee Id</div>
                            <div class="datagrid-content">@Model.Employees.EmployeeID</div>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6 mb-4">
                        <div class="datagrid-item">
                            <div class="datagrid-title text-primary">Email</div>
                            <div class="datagrid-content">@Model.ReservationHeader.RequestorEmail</div>
                        </div>
                    </div>
                    @if (Model.ReservationHeader.isPersonal == false)
                    {
                        <div class="col-lg-3 col-md-6 mb-4">
                            <div class="datagrid-item">
                                <div class="datagrid-title text-primary">Chrge To</div>
                                <div class="datagrid-content">@Model.Department.DepartmentCode</div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="col-lg-3 col-md-6 mb-4">
                            <div class="datagrid-item">
                                <div class="datagrid-title text-primary">Chrge To</div>
                                <div class="datagrid-content">Personal </div>
                            </div>
                        </div>
                    }
                    <div class="col-lg-3 col-md-6 mb-4">
                        <div class="datagrid-item">
                            <div class="datagrid-title text-primary">Date Filed</div>
                            <div class="datagrid-content">@Model.ReservationHeader.DateFiled</div>
                        </div>
                    </div>
                    @if (Model.ReservationDetails.FirstOrDefault().ReservationId != 0)
                    {

                        <div class="col-lg-3 col-md-6 mb-4">
                            <div class="datagrid-item">
                                <div class="datagrid-title text-primary">Purpose</div>
                                <div class="datagrid-content">
                                    @Model.ReservationDetails.FirstOrDefault().Purpose
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

</div>
@if (Model.ReservationDetails.FirstOrDefault().ReservationId != 0)
{
    <div class="card mt-3">
        @(
                Html.Kendo().TabStrip()
                .Name("tabstrip")
                .Animation(animation =>
                animation.Open(effect =>
                effect.Fade(FadeDirection.In)))
                .Items(tabstrip =>
                {
                    tabstrip.Add().Text("Reservation Details")
                .Encoded(false)
                .Selected(true)
                .Content(@<text>
        <partial name="Shared/_reservationDetails" />
    </text>);
                })
            )
    </div>
}
<div class="card">
    <form asp-action="UpdateReservationStatus" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="ReservationDetailId" value="@Model.ReservationDetails.FirstOrDefault().ReservationDetailId">
        <input type="hidden" name="ReservationId" value="@Model.ReservationDetails.FirstOrDefault().ReservationId">
        <div class="card-footer d-flex justify-content-between align-items-center">
            <a href="@Url.Action("ReservationList", "FunctionRoom")" class="btn btn-link link-secondary">
                Go Back
            </a>
            <div class="ms-auto">
                @if (Model.ReservationHeader.Requestor == employee.Fullname && Model.ReservationHeader.Status != "CANCELLED" && Model.ReservationHeader.Status != "DISAPPROVED")
                {
                    if (Model.ReservationDetails.FirstOrDefault()?.StartDate >= DateTime.Now.AddHours(1))
                    {
                        <button type="button" class="btn btn-red m-1" data-bs-toggle="modal" data-bs-target="#modal-danger">
                            <span>
                                <i class="ti ti-x m-1"></i>
                            </span>
                            Cancel
                        </button>

                    }
                }
            </div>
        </div>
    </form>
</div>
<partial name="Shared/_edit" />
<partial name="Shared/_cancel" />