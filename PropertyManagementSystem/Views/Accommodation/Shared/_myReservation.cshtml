@(
    string.Empty)
@{
    var currentYear = DateTime.Today.Year;
    var reservationYears = (ViewData["ReservationYears"] as IEnumerable<int> ?? Array.Empty<int>())
        .Distinct()
        .OrderByDescending(year => year)
        .ToList();
    var defaultYear = reservationYears.Contains(currentYear)
        ? currentYear
        : reservationYears.FirstOrDefault();
}

<div class="reservation-history-filter">
    <div>
        <label class="form-label mb-1" for="accommodationReservationYear">Schedule year</label>
        <div class="form-hint">Only years containing your reservations are listed. Requests requiring rescheduling are always shown.</div>
    </div>
    <select id="accommodationReservationYear" class="form-select reservation-year-select"
            data-reservation-year-filter data-grid-id="reservationGrid2" data-storage-key="accommodation">
        @foreach (var year in reservationYears)
        {
            <option value="@year" selected="@(year == defaultYear ? "selected" : null)">@year</option>
        }
        <option value="0" selected="@(reservationYears.Count == 0 ? "selected" : null)">All years</option>
    </select>
</div>

@(
                                Html.Kendo().Grid<PropertyManagementSystem.Models.ReservationViewModel>()
                                .Name("reservationGrid2")
                                .HtmlAttributes(new { @class = "reservation-request-grid" })
                                .Columns(columns =>
                                {
                                    columns.Bound(c => c.ReservationId).Visible(false).Exportable(false);
                                    columns.Bound(c => c.ReservationDetailId).Visible(false).Exportable(false);
                                    columns.Bound(c => c.ReservationCode).Title("Request Number").Width("55%");
                                    columns.Bound(c => c.RequestorEmail).Hidden(true);
                                    columns.Bound(c => c.Status).ClientTemplate("#= reservationStatusTemplate(Status) #").Title("Status").Width(250);
                                    columns.Command(command =>
                                    {
                                        command.Custom("view")
                                    .Text("<i class='ti ti-eye' aria-hidden='true'></i>View")
                                    .Click("onViewClickReservationList")
                                    .HtmlAttributes(new { @class = "k-button k-grid-View k-button-sm k-rounded-md k-button-solid k-button-solid-success" });
                                         command.Custom("delete")
                                    .Text("<i class='ti ti-trash' aria-hidden='true'></i>Delete")
                                    .Click("onDeleteClickReservation")
                                    .HtmlAttributes(new { @class = "k-button k-grid-Delete has-label", style = "display: none;", title = "Delete request", aria_label = "Delete request" });
                                    })
                                    .Title("Actions")
                                    .Width(270)
                                    .Exportable(false);

                                })
                                .NoRecords()
                                .Sortable()
                                .Pageable()
                                .Scrollable(s => s.Height("auto"))
                                .ToolBar(toolbar =>
                                {
                                    toolbar.Search();
                                })
                                .DataSource(dataSource => dataSource
                                .Ajax()
                                .Model(model =>
                                {
                                    model.Id(p => p.ReservationId);
                                    model.Field(p => p.CanDelete);
                                    model.Field(p => p.Status);
                                    model.Field(p => p.GUID);
                                    model.Field(p => p.ReservationType);
                                    model.Field(p => p.ReservationDetailId);
                                })
                                .Read(read => read.Action("getGuestHouseReservation", "Accommodation", new { gridType = "myReservation" }).Data("filterAccommodationReservationYear").Type(HttpVerbs.Get))
                                .PageSize(20)
                                )
                                 .Events(events => events.DataBound("onGridDataBound"))
                                )
