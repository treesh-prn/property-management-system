@model PropertyManagementSystem.Models.ReservationViewModel
<form asp-action="CreateReservationDetails" asp-controller="Accommodation" method="post">
    <div class="modal-body">
        <input type="hidden" class="form-control" name="_reservationId" asp-for="ReservationHeader.ReservationId">
        <div id="dynamic-rows">
            <div class="row mb-3">
                <div class="col-lg-5">
                    <label class="form-label">Guest Name</label>
                    <input type="text" class="form-control" name="_guests[]" placeholder="Guest Name">
                </div>
                <div class="col-lg-3">
                    <label class="form-label">Company</label>
                    <input type="text" class="form-control" name="_company[]" placeholder="Company">
                </div>
                <div class="col-lg-3">
                    <label class="form-label">Relationship (N/A if not applicable)</label>
                    <input type="text" class="form-control" name="_relationship[]" placeholder="Relationship (N/A if not applicable)">
                </div>
                <div class="col-sm-1 d-flex align-items-end">
                    <button type="button" id="add-row" class="btn btn-primary ml-2 custom-padding">
                        <i class="ti ti-plus"></i>
                    </button>
                    <button type="button" class="btn btn-danger remove-row ml-2 custom-padding">
                        <i class="ti ti-trash"></i>
                    </button>
                </div>
            </div>
        </div>
        <label class="form-label">Duration of Stay</label>
        <div class="row mb-3">
            <div class="col-lg-6">
                <label class="form-label required">Check in</label>
                @(Html.Kendo().DateTimePicker()
                    .Name("_startDate")
                    .Value(DateTime.Today)  
                    .Format("yyyy/MM/dd HH:mm:ss.fff")
                    .ParseFormats(new string[] { "yyyy/MM/dd HH:mm:ss.fff", "yyyy-MM-ddTHH:mm:ss.fffZ" })
                    )
            </div>
            <div class="col-lg-6">
                <label class="form-label required">Check out </label>
                @(Html.Kendo().DateTimePicker()
                    .Name("_endDate")
                    .Value(DateTime.Today)
                    .Format("yyyy/MM/dd HH:mm:ss.fff")
                    .ParseFormats(new string[] { "yyyy/MM/dd HH:mm:ss.fff", "yyyy-MM-ddTHH:mm:ss.fffZ" })
                    )
            </div>
        </div>
        <div class="col-lg-12">
            <div>
                <label class="form-label">
                    Purpose
                    <span class="form-label-description">26/50</span>
                </label>
                <textarea class="form-control" rows="3" name="_purpose"></textarea>
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <a href="@Url.Action("Index", "Accommodation")" class="btn btn-link link-secondary" data-bs-dismiss="modal">
            Cancel
        </a>
        <button id="svbtn15" type="submit" class="btn btn btn-primary ms-auto">
            <!-- Download SVG icon from http://tabler-icons.io/i/plus -->
            <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M12 5l0 14" /><path d="M5 12l14 0" /></svg>
            Create
        </button>
    </div>
</form>