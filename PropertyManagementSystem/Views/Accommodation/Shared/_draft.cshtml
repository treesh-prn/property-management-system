@model PropertyManagementSystem.Models.ReservationViewModel
<div class="card">
    <form asp-action="CreateReservationDetails" asp-controller="Accommodation" method="post">
        <input type="hidden" class="form-control" name="_guid" asp-for="@Model.ReservationHeader.GUID">
        <input type="hidden" class="form-control" name="_reservationId" asp-for="@Model.ReservationHeader.ReservationId">
        <input type="hidden" class="form-control" name="_requestorEmail" asp-for="@Model.ReservationHeader.RequestorEmail">
        <div class="container container-lg mt-3">
            <div class="row">
                <div class="col-lg-8 mb-3">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">Guesthouse Reservation Form</h3>
                        </div>
                        <div class="card-body">
                            <div id="dynamic-rows">
                                <div class="row mb-3">
                                    <div class="col-md-3">
                                        <label class="form-label">Guest Name</label>
                                        <input type="text" class="form-control" name="_guests[]" placeholder="Guest Name">
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label"> Company (N/A if not applicable)</label>
                                        <input type="text" class="form-control" name="_company[]" placeholder="Company (N/A if not applicable)">
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label">Relationship (N/A if not applicable)</label>
                                        <input type="text" class="form-control" name="_relationship[]" placeholder="Relationship (N/A if not applicable)">
                                    </div>
                                    <div class="col-sm-1 d-flex align-items-end">
                                        <button type="button" id="add-row" class="btn btn-primary ml-2 custom-padding">
                                            <i class="ti ti-plus"></i>
                                        </button>
                                        <button type="button" class="btn btn-danger remove-row ml-2 custom-padding">
                                            <i class="ti ti-trash"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <label class="form-label">Duration of Stay</label>
                            <div class="row mb-3">
                                <div class="col-lg-6">
                                    <label class="form-label required">Arrival Date and Time</label>
                                    @(Html.Kendo().DateTimePicker()
                                        .Name("_startDate")
                                        .Value(DateTime.Today)
                                        .Format("yyyy/MM/dd HH:mm:ss.fff")
                                        .ParseFormats(new string[] { "yyyy/MM/dd HH:mm:ss.fff", "yyyy-MM-ddTHH:mm:ss.fffZ" })
                                        .HtmlAttributes(new { onkeydown = "return false;" })
                                        )
                                </div>
                                <div class="col-lg-6">
                                    <label class="form-label required">Departure Date and Time</label>
                                    @(Html.Kendo().DateTimePicker()
                                        .Name("_endDate")
                                        .Value(DateTime.Today)
                                        .Format("yyyy/MM/dd HH:mm:ss.fff")
                                        .HtmlAttributes(new { onkeydown = "return false;" })
                                        .ParseFormats(new string[] { "yyyy/MM/dd HH:mm:ss.fff", "yyyy-MM-ddTHH:mm:ss.fffZ" })
                                        )
                                </div>
                            </div>
                            <div class="col-lg-12">
                                <div>
                                    <label class="form-label">
                                        Purpose
                                        <span id="charCount" class="form-label-description">0/50</span>
                                    </label>
                                    <textarea class="form-control" rows="3" name="_purpose" id="purposeTextarea" maxlength="50"></textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="card booking-summary">
                        <div class="card-header">
                            <h3 class="card-title">Reservation Summary</h3>
                        </div>
                        <div class="card-body">
                            <div class="row align-items-start">
                                <div class="col-3">
                                    <img src="@Url.Content("~/img/guest-room.jpg")" alt="Dorm Reservation" class="rounded">
                                </div>
                                <div class="col-9">
                                    <div class="text-primary h4 d-flex align-items-center">
                                        <span>@Model.ReservationHeader.ReservationCode</span>
                                        <span class="ms-3">
                                            @if (Model.ReservationHeader.Status == "APPROVED")
                                            {
                                                <span class='status status-teal'>
                                                    <span class='status-dot status-dot-animated'></span>@Model.ReservationHeader.Status
                                                </span>
                                            }
                                            else if (Model.ReservationHeader.Status == "FOR DEPARTMENT HEAD'S APPROVAL" || Model.ReservationHeader.Status == "FOR ADMIN APPROVER'S APPROVAL" || Model.ReservationHeader.Status == "FOR ADMIN MANAGER'S APPROVAL")
                                            {
                                                <span class='status status-teal'>
                                                    <span class='status-dot status-dot-animated'></span>FOR APPROVAL
                                                </span>
                                            }
                                            else if (Model.ReservationHeader.Status == "CANCELLED" || Model.ReservationHeader.Status == "DISAPPROVED")
                                            {
                                                <span class='status status-red'>
                                                    <span class='status-dot status-dot-animated'></span>@Model.ReservationHeader.Status
                                                </span>
                                            }
                                            else
                                            {
                                                <span class='status status-blue'>
                                                    <span class='status-dot status-dot-animated'></span>@Model.ReservationHeader.Status
                                                </span>
                                            }
                                        </span>
                                    </div>
                                    <div class="row mt-3">
                                        <dl class="row">
                                            <dt class="col-4 text-primary">Requestor:</dt>
                                            <dd class="col-8 text-truncate" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                                @Model.ReservationHeader.Requestor
                                            </dd>
                                            <dt class="col-4 text-primary">Email:</dt>
                                            <dd class="col-8 text-truncate" style="font-size: white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                                @Model.ReservationHeader.RequestorEmail
                                            </dd>
                                            @if(Model.ReservationHeader.isPersonal == false)
                                            {
                                                <dt class="col-4 text-primary">Chrge To Dept:</dt>
                                                <dd class="col-8 text-truncate" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                                    @Model.Department.DepartmentCode
                                                </dd>
                                            }else{
                                                <dt class="col-4 text-primary">Chrge To:</dt>
                                                <dd class="col-8 text-truncate" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                                    Personal
                                                </dd>
                                            }
                                        </dl>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-footer d-flex justify-content-between align-items-center">
            <a href="@Url.Action("ReservationList", "Accommodation")" class="btn btn-link link-secondary">
                Go Back
            </a>
            <div class="ms-auto">
                <button id="svbtn15" type="submit" class="btn btn btn-primary ms-auto">
                    <!-- Download SVG icon from http://tabler-icons.io/i/plus -->
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M12 5l0 14" /><path d="M5 12l14 0" /></svg>
                    Submit
                </button>
            </div>
        </div>
    </form>
</div>

