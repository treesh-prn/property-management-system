@model PropertyManagementSystem.Models.ReservationViewModel
@inject IReservationAuthorizationService ReservationAuthorization
@{
    var bookingActor = await ReservationAuthorization.GetActorAsync(User);
    var canBookSameDay = ReservationSchedulePolicy.CanBookSameDay(bookingActor);
    var minimumBookingDate = ReservationSchedulePolicy.GetMinimumDate(bookingActor, DateTime.Now);
    var defaultArrival = canBookSameDay
        ? minimumBookingDate.AddMinutes(Math.Ceiling((DateTime.Now.TimeOfDay.TotalMinutes + 1) / 30) * 30)
        : minimumBookingDate;
}
<form asp-action="CreateReservationDetails" asp-controller="Accommodation" method="post" class="reservation-workflow-form" data-cancellation-policy="true" data-preserve-draft="accommodation" data-accommodation-schedule-form data-can-book-same-day="@canBookSameDay.ToString().ToLowerInvariant()">
    <input type="hidden" class="form-control" name="_guid" asp-for="@Model.ReservationHeader.GUID">
    <input type="hidden" class="form-control" name="_reservationId" asp-for="@Model.ReservationHeader.ReservationId">
    <input type="hidden" class="form-control" name="_requestorEmail" asp-for="@Model.ReservationHeader.RequestorEmail">
    <div class="container container-lg mt-3">
        <div class="row">
            <div class="col-lg-8 mb-3">
                <div class="card reservation-input-card">
                    <div class="card-header">
                        <h3 class="card-title">Guesthouse Reservation Form</h3>
                    </div>
                    <div class="card-body">
                        <div id="dynamic-rows">
                            <div class="row mb-3 guest-row">
                                <div class="col-lg-5">
                                    <label class="form-label">Guest Name</label>
                                    <input type="text" class="form-control" name="_guests[]" placeholder="Guest Name" required>
                                </div>
                                <div class="col-lg-3">
                                    <label class="form-label">Company <span class="form-label-description">Optional</span></label>
                                    <select class="form-select guest-company-select" name="_company[]" required>
                                        <option value="">Select company</option>
                                    </select>
                                </div>
                                <div class="col-lg-3">
                                    <label class="form-label">Relationship <span class="form-label-description">Optional</span></label>
                                    <input type="text" class="form-control" name="_relationship[]" placeholder="Relationship to requestor">
                                </div>
                                <div class="col-sm-1 guest-row-actions"></div>
                            </div>
                        </div>
                        <div class="guest-list-actions">
                            <button type="button" id="add-row" class="btn btn-outline-primary">
                                <i class="ti ti-plus" aria-hidden="true"></i>Add Another Guest
                            </button>
                            <span id="guest-row-count" class="text-secondary">1 guest</span>
                        </div>
                        <label class="form-label">Duration of Stay</label>
                        <div class="row mb-3">
                            <div class="col-lg-6">
                                <label class="form-label required">Arrival Date and Time</label>
                                @(Html.Kendo().DateTimePicker()
                                    .Name("_startDate")
                                    .Value(defaultArrival)
                                    .Min(minimumBookingDate)
                                    .Format("MM/dd/yyyy hh:mm tt")
                                    .TimeFormat("hh:mm tt")
                                    .Interval(30)
                                    .ParseFormats(new string[] { "MM/dd/yyyy HH:mm", "MM/dd/yyyy hh:mm tt", "yyyy/MM/dd HH:mm:ss.fff", "yyyy-MM-ddTHH:mm:ss.fffZ" })
                                    .Events(e => e.Open("onAccommodationDateTimePickerOpen"))
                                    .HtmlAttributes(new { onkeydown = "return false;", required = "required", aria_describedby = "accommodationScheduleValidation" })
                                    )
                            </div>
                            <div class="col-lg-6">
                                <label class="form-label required">Departure Date and Time</label>
                                @(Html.Kendo().DateTimePicker()
                                    .Name("_endDate")
                                    .Value(defaultArrival.AddDays(1))
                                    .Min(minimumBookingDate)
                                    .Format("MM/dd/yyyy hh:mm tt")
                                    .TimeFormat("hh:mm tt")
                                    .Interval(30)
                                    .Events(e => e.Open("onAccommodationDateTimePickerOpen"))
                                    .HtmlAttributes(new { onkeydown = "return false;", required = "required", aria_describedby = "accommodationScheduleValidation" })
                                    .ParseFormats(new string[] { "MM/dd/yyyy HH:mm", "MM/dd/yyyy hh:mm tt", "yyyy/MM/dd HH:mm:ss.fff", "yyyy-MM-ddTHH:mm:ss.fffZ" })
                                    )
                            </div>
                        </div>
                        <div id="accommodationScheduleValidation"
                             class="alert alert-danger py-2 px-3 mb-3"
                             role="alert"
                             aria-live="polite"
                             hidden>
                            Departure date and time must be later than arrival date and time.
                        </div>
                        @if (!canBookSameDay)
                        {
                            <p class="form-hint">Same-day reservations are available only to Admin Approvers. Select tomorrow or a later date.</p>
                        }
                        <div class="col-lg-12">
                            <div>
                                <label class="form-label">
                                    Purpose
                                    <span id="charCount" class="form-label-description">0/50</span>
                                </label>
                                <textarea class="form-control" rows="3" name="_purpose" id="purposeTextarea" maxlength="50" aria-describedby="guestPurposeHelp" required></textarea>
                                <div id="guestPurposeHelp" class="form-hint">Briefly describe why accommodation is required.</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="card booking-summary reservation-summary-panel" data-review-panel="guesthouse">
                    <div class="card-header">
                        <h3 class="card-title">Quick Review</h3>
                    </div>
                    <div class="card-body">
                        <div class="quick-review-intro">
                            <i class="ti ti-clipboard-check"></i>
                            <span>Review the stay details before submitting.</span>
                        </div>
                        <dl class="quick-review-list">
                            <dt>Guests</dt>
                            <dd data-review-value="guestCount">No guests added</dd>
                            <dt>Guest Names</dt>
                            <dd data-review-value="guestNames">Not provided</dd>
                            <dt>Arrival</dt>
                            <dd data-review-value="start">Select arrival date</dd>
                            <dt>Departure</dt>
                            <dd data-review-value="end">Select departure date</dd>
                            <dt>Purpose</dt>
                            <dd data-review-value="purpose">No purpose entered</dd>
                        </dl>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="card-footer d-flex justify-content-between align-items-center">
        <a href="@Url.Action("ReservationList", "Accommodation")" class="btn btn-link link-secondary" data-draft-back>
            Back to My Requests
        </a>
        <div class="ms-auto">
            <button id="svbtn15" type="submit" class="btn btn btn-primary ms-auto">
                <!-- Download SVG icon from http://tabler-icons.io/i/plus -->
                <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M12 5l0 14" /><path d="M5 12l14 0" /></svg>
                Submit Request
            </button>
        </div>
    </div>
</form>
