@model PropertyManagementSystem.Models.ReservationViewModel
@{
    ViewData["Title"] = "Guesthouse Operations";
    var rooms = ViewData["Rooms"] as List<PropertyManagementSystem.Models.GFMS_Rooms> ?? new();
    var facilities = ViewData["Facilities"] as List<PropertyManagementSystem.Models.GFMS_Facility> ?? new();
}

<div class="page-wrapper reservation-page admin-operations-page">
    <div class="page-header d-print-none">
        <div class="container-xl">
            <div class="row g-2 align-items-center">
                <div class="col">
                    <div class="page-pretitle">Guesthouse</div>
                    <h2 class="page-title">Guesthouse Operations</h2>
                    <div class="text-secondary mt-1">Review stay requests, monitor room use, and inspect guesthouse availability.</div>
                </div>
                <div class="col-auto ms-auto d-print-none">
                    <div class="btn-list admin-page-actions">
                        <a href="@Url.Action("ReservationList", "Accommodation")" class="btn btn-outline-secondary">
                            <i class="ti ti-list-details" aria-hidden="true"></i>
                            Reservation Requests
                        </a>
                        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modal-newReservation">
                            <i class="ti ti-calendar-plus" aria-hidden="true"></i>
                            New Reservation
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="page-body">
        <div class="container-xl">
            <section class="admin-kpi-grid" aria-label="Guesthouse summary">
                <article class="card admin-stat-card">
                    <div class="card-body">
                        <span class="admin-stat-icon text-primary bg-primary-lt"><i class="ti ti-inbox"></i></span>
                        <div><strong>@Model.NewGHReservationsCount</strong><span>Pending requests</span></div>
                    </div>
                </article>
                <article class="card admin-stat-card">
                    <div class="card-body">
                        <span class="admin-stat-icon text-azure bg-azure-lt"><i class="ti ti-users"></i></span>
                        <div><strong>@Model.ActiveGuestCount</strong><span>Current guests</span></div>
                    </div>
                </article>
                <article class="card admin-stat-card">
                    <div class="card-body">
                        <span class="admin-stat-icon text-orange bg-orange-lt"><i class="ti ti-bed"></i></span>
                        <div><strong>@Model.OccupiedRoomsCount</strong><span>Occupied rooms</span></div>
                    </div>
                </article>
                <article class="card admin-stat-card">
                    <div class="card-body">
                        <span class="admin-stat-icon text-success bg-success-lt"><i class="ti ti-door"></i></span>
                        <div><strong>@Model.AvailableRoomsCount</strong><span>Available rooms</span></div>
                    </div>
                </article>
            </section>

            <section class="card admin-workspace-card admin-schedule-card" aria-labelledby="guesthouse-schedule-heading">
                <header class="card-header">
                    <div>
                        <span class="reservation-eyebrow">Schedule</span>
                        <h3 class="card-title" id="guesthouse-schedule-heading">Guesthouse occupancy calendar</h3>
                        <p class="card-subtitle">Compare arrivals and departures across facilities and rooms.</p>
                    </div>
                </header>
                <div class="card-body p-0">
                    @(Html.Kendo().Scheduler<PropertyManagementSystem.Models.ReservationViewModel>()
                        .Name("GHscheduler")
                        .HtmlAttributes(new { @class = "admin-scheduler" })
                        .MajorTick(1440)
                        .MinorTickCount(1)
                        .DateHeaderTemplate("<strong>#=kendo.toString(date, 'D')#</strong>")
                        .Views(views =>
                        {
                            views.TimelineWeekView(timeline => timeline.EventHeight(44));
                            views.TimelineMonthView(timeline =>
                            {
                                timeline.MajorTick(1440);
                                timeline.EventHeight(44);
                            });
                        })
                        .Timezone("Etc/UTC")
                        .Group(g => g.Resources("Rooms", "Facilities").Orientation(SchedulerGroupOrientation.Vertical))
                        .Resources(resource =>
                        {
                            resource.Add(m => m.FacilityId)
                                .Title("Facility")
                                .Name("Facilities")
                                .DataTextField("FacilityName")
                                .DataValueField("FacilityId")
                                .BindTo(facilities.Select(f => new { f.FacilityId, f.FacilityName }));

                            resource.Add(m => m.RoomId)
                                .Title("Room")
                                .Name("Rooms")
                                .DataTextField("RoomName")
                                .DataValueField("RoomId")
                                .DataParentValueField("FacilityId")
                                .BindTo(rooms.Select(r => new { r.RoomId, r.RoomName, r.FacilityId }));
                        })
                        .DataSource(dataSource => dataSource
                            .Model(model =>
                            {
                                model.Id(item => item.ReservationId);
                                model.Field(item => item.Title).DefaultValue("No title");
                                model.Field(item => item.GUID);
                                model.RecurrenceId(item => item.RecurrenceID);
                                model.Field(item => item.Start);
                                model.Field(item => item.End);
                                model.Field(item => item.RoomId);
                                model.Field(item => item.FacilityId);
                            })
                            .Read(read => read.Action("ViewReservation", "Accommodation").Type(HttpVerbs.Get))
                            .Update("ViewReservationDetails", "Accommodation")
                            .Destroy(destroy => destroy.Action("DeleteReservationDetail", "Accommodation")))
                        .Events(events => events.DataBound("onDataBound").Edit("onEditViewG"))
                    )
                </div>
            </section>
        </div>
    </div>
</div>

<partial name="Shared/_newReservation" />
