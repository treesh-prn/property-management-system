@{
    ViewData["Title"] = "Home Page";

}
<div class="page-wrapper">
    <!-- Page header -->
    <div class="page-header d-print-none">
        <div class="container-xl">
            <div class="row g-2 align-items-center">
                <div class="col">
                    <!-- Page pre-title -->
                    <div class="page-pretitle">
                        Reservation
                    </div>
                    <h2 class="page-title">
                        GUEST HOUSE
                    </h2>
                </div>
                <!-- Page title actions -->
                <div class="col-auto ms-auto d-print-none">
                    <div class="btn-list">
                        @*   <span class="d-none d-sm-inline">
                        <a href="#" class="btn">
                        New view
                        </a>
                        </span>
                        <a href="#" class="btn btn-primary d-none d-sm-inline-block" data-bs-toggle="modal" data-bs-target="#modal-report">
                        <!-- Download SVG icon from http://tabler-icons.io/i/plus -->
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M12 5l0 14" /><path d="M5 12l14 0" /></svg>
                        Create new report
                        </a>
                        <a href="#" class="btn btn-primary d-sm-none btn-icon" data-bs-toggle="modal" data-bs-target="#modal-report" aria-label="Create new report">
                        <!-- Download SVG icon from http://tabler-icons.io/i/plus -->
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M12 5l0 14" /><path d="M5 12l14 0" /></svg>
                        </a> *@
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Page body -->
    <div class="page-body">
        <div class="container-xl">
            <div class="row row-deck row-cards">
                <div class="col-lg-12 col-md-12">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title"></h3>
                            <div class="card-actions">
                            </div>
                        </div>
                        <div class="card-body p-0">
                            @( Html.Kendo().Grid<PropertyManagementSystem.Models.GFMS_ReservationHeader>()
                                .Name("reservationGrid")
                                .ToolBar(tools => tools.Excel())
                                .Excel(excel => excel
                                .FileName("Reservations.xlsx")
                                .AllPages(true))
                                .Columns(columns =>
                                {
                                    columns.Bound(c => c.ReservationId).Visible(false).Exportable(false);
                                    columns.ForeignKey(c => c.ChargeToCompany , ds => ds.Read(r => r.Action("getCompanies", "Global")), "Id", "Company").Title("Charge To Company").Filterable(ftb => ftb.Cell(cell => cell.ShowOperators(false)));
                                    columns.Bound(c => c.Requestor);
                                    columns.Bound(c => c.RequestorEmail);
                                    columns.Bound(c => c.Status).Hidden(true);

                                })
                                .Scrollable()
                                .ToolBar(toolbar =>
                                {
                                    toolbar.Search();
                                })
                                .DataSource(dataSource => dataSource
                                .Ajax()
                                .Model(model => model.Id(p => p.ReservationId))
                                .Read(read => read.Action("getGuestHouseReservation", "Accommodation"))
                                .PageSize(50)
                                )
                                )


                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

@*NEW ROOM MODAL *@
<div class="modal modal-blur fade" id="modal-newRoom" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">New Dorm Room</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="fcFRM1" asp-controller="Room" asp-action="newDMRoom" enctype="multipart/form-data" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label required">Name </label>
                        <input class="form-control" name="_name" type="text" required="required">
                    </div>
                    <div class="mb-3">
                        <label class="form-label required">Facility</label>
                        @(Html.Kendo().DropDownList()
                            .Name("_facility")
                            .DataTextField("FacilityName")
                            .DataValueField("FacilityId")
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("getFacilityList", "Facility");
                                });
                            })
                            .HtmlAttributes(new { style = "width: 100%" })
                            )
                    </div>
                    <div class="mb-3">
                        <label class="form-label required">Capacity</label>
                        <input class="form-control" name="_capacity" type="number" required="required">
                    </div>
                    <label class="row">
                        <span class="col">Is Active</span>
                        <span class="col-auto">
                            <label class="form-check form-check-single form-switch">
                                <input class="form-check-input" name="_isActive" type="checkbox" checked>
                            </label>
                        </span>
                    </label>
                </div>


                <div class="modal-footer">
                    <button id="svbtn15" type="submit" class="btn btn btn-success ms-auto">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>
@*END - NEW FACILITY MODAL *@