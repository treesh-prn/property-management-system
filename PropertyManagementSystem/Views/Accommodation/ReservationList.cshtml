@{
    ViewData["Title"] = "Home Page";
    var alertMessage = TempData["AlertMessage"] as string;
    var alertSubMessage = TempData["AlertSubMessage"] as string;
    var alertType = TempData["AlertType"] as string;
}
<div class="page-wrapper">
    @if (!string.IsNullOrEmpty(alertMessage))
    {
        <div class="col-lg-6 ms-auto alert alert-@alertType alert-dismissible fade show custom-alert" role="alert">
            <div class="d-flex">
                <div>
                    @if (alertType == "success")
                    {
                        <!-- Download SVG icon from http://tabler-icons.io/i/check -->
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon alert-icon">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                            <path d="M5 12l5 5l10 -10" />
                        </svg>
                    }
                    else if (alertType == "error")
                    {
                        <!-- Error icon -->
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon alert-icon">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                            <circle cx="12" cy="12" r="9" />
                            <line x1="12" y1="8" x2="12" y2="12" />
                            <line x1="12" y1="16" x2="12.01" y2="16" />
                        </svg>
                    }
                </div>
                <div>
                    <h4 class="alert-title">@alertMessage</h4>
                    <div class="text-secondary">@alertSubMessage</div>
                </div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    <!-- Page header -->
    <div class="page-header d-print-none">
        <div class="container-xl">
            <div class="row g-2 align-items-center">
                <div class="col">
                    <!-- Page pre-title -->
                    <div class="page-pretitle">
                        Reservation
                    </div>
                    <h2 class="page-title">
                        GUEST HOUSE
                    </h2>
                </div>
                <!-- Page title actions -->
                <div class="col-auto ms-auto d-print-none">
                    <div class="btn-list">
                        <a href="#" class="btn btn-primary d-none d-sm-inline-block" data-bs-toggle="modal" data-bs-target="#modal-newReservation">
                            <i class="ti ti-plus"></i>
                            Create New Reservation
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Page body -->
    <div class="page-body">
        <div class="container-xl">
            <div class="row row-deck row-cards">
                <div class="col-lg-12 col-md-12">
                    <div class="card">
                        @(Html.Kendo().TabStrip()
                                .Name("tabstrip")
                                .Animation(animation =>
                                animation.Open(effect =>
                                effect.Fade(FadeDirection.In)))
                                .Items(tabstrip =>
                                {
                                    tabstrip.Add().Text("My Reservation")
                                .Encoded(false)

                                .Selected(true)
                                .Content(@<text>
                            <div id="myReservation" class="tab-pane active">
                                @(
                                Html.Kendo().Grid<PropertyManagementSystem.Models.ReservationViewModel>()
                                .Name("reservationGrid2")
                                .ToolBar(tools => tools.Excel())
                                .Excel(excel => excel
                                .FileName("Reservations.xlsx")
                                .AllPages(true))
                                .Columns(columns =>
                                {
                                columns.Bound(c => c.ReservationId).Visible(false).Exportable(false);
                                columns.Bound(c => c.ReservationDetailId).Visible(false).Exportable(false);
                                columns.Bound(c => c.ReservationCode);
                                columns.ForeignKey(c => c.ChargeToCompany, ds => ds.Read(r => r.Action("getCompanies", "Global")), "Id", "CompanyCode").Title("Charge To Company").Filterable(ftb => ftb.Cell(cell => cell.ShowOperators(false)));
                                columns.Bound(c => c.DepartmentName);
                                columns.Bound(c => c.Requestor);
                                columns.Bound(c => c.RequestorEmail).Hidden(true);
                                columns.Bound(c => c.Status).ClientTemplate(
                                "<div class='datagrid-content'>" +
                                "# if (Status === 'PENDING' || Status === 'DRAFT') { #" +
                                "<span class='status status-blue'><span class='status-dot'></span><strong>#: Status #</strong></span>" +
                                "# } else if (Status === \"FOR DEPARTMENT HEAD'S APPROVAL\" || Status === \"FOR ADMIN APPROVER'S APPROVAL\" || Status === \"FOR ADMIN MANAGER'S APPROVAL\" || Status === \"APPROVED\") { #" +
                                "<span class='status status-green'><span class='status-dot'></span><strong><strong> #: Status # </strong></strong></span>" +
                                "# } else if (Status === 'CANCELLED' || Status === 'DISAPPROVED') { #" +
                                "<span class='status status-red'><span class='status-dot'></span><strong> #: Status # </strong></span>" +
                                "# } else { #" +
                                "<span>#: Status #</span>" +
                                "# } #" +
                                "</div>"
                                ).Title("Status").Width(350);
                                columns.Command(command =>
                                {
                                command.Custom("view")
                                .Text("<i class='ti ti-eye'></i>View")
                                .Click("onViewClickReservationList")
                                .HtmlAttributes(new { @class = "k-button k-grid-View k-button-sm k-rounded-md k-button-solid k-button-solid-success", style = "width: 250px;" });
                                })
                                .Title("Actions")
                                .Width(300)
                                .Exportable(false);

                                })
                                .NoRecords()
                                .Groupable()
                                .Filterable()
                                .Scrollable()
                                .ToolBar(toolbar =>
                                {
                                toolbar.Search();
                                })
                                .DataSource(dataSource => dataSource
                                .Ajax()
                                .Model(model =>
                                {
                                model.Id(p => p.ReservationId);
                                model.Field(p => p.GUID);
                                model.Field(p => p.ReservationType);
                                model.Field(p => p.ReservationDetailId);
                                })
                                .Read(read => read.Action("getGuestHouseReservation", "Accommodation", new {gridType = "myReservation"}))
                                .PageSize(50)
                                )
                                )
                            </div>
                        </text>);
                                 if(!User.IsInRole("GFMS.Requestor")){
                                        tabstrip.Add().Text("Reservation Request")
                                        .Encoded(false)
                                        .Content(@<text>
                            <div id="reservationApproval">
                                @(
                                Html.Kendo().Grid<PropertyManagementSystem.Models.ReservationViewModel>()
                                .Name("reservationGrid")
                                .ToolBar(tools => tools.Excel())
                                .Excel(excel => excel
                                .FileName("Reservations.xlsx")
                                .AllPages(true))
                                .Columns(columns =>
                                {
                                columns.Bound(c => c.ReservationId).Visible(false).Exportable(false);
                                columns.Bound(c => c.ReservationDetailId).Visible(false).Exportable(false);
                                columns.Bound(c => c.ReservationCode);
                                columns.ForeignKey(c => c.ChargeToCompany, ds => ds.Read(r => r.Action("getCompanies", "Global")), "Id", "CompanyCode").Title("Charge To Company").Filterable(ftb => ftb.Cell(cell => cell.ShowOperators(false)));
                                columns.Bound(c => c.DepartmentName);
                                columns.Bound(c => c.Requestor);
                                columns.Bound(c => c.RequestorEmail).Hidden(true);
                                columns.Bound(c => c.Status).ClientTemplate(
                                "<div class='datagrid-content'>" +
                                "# if (Status === 'PENDING' || Status === 'DRAFT') { #" +
                                "<span class='status status-blue'><span class='status-dot'></span><strong>#: Status #</strong></span>" +
                                "# } else if (Status === \"FOR DEPARTMENT HEAD'S APPROVAL\" || Status === \"FOR ADMIN APPROVER'S APPROVAL\" || Status === \"FOR ADMIN MANAGER'S APPROVAL\" || Status === \"APPROVED\") { #" +
                                "<span class='status status-green'><span class='status-dot'></span><strong><strong> #: Status # </strong></strong></span>" +
                                "# } else if (Status === 'CANCELLED' || Status === 'DISAPPROVED') { #" +
                                "<span class='status status-red'><span class='status-dot'></span><strong> #: Status # </strong></span>" +
                                "# } else { #" +
                                "<span>#: Status #</span>" +
                                "# } #" +
                                "</div>"
                                ).Title("Status").Width(350);
                                columns.Command(command =>
                                {
                                command.Custom("view")
                                .Text("<i class='ti ti-eye'></i>View")
                                .Click("onViewClickReservationList")
                                .HtmlAttributes(new { @class = "k-button k-grid-View k-button-sm k-rounded-md k-button-solid k-button-solid-success", style = "width: 250px;" });
                                })
                                .Title("Actions")
                                .Width(300)
                                .Exportable(false);

                                })
                                .NoRecords()
                                .Groupable()
                                .Filterable()
                                .Scrollable()
                                .ToolBar(toolbar =>
                                {
                                toolbar.Search();
                                })
                                .DataSource(dataSource => dataSource
                                .Ajax()
                                .Model(model =>
                                {
                                model.Id(p => p.ReservationId);
                                model.Field(p => p.GUID);
                                model.Field(p => p.ReservationType);
                                model.Field(p => p.ReservationDetailId);
                                })
                                .Read(read => read.Action("getGuestHouseReservation", "Accommodation", new { gridType = "reservationApproval" }))
                                .PageSize(50)
                                )
                                )
                            </div>
                        </text>);
                                 }
                                })
                            )
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<partial name="Shared/_newReservation" />