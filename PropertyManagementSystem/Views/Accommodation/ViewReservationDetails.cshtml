@model PropertyManagementSystem.Models.ReservationViewModel

@{
    ViewData["Title"] = "View Reservation Details";
}

<div class="page-wrapper">
    <div class="page-header d-print-none">
        <div class="container-xl">
            <div class="row g-2 align-items-center">
                <div class="col">
                    <div class="page-pretitle">
                        View Reservation
                    </div>
                    <h2 class="page-title">
                        Reservation Details
                    </h2>
                </div>
                <div class="col-auto ms-auto d-print-none">
                   @*  <div class="btn-list">
                        <a href="@Url.Action("Index", "Accommodation")" class="btn btn-primary bg-green">
                            <i class="ti ti-arrow-left icon"></i>
                            Go Back
                        </a>
                    </div> *@
                </div>
            </div>
        </div>
    </div>
    <div class="page-body">
        <div class="container-xl">
            <div class="row row-cards">
                <div class="col-lg-3">
                    <div class="card text-center">
                        <div class="card-header card-header-light">
                            <h3 class="card-title">Reservation #@Model.ReservationHeader.ReservationId</h3>
                        </div>
                        <img class="img-responsive2 mx-auto" src="@Url.Content("~/img/calendar.jpg")" alt="Reservation Image">
                        <div class="card-body">
                            <h5 class="card-title">Reservation Details</h5>
                            <table class="table table-borderless text-left">
                                <tbody>
                                    <tr>
                                        <th scope="row">Requestor</th>
                                        <td>@Model.ReservationHeader.Requestor</td>
                                    </tr>
                                    <tr>
                                        <th scope="row">Email</th>
                                        <td>@Model.ReservationHeader.RequestorEmail</td>
                                    </tr>
                                    <tr>
                                        <th scope="row">Date Filed</th>
                                        <td>@Model.ReservationHeader.DateFiled</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="col-lg-9">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">
                                Guesthouse Reservation Form
                            </h3>
                        </div>
                        <div class="card-body">
                            <div class="modal-content">
                                <form asp-action="UpdateReservationDetails" asp-controller="Accommodation" method="post">
                                    <input type="hidden" name="ReservationId" value="@Model.ReservationHeader.ReservationId">
                                    <div class="modal-body">
                                        <div class="row mb-3">
                                            <div class="col-lg-5">
                                                <label class="form-label">Guest Name</label>
                                            </div>
                                            <div class="col-lg-3">
                                                <label class="form-label">Company</label>
                                            </div>
                                            <div class="col-lg-3">
                                                <label class="form-label">Relationship</label>
                                            </div>
                                        </div>
                                        <div id="dynamic-rows">
                                            @foreach (var detail in Model.ReservationDetails)
                                            {
                                                <div class="row mb-3">
                                                    <input type="hidden" class="form-control" name="@detail.ReservationDetailId" placeholder="Guest Name" value="@detail.ReservationDetailId">
                                                    <div class="col-lg-5">
                                                        @* <label class="form-label">Guest Name</label> *@
                                                        <input type="text" class="form-control" name="_guests[]" placeholder="Guest Name" value="@detail.GuestName" required>
                                                    </div>
                                                    <div class="col-lg-3">
                                                        @* <label class="form-label">Company</label> *@
                                                        <input type="text" class="form-control" name="_company[]" placeholder="Company" value="@detail.Company" required>
                                                    </div>
                                                    <div class="col-lg-3">
                                                        @* <label class="form-label">Relationship</label> *@
                                                        <input type="text" class="form-control" name="_relationship[]" placeholder="Input Relationship if applicable" value="@detail.Relationship" required>
                                                    </div>
                                                    <div class="col-sm-1 d-flex align-items-end">
                                                        <button type="button" id="add-row" class="btn btn-primary ml-2 custom-padding">
                                                            <i class="ti ti-plus"></i>
                                                        </button>
                                                        <button type="button" class="btn btn-danger remove-row ml-2 custom-padding">
                                                            <i class="ti ti-trash"></i>
                                                        </button>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                        <div class="row mb-3">
                                            <label class="form-label">Duration of Stay</label>
                                            <div class="col-lg-6">
                                                <label class="form-label required">Start Date</label>
                                                @(
                                                    Html.Kendo().DateTimePicker()
                                                    .Name("StartDate")
                                                    .Value(Model.ReservationDetails.FirstOrDefault()?.StartDate)
                                                    .DateInput(true)
                                                    .Format("yyyy/MM/dd HH:mm:ss.fff")
                                                    .ParseFormats(new string[] { "yyyy/MM/dd HH:mm:ss.fff", "yyyy-MM-ddTHH:mm:ss.fffZ" })
                                                    )
                                            </div>
                                            <div class="col-lg-6">
                                                <label class="form-label required">End Date</label>
                                                @(
                                                    Html.Kendo().DateTimePicker()
                                                    .Name("EndDate")
                                                    .Value(Model.ReservationDetails.FirstOrDefault()?.EndDate)
                                                    .Format("yyyy/MM/dd HH:mm:ss.fff")
                                                    .ParseFormats(new string[] { "yyyy/MM/dd HH:mm:ss.fff", "yyyy-MM-ddTHH:mm:ss.fffZ" })
                                                    )
                                            </div>
                                        </div>
                                        <div class="col-lg-12">
                                            <label class="form-label">
                                                Purpose
                                                <span class="form-label-description">26/50</span>
                                            </label>
                                            <textarea class="form-control" rows="3" name="Purpose">@Model.ReservationDetails.FirstOrDefault()?.Purpose</textarea>
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <a href="@Url.Action("Index", "Accommodation")" class="btn btn-link link-secondary">
                                            Cancel
                                        </a>
                                        <button type="submit" class="btn btn-primary ms-auto">
                                            Update
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
