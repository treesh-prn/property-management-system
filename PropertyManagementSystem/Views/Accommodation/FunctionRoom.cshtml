@model IEnumerable<PropertyManagementSystem.Models.ReservationViewModel>

@{
    ViewData["Title"] = "Home Page";
    var rooms = ViewData["Rooms"] as List<PropertyManagementSystem.Models.GFMS_Rooms>;
    var facilities = ViewData["Facilities"] as List<PropertyManagementSystem.Models.GFMS_Facility>;
    //var rooms = ViewData["Rooms"] as List<GFMS_Rooms>;
    //var facilityNames = ViewData["Facility"] as List<GFMS_Facility>;

}
<div class="page-wrapper">
    <!-- Page header -->
    <div class="page-header d-print-none">
        <div class="container-xl">
            <div class="row g-2 align-items-center">
                <div class="col">
                    <!-- Page pre-title -->
                    <div class="page-pretitle">
                        ACCOMMODATION
                    </div>
                    <h2 class="page-title">
                        FUNCTION ROOM
                    </h2>
                </div>
                <!-- Page title actions -->
                <div class="col-auto ms-auto d-print-none">
                    <div class="btn-list">
                        <span class="d-none d-sm-inline">
                            <a href="@Url.Action("ReservationList","Accommodation")" class="btn">
                                Reservation List
                            </a>
                        </span>
                        <a href="#" class="btn btn-primary d-none d-sm-inline-block" data-bs-toggle="modal" data-bs-target="#modal-newReservatoion">
                            <i class="ti ti-plus"></i>
                            Create New Reservation
                        </a>
                        <a href="#" class="btn btn-primary d-sm-none btn-icon" data-bs-toggle="modal" data-bs-target="#modal-report" aria-label="Create New Reservation">
                            <i class="ti ti-plus"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Page body -->
    <div class="page-body">
        <div class="container-xl">
            <div class="row row-deck row-cards">
                <div class="row row-deck row-cards">
                    <div class="col-12">
                        <div class="row row-cards">
                            <div class="col-sm-6 col-lg-3">
                                <div class="card card-sm">
                                    <div class="card-body">
                                        <div class="row align-items-center">
                                            <div class="col-auto">
                                                <span class="bg-primary text-white avatar">
                                                    <i class="ti ti-user-star" style="font-size: 30px;"></i>
                                                </span>
                                            </div>
                                            <div class="col">
                                                <div class="font-weight-heavy">
                                                    3
                                                </div>
                                                <div class="text-secondary">
                                                    New Reservations
                                                </div>
                                            </div>
                                            <div class="col-auto">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-6 col-lg-3">
                                <div class="card card-sm">
                                    <div class="card-body">
                                        <div class="row align-items-center">
                                            <div class="col-auto">
                                                <span class="bg-success text-white avatar">
                                                    <i class="ti ti-friends" style="font-size: 30px;"></i>
                                                </span>
                                            </div>
                                            <div class="col">
                                                <div class="font-weight-heavy">
                                                    10
                                                </div>
                                                <div class="text-secondary">
                                                    Active Guest Count
                                                </div>
                                            </div>
                                            <div class="col-auto">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-6 col-lg-3">
                                <div class="card card-sm">
                                    <div class="card-body">
                                        <div class="row align-items-center">
                                            <div class="col-auto">
                                                <span class="bg-danger text-white avatar">
                                                    <i class="ti ti-bed" style="font-size: 30px;"></i>
                                                </span>
                                            </div>
                                            <div class="col">
                                                <div class="font-weight-heavy">
                                                    5
                                                </div>
                                                <div class="text-secondary">
                                                    Occupied Rooms
                                                </div>
                                            </div>
                                            <div class="col-auto">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-6 col-lg-3">
                                <div class="card card-sm">
                                    <div class="card-body">
                                        <div class="row align-items-center">
                                            <div class="col-auto">
                                                <span class="bg-warning text-white avatar">
                                                    <i class="ti ti-home" style="font-size: 30px;"></i>
                                                </span>
                                            </div>
                                            <div class="col">
                                                <div class="font-weight-heavy">
                                                    10
                                                </div>
                                                <div class="text-secondary">
                                                    Available Room
                                                </div>
                                            </div>
                                            <div class="col-auto">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            @(
                                Html.Kendo().Scheduler<PropertyManagementSystem.Models.ReservationViewModel>()
                                .Name("scheduler")
                                .StartTime(new DateTime(DateTime.Now.Year, DateTime.Now.Month, DateTime.Now.Day, 8, 0, 0))
                                .EndTime(new DateTime(DateTime.Now.Year, DateTime.Now.Month, DateTime.Now.Day, 8, 0, 0))
                                .MajorTick(1440)
                                .MinorTickCount(1)
                                .DateHeaderTemplate("<strong>#=kendo.toString(date, 'D')#</strong>")
                                .Views(views =>
                                {

                                    views.TimelineWorkWeekView(timeline => timeline.EventHeight(50));
                                    views.TimelineMonthView(timeline =>
                                    {
                                        timeline.StartTime(new DateTime(2022, 6, 13, 00, 00, 00));
                                        timeline.EndTime(new DateTime(2022, 6, 13, 00, 00, 00));
                                        timeline.MajorTick(1440);
                                        timeline.EventHeight(50);
                                    });
                                })
                                .Timezone("Etc/UTC")
                                .Group(g => g.Resources("Rooms", "Facilities").Orientation(SchedulerGroupOrientation.Vertical))
                                .Resources(resource =>
                                {
                                    resource.Add(m => m.FacilityId)
                                    .Title("Facility")
                                    .Name("Facilities")
                                    .DataTextField("FacilityName")
                                    .DataValueField("FacilityId")
                                    .BindTo(facilities.Select(f => new
                                    {
                                    FacilityId = f.FacilityId,
                                    FacilityName = f.FacilityName
                                    }));

                                    resource.Add(m => m.RoomId)
                                    .Title("Room")
                                    .Name("Rooms")
                                    .DataTextField("RoomName")
                                    .DataValueField("RoomId")
                                    .DataParentValueField("FacilityId")
                                    .BindTo(rooms.Select(r => new
                                    {
                                    RoomId = r.RoomId,
                                    RoomName = r.RoomName,
                                    FacilityId = r.FacilityId
                                    }));


                                })

                                .DataSource(d => d
                                .Model(m =>
                                {
                                    m.Id(f => f.ReservationId);
                                    m.Field(f => f.Title).DefaultValue("No title");
                                    m.RecurrenceId(f => f.RecurrenceID);
                                    m.Field(f => f.Start).DefaultValue(DateTime.UtcNow);
                                    m.Field(f => f.End).DefaultValue(DateTime.UtcNow.AddHours(1));
                                    m.Field(f => f.RoomId);
                                    m.Field(f => f.FacilityId);
                                })
                                .Read("ViewReservation", "Accommodation")
                                )
                                )
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@*NEW ROOM MODAL *@
<div class="modal modal-blur fade" id="modal-newReservatoion" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">New Reservation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="fcFRM1" asp-controller="Accommodation" asp-action="CreateReservation" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label required">Charge to Company:</label>
                        @(Html.Kendo().DropDownList()
                            .Name("_company")
                            .DataTextField("Company")
                            .DataValueField("Id")
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("getCompanies", "Global");
                                });
                            })
                            .HtmlAttributes(new { style = "width: 100%" })
                            )
                    </div>
                    <div class="mb-3">
                        <label class="form-label required">Requestor Name</label>
                        <input class="form-control" name="_requestor" type="text" required="required">
                    </div>
                </div>
                <div class="modal-footer">
                    <button id="svbtn15" type="submit" class="btn btn btn-success ms-auto">Create</button>
                </div>
            </form>
        </div>
    </div>
</div>
@*END - NEW Room MODAL *@