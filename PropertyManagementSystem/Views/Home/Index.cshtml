@model PropertyManagementSystem.Models.ReservationViewModel
@inject PropertyManagementSystem.Services.IRoleService RoleService
@{
    ViewData["Title"] = "Home Page";
    var rooms = ViewData["Rooms"] as List<PropertyManagementSystem.Models.GFMS_Rooms>;
    var facilities = ViewData["Facilities"] as List<PropertyManagementSystem.Models.GFMS_Facility>;
    //var rooms = ViewData["Rooms"] as List<GFMS_Rooms>;
    //var facilities = ViewData["Facilities"] as List<GFMS_Facility>;

    var employee = await RoleService.GetUserName(User);

}

<div class="page-wrapper">
    <!-- Page header -->
    <div class="page-header d-print-none">
        <div class="container-xl">
            <div class="row g-2 align-items-center">
                <div class="col">
                    <!-- Page pre-title -->
                    <div class="page-pretitle">
                     HOME
                    </div>
                    <h2 class="page-title">
                        DASHBOARD
                    </h2>
                </div>
                <!-- Page title actions -->
                <div class="col-auto ms-auto d-print-none">
                    <div class="btn-list">
               
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Page body -->
    <div class="page-body">
        <div class="container-xl">
            <div class="row row-deck row-cards">
                <div class="col-12">
                    <div class="row row-cards">
                        <div class="col-sm-6 col-lg-3">
                            <div class="card card-sm">
                                <div class="card-body">
                                    <div class="row align-items-center">
                                        <div class="col-auto">
                                            <span class="bg-primary text-white avatar">
                                                <i class="ti ti-briefcase" style="font-size: 30px;"></i>
                                            </span>
                                        </div>
                                        <div class="col">
                                            <div class="font-weight-medium">
                                               : Total Venue
                                            </div>
                                            <div class="text-secondary">
                                                12 waiting reservation
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6 col-lg-3">
                            <div class="card card-sm">
                                <div class="card-body">
                                    <div class="row align-items-center">
                                        <div class="col-auto">
                                            <span class="bg-success text-white avatar">
                                                <i class="ti ti-home" style="font-size: 30px;"></i>
                                            </span>
                                        </div>
                                        <div class="col">
                                            <div class="font-weight-medium">
                                                : Total Rooms
                                            </div>
                                            <div class="text-secondary">
                                                12 waiting reservation
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6 col-lg-3">
                            <div class="card card-sm">
                                <div class="card-body">
                                    <div class="row align-items-center">
                                        <div class="col-auto">
                                            <span class="bg-yellow text-white avatar">
                                                <i class="ti ti-bed" style="font-size: 30px;"></i>
                                            </span>
                                        </div>
                                        <div class="col">
                                            <div class="font-weight-medium">
                                                : Total Dorm Space
                                            </div>
                                            <div class="text-secondary">
                                                67 active tenants
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6 col-lg-3">
                            <div class="card card-sm">
                                <div class="card-body">
                                    <div class="row align-items-center">
                                        <div class="col-auto">
                                            <span class="bg-warning text-white avatar">
                                                <i class="ti ti-home" style="font-size: 30px;"></i>
                                            </span>
                                        </div>
                                        <div class="col">
                                            <div class="font-weight-medium">
                                                : Total Rooms
                                            </div>
                                            <div class="text-secondary">
                                                12 waiting reservation
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12">
                            @(Html.Kendo().Scheduler<PropertyManagementSystem.Models.ReservationViewModel>()
                                .Name("scheduler")
                                .StartTime(new DateTime(DateTime.Now.Year, DateTime.Now.Month, DateTime.Now.Day, 7, 0, 0))
                                .MajorTick(60)
                                .MinorTickCount(1)
                                .DateHeaderTemplate("<strong>#=kendo.toString(date, 'D')#</strong>")
                                .Views(views =>
                                {
                                    views.TimelineMonthView(timeline =>
                                    {
                                        timeline.StartTime(new DateTime(2022, 6, 13, 00, 00, 00));
                                        timeline.EndTime(new DateTime(2022, 6, 13, 00, 00, 00));
                                        timeline.MajorTick(1440);
                                        timeline.EventHeight(50);
                                    });
                                })
                                .Timezone("Etc/UTC")
                                .Group(g => g.Resources("Rooms", "Facilities").Orientation(SchedulerGroupOrientation.Vertical))
                                .Resources(resource =>
                                {
                                    resource.Add(m => m.FacilityId)
                                    .Title("Facility")
                                    .Name("Facilities")
                                    .DataTextField("FacilityName")
                                    .DataValueField("FacilityId")
                                    .BindTo(facilities.Select(f => new
                                    {
                                        FacilityId = f.FacilityId,
                                        FacilityName = f.FacilityName
                                    }));

                                    resource.Add(m => m.RoomId)
                                    .Title("Room")
                                    .Name("Rooms")
                                    .DataTextField("RoomName")
                                    .DataValueField("RoomId")
                                    .DataParentValueField("FacilityId")
                                    .BindTo(rooms.Select(r => new
                                    {
                                        RoomId = r.RoomId,
                                        RoomName = r.RoomName,
                                        FacilityId = r.FacilityId
                                    }));
                                })
                                .DataSource(d => d
                                .Model(m =>
                                {
                                    m.Id(f => f.ReservationId);
                                    m.Field(f => f.Title).DefaultValue("No title");
                                    m.Field(f => f.GUID);
                                    m.RecurrenceId(f => f.RecurrenceID);
                                    m.Field(f => f.Start);
                                    m.Field(f => f.End);
                                    m.Field(f => f.RoomId);
                                    m.Field(f => f.FacilityId);
                                })
                                .Read("ViewReservation", "FunctionRoom")
                                .Update("ViewReservationDetails", "FunctionRoom")
                                .Destroy(destroy => destroy.Action("DeleteReservationDetail", "FunctionRoom"))
                                )
                                .Events(events => events
                                .DataBound("onDataBound")
                                .Edit("onEditView"))
                                )
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
  
</div>