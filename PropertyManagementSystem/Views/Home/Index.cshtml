@model PropertyManagementSystem.Models.ReservationViewModel
@inject PropertyManagementSystem.Services.IRoleService RoleService
@{
    ViewData["Title"] = "Home Page";
    var rooms = ViewData["Rooms"] as List<PropertyManagementSystem.Models.GFMS_Rooms>;
    var facilities = ViewData["Facilities"] as List<PropertyManagementSystem.Models.GFMS_Facility>;

    var employee = await RoleService.GetUserName(User);
    var activeRole = await RoleService.GetActiveRoleAsync(User);
}

<div class="page-wrapper">
    <!-- Page header -->
    <div class="page-header d-print-none">
        <div class="container-xl">
            <div class="row g-2 align-items-center">
                <div class="col">
                    <!-- Page pre-title -->
                    <div class="page-pretitle">
                        HOME
                    </div>
                    <h2 class="page-title">
                        DASHBOARD
                    </h2>
                </div>
                <!-- Page title actions -->
                <div class="col-auto ms-auto d-print-none">
                    <div class="btn-list">
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Page body -->
    <div class="page-body">
        <div class="container-xl">
            <div class="row row-deck row-cards">
                <div class="col-12">
                    <div class="row row-cards">
                        <div class="col-sm-6 col-lg-3">
                            <a href="@Url.Action("ReservationList", "FunctionRoom")"
                               class="card card-sm text-decoration-none"
                               onclick="goToReservationApproval(event, this)">
                                <div class="card card-sm">
                                    @if(Model.NewFNReservationsCount != 0)
                                    {
                                        <span class="badge bg-blue text-blue-fg badge-notification badge-pill">
                                            @if (activeRole != "GFMS.Requestor")
                                            {
                                                @Model.NewFNReservationsCount
                                            }
                                            else
                                            {
                                                @Model.NewFNReservationsCount
                                            }
                                        </span>
                                    }
                                    <div class="card-body">
                                        <div class="row align-items-center">
                                            <div class="col-auto">
                                                <span class="bg-primary text-white avatar">
                                                    <i class="ti ti-briefcase" style="font-size: 30px;"></i>
                                                </span>
                                            </div>
                                            <div class="col">
                                                <div class="font-weight-medium" style="font-weight:600">
                                                    Function Room
                                                </div>
                                                @if (activeRole != "GFMS.Requestor")
                                                {
                                                    <div class="text-secondary">
                                                        @Model.NewFNReservationsCount waiting for approval
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="text-secondary">
                                                        @Model.NewFNReservationsCount pending for approval
                                                    </div>
                                                }

                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        </div>
                        <div class="col-sm-6 col-lg-3">
                            <a href="@Url.Action("ReservationList", "Accommodation")" class="card card-sm text-decoration-none">
                                <div class="card card-sm">
                                    @if (Model.NewGHReservationsCount != 0)
                                    {
                                        <span class="badge bg-blue text-blue-fg badge-notification badge-pill">
                                            @if (activeRole != "GFMS.Requestor")
                                            {
                                                @Model.NewGHReservationsCount
                                            }
                                            else
                                            {
                                                @Model.NewGHReservationsCount
                                            }
                                        </span>
                                    }
                                    <div class="card-body">
                                        <div class="row align-items-center">
                                            <div class="col-auto">
                                                <span class="bg-success text-white avatar">
                                                    <i class="ti ti-door" style="font-size: 30px;"></i>
                                                </span>
                                            </div>
                                            <div class="col">
                                                <div class="font-weight-medium" style="font-weight:600">
                                                    Accommodation
                                                </div>
                                                @if (activeRole != "GFMS.Requestor")
                                                {
                                                    <div class="text-secondary">
                                                        @Model.NewGHReservationsCount waiting for approval
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="text-secondary">
                                                        @Model.NewGHReservationsCount pending for approval
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        </div>
                        <div class="col-sm-6 col-lg-3">
                            <a href="@Url.Action("ReservationList", "Dorm")" class="card card-sm text-decoration-none">
                                <div class="card card-sm">
                                    @if (Model.NewDRMReservationsCount != 0)
                                    {
                                        <span class="badge bg-blue text-blue-fg badge-notification badge-pill">
                                            @if (activeRole != "GFMS.Requestor")
                                            {
                                                @Model.NewDRMReservationsCount
                                            }
                                            else
                                            {
                                                @Model.NewDRMReservationsCount
                                            }
                                        </span>
                                    }
                                    <div class="card-body">
                                        <div class="row align-items-center">
                                            <div class="col-auto">
                                                <span class="bg-yellow text-white avatar">
                                                    <i class="ti ti-bed" style="font-size: 30px;"></i>
                                                </span>
                                            </div>
                                            <div class="col">
                                                <div class="font-weight-medium" style="font-weight:600">
                                                    Dorm and Housing
                                                </div>
                                                @if (activeRole != "GFMS.Requestor")
                                                {
                                                    <div class="text-secondary">
                                                        @Model.NewDRMReservationsCount waiting for approval
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="text-secondary">
                                                        @Model.NewDRMReservationsCount pending for approval
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        </div>
                        <div class="col-sm-6 col-lg-3">
                            <div class="card card-sm">
                                <div class="card-body">
                                    <div class="row align-items-center">
                                        <div class="col-auto">
                                            <span class="bg-warning text-white avatar">
                                                <i class="ti ti-home" style="font-size: 30px;"></i>
                                            </span>
                                        </div>
                                        <div class="col">
                                            <div class="font-weight-medium" style="font-weight:600">
                                                Total Rooms
                                            </div>
                                            <div class="text-secondary">
                                                12 waiting reservation
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-9">
                    <div class="card">
                        @(Html.Kendo().TabStrip()
                                .Name("tabstrip")
                                .Animation(animation =>
                                animation.Open(effect =>
                                effect.Fade(FadeDirection.In)))
                                .Items(tabstrip =>
                                {
                                    tabstrip.Add().Text("Function Room")
                                .Encoded(false)

                                .Selected(true)
                                .Content(@<text>
                            <div id="fnRoom" class="tab-pane active">
                                <partial name="Shared/_fnRoom" />
                            </div>
                        </text>);
                                    tabstrip.Add().Text("Guest Room")
                                .Encoded(false)
                                .Content(@<text>
                            <div id="ghRoom">
                                <partial name="Shared/_ghRoom" />
                            </div>
                        </text>);
                                })
                            )
                    </div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <div class="card card-sm">
                        <div class="card-body">
                            <div class="row align-items-center">
                                <div class="col-auto">
                                    <span class="bg-pink text-white avatar">
                                        <i class="ti ti-calendar-event" style="font-size: 30px;"></i>
                                    </span>
                                </div>
                                <div class="col">
                                    <div style="font-weight:600">
                                        Availability Checker
                                    </div>
                                    <div class="text-secondary">
                                        Select facility and room to check availability.
                                    </div>
                                </div>
                                <!-- Filter Icon Button on the Side -->
                                <div class="col-auto text-end">
                                    <button class="btn" type="button" data-bs-toggle="collapse" data-bs-target="#filterPanel" aria-expanded="false" aria-controls="filterPanel">
                                        <i class="ti ti-filter" style="font-size: 20px;"></i>
                                    </button>
                                </div>
                            </div>

                            <!-- Collapsible Filter Categories -->
                            <div class="collapse mt-3" id="filterPanel">
                                <div class="card card-body">
                                    <!-- Facility and Room Selection -->
                                    <div class="mb-2">
                                        <label class="form-label required">Facility</label>
                                        @(
                                            Html.Kendo().DropDownList()
                                            .Name("_facilityId")
                                            .DataTextField("FacilityName")
                                            .DataValueField("FacilityId")
                                            .DataSource(source =>
                                            {
                                                source.Read(read =>
                                                {
                                                    read.Action("GetAllFacility", "Global").Data("filterFacilities");
                                                });
                                            })
                                            .HtmlAttributes(new { style = "width: 100%" })
                                            .OptionLabel("Select Facility")
                                            )
                                    </div>

                                    <div class="mb-2">
                                        <label class="form-label required">Room</label>
                                        @(Html.Kendo().DropDownList()
                                            .Name("_roomId")
                                            .DataTextField("RoomName")
                                            .DataValueField("RoomId")
                                            .CascadeFrom("_facilityId")
                                            .DataSource(source =>
                                            {
                                                source.Read(read =>
                                                {
                                                    read.Action("GetAllRooms", "Global").Data("filterRooms");
                                                }).ServerFiltering(true);
                                            })
                                            .HtmlAttributes(new { style = "width: 100%" })
                                            .OptionLabel("Select Room")
                                            )
                                    </div>

                                    <!-- Apply Filter Button -->
                                    <div class="mb-3">
                                        <button id="checkAvailabilityButton" class="btn btn-primary">
                                            <i class="fa fa-filter"></i> Check Room Availability
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- Calendar Preview -->
                            <div class="mt-3 mb-3 k-d-flex-col k-text-align-center k-align-items-center">
                                <div id="special-days">
                                    @(Html.Kendo().Calendar()
                                        .Name("calendar")
                                        .WeekNumber(false)
                                        .Footer(@"
                                    <div class='color-legend'>
                                    <span class='legend-item'>
                                    <span class='legend-box legend-fully-booked'></span> Fully Booked
                                    </span>
                                    <span class='legend-item'>
                                    <span class='legend-box legend-available'></span> Available
                                    </span>
                                    <span class='legend-item'>
                                    <span class='legend-box legend-current'></span> Current
                                    </span>
                                    </div>
                                    ")
                                        .MonthTemplate(month => month.Content(@"
                                    # if ($.inArray(data.date.getTime(), fullyBookedDates) !== -1) { #
                                    <div class='fully-booked'>#= data.value #</div>
                                    # } else if ($.inArray(data.date.getTime(), availableDates) !== -1) { #
                                    <div class='available'>#= data.value #</div>
                                    # } else { #
                                    <div>#= data.value #</div>
                                    # } #
                                    "))
                                        )
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-lg-12">
                                    <div style="font-weight:600; font-size:medium">
                                        Today's Bookings
                                    </div>
                                </div>
                            </div>

                            @foreach (var booking in Model.TodaysBookings)
                            {
                                <div class="col-auto">
                                    <div class="mb-3 card card-sm @(booking.ReservationType == "FN" ? "bg-blue-lt" : booking.ReservationType == "GH" ? "bg-green-lt" : "bg-gray-lt")">
                                        <div class="card-body">
                                            <div class="row align-items-center">
                                                <div class="col-auto">
                                                    <span class="@(booking.ReservationType == "FN" ? "bg-blue" : booking.ReservationType == "GH" ? "bg-green" : "bg-gray") text-white avatar">
                                                        <i class="@(booking.ReservationType == "FN" ? "ti ti-briefcase" : booking.ReservationType == "GH" ? "ti ti-door" : "ti ti-calendar")" style="font-size: 30px;"></i>
                                                    </span>
                                                </div>
                                                <div class="col">
                                                    <div style="font-weight:600">
                                                        @booking.Purpose
                                                    </div>
                                                    <div class="text-secondary">
                                                        @booking.StartDate - @booking.EndDate
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    kendo.culture("en-PH");
</script>