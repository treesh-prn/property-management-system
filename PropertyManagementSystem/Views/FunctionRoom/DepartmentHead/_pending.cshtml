@model PropertyManagementSystem.Models.ReservationViewModel
@foreach (var detail in Model.ReservationDetails)
{
    <form asp-action="UpdateReservationStatus" method="post">
        @Html.AntiForgeryToken()

        <input type="hidden" name="ReservationDetailId" value="@detail.ReservationDetailId">
        <input type="hidden" name="ReservationId" value="@detail.ReservationId">
        <div class="modal-body">
            <div id="dynamic-rows">
                <div class="row mb-3">
                    <div class="col-lg-12">
                        <label class="form-label">Number of Attendees</label>
                        <input type="number" class="form-control" name="NumberOfGuest" placeholder="Number of Attendees" value="@detail.NumberOfGuest" disabled>
                    </div>
                </div>
            </div>

            <label class="form-label">Duration of Stay</label>
            <div class="row mb-3">
                <div class="col-lg-6">
                    <label class="form-label required">Start Date</label>
                    @(
                        Html.Kendo().DateTimePicker()
                        .Name("StartDate")
                        .Value(detail.StartDate)
                        .DateInput(true)
                        .Format("yyyy/MM/dd HH:mm:ss.fff")
                        .ParseFormats(new string[] { "yyyy/MM/dd HH:mm:ss.fff", "yyyy-MM-ddTHH:mm:ss.fffZ" })
                        .Enable(false)
                        )
                </div>
                <div class="col-lg-6">
                    <label class="form-label required">End Date</label>
                    @(
                        Html.Kendo().DateTimePicker()
                        .Name("EndDate")
                        .Value(detail.EndDate)
                        .Format("yyyy/MM/dd HH:mm:ss.fff")
                        .ParseFormats(new string[] { "yyyy/MM/dd HH:mm:ss.fff", "yyyy-MM-ddTHH:mm:ss.fffZ" })
                        .Enable(false)
                        )
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-lg-12">
                    <label class="form-label">Equipment Needed</label>
                    @(Html.Kendo().MultiSelect()
                        .Name("EquipmentNeeded")
                        .Enable(false)
                        .DownArrow(true)
                        .DataTextField("EquipmentName")
                        .DataValueField("EquipmentId")
                        .Value(detail.EquipmentNeeded?.Split(new[] { ',' }, StringSplitOptions.RemoveEmptyEntries))
                        .Filter("contains")
                        .AutoBind(true)
                        .DataSource(source =>
                        {
                            source.Read(read =>
                            {
                                read.Action("GetEquipments", "Global");
                            });
                        })
                        )
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-lg-12">
                    <div>
                        <label class="form-label">Contact Number</label>
                        <div class="input-group mb-2">
                            <span class="input-group-text">+63</span>
                            <input type="text" class="form-control" name="_contactNumber" placeholder="Contact Number" maxlength="10" value="@detail.ContactNumber" disabled>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-12">
                <div>
                    <label class="form-label">Purpose <span class="form-label-description">26/50</span></label>
                    <textarea class="form-control" rows="3" name="Purpose" disabled>@detail.Purpose</textarea>
                </div>
            </div>
        </div>
        <div class="modal-footer ms-auto">
            <button type="submit" name="action" value="Reject" class="btn btn-red m-1">
                <i class="ti ti-ban m-1"></i> Reject
            </button>
            <button type="submit" name="action" value="Approve" class="btn btn-primary">
                <i class="ti ti-check m-1"></i> Approve
            </button>
        </div>
    </form>
}
