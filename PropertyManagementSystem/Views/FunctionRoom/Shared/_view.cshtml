@model PropertyManagementSystem.Models.ReservationViewModel
@inject PropertyManagementSystem.Services.IRoleService RoleService
@{
    var employee = await RoleService.GetUserName(User);
    var reservationDetail = Model.ReservationDetails?.FirstOrDefault();
    var identityEmail = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
        ?? User.FindFirst("email")?.Value
        ?? User.Identity?.Name;
    var isOwner = PropertyManagementSystem.Services.ReservationOwnership.IsOwner(
        Model.ReservationHeader,
        identityEmail,
        employee?.Email);
    var canCancel = isOwner &&
        reservationDetail?.StartDate >= DateTime.Now.AddHours(1) &&
        Model.ReservationHeader.Status != "CANCELLED" &&
        Model.ReservationHeader.Status != "DISAPPROVED" &&
        Model.ReservationHeader.Status != "DELETED";
}

<partial name="~/Views/FunctionRoom/Shared/_reservationDetails.cshtml" model="Model" />

<div class="card-footer d-flex justify-content-between align-items-center">
    <a href="@Url.Action("ReservationList", "FunctionRoom")" class="btn btn-link link-secondary">
        Go Back
    </a>
    @if (canCancel)
    {
        <button type="button" class="btn btn-red" data-bs-toggle="modal" data-bs-target="#modal-cancel-function-room">
            <i class="ti ti-x me-1" aria-hidden="true"></i>Cancel request
        </button>
    }
</div>

@if (canCancel && reservationDetail != null)
{
    <div class="modal modal-blur fade" id="modal-cancel-function-room" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-md modal-dialog-centered" role="document">
            <div class="modal-content">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                <div class="modal-status bg-danger"></div>
                <div class="modal-body text-center py-4">
                    <span class="avatar avatar-lg bg-red-lt text-red mb-3">
                        <i class="ti ti-calendar-cancel" aria-hidden="true"></i>
                    </span>
                    <h3>Cancel this request?</h3>
                    <p class="text-secondary mb-0">The reservation will be marked as cancelled and removed from the active approval queue.</p>
                </div>
                <form asp-action="UpdateReservationStatus" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ReservationDetailId" value="@reservationDetail.ReservationDetailId" />
                    <input type="hidden" name="ReservationId" value="@Model.ReservationHeader.ReservationId" />
                    <div class="px-3">
                        <label class="form-label" for="function-room-cancel-remarks">Reason <span class="form-label-description">Optional</span></label>
                        <textarea class="form-control" id="function-room-cancel-remarks" rows="3" name="Remarks" placeholder="Add a short reason for cancelling"></textarea>
                    </div>
                    <div class="modal-footer">
                        <div class="row w-100 g-2">
                            <div class="col">
                                <button type="button" class="btn w-100" data-bs-dismiss="modal">Go Back</button>
                            </div>
                            <div class="col">
                                <button type="submit" name="action" value="Cancel" class="btn btn-danger w-100">Cancel request</button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
