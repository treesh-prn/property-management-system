@model PropertyManagementSystem.Models.ReservationViewModel
@inject PropertyManagementSystem.Services.IRoleService RoleService

@{
    var activeRole = await RoleService.GetActiveRoleAsync(User);
}
@*UPDATE MODAL*@
@foreach (var detail in Model.ReservationDetails)
{
    <div class="modal modal-blur fade" id="modal-update" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Edit Reservation</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-action="EditReservationDetails" asp-controller="FunctionRoom" method="post">
                    <input type="hidden" name="ReservationDetailId" value="@detail.ReservationDetailId">
                    <input type="hidden" name="ReservationId" value="@detail.ReservationId">
                    <div class="container container-lg mt-3">
                        <div id="dynamic-rows">
                            <div class="row">
                                <div class="col-lg-12 mb-3">
                                    <div class="row mb-3">
                                        <div class="col-lg-6">
                                            <label class="form-label">Number of Attendees</label>
                                            <input type="number" class="form-control" name="NumberOfGuest" placeholder="Number of Attendees" value="@detail.NumberOfGuest">
                                        </div>
                                        <div class="col-lg-6">
                                            <div>
                                                <label class="form-label">
                                                    Contact Number
                                                </label>
                                                <div class="input-group">
                                                    <span class="input-group-text">
                                                        +63
                                                    </span>
                                                    <input type="text" class="form-control" name="_contactNumber" placeholder="Contact Number" maxlength="10" value="@detail.ContactNumber">
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <label class="form-label">Duration of Stay</label>
                                    <div class="row mb-3">
                                        <div class="col-lg-6">
                                            <label class="form-label">Start Date</label>
                                            @(
                                                Html.Kendo().DateTimePicker()
                                                .Name("_startDate")
                                                .Value(detail.StartDate)
                                                .Min(DateTime.Today)
                                                .DateInput(true)
                                                .Format("yyyy/MM/dd HH:mm:ss.fff")
                                                .ParseFormats(new string[] { "yyyy/MM/dd HH:mm:ss.fff", "yyyy-MM-ddTHH:mm:ss.fffZ" })
                                                .Events(e => e.Open("onDateTimePickerOpen"))
                                                .HtmlAttributes(new { id = "_startDate", onkeydown = "return false;" })
                                                )
                                        </div>
                                        <div class="col-lg-6">
                                            <label class="form-label">End Date</label>
                                            @(
                                                Html.Kendo().DateTimePicker()
                                                .Name("_endDate")
                                                .Value(detail.EndDate)
                                                .Min(DateTime.Today)
                                                .Format("yyyy/MM/dd HH:mm:ss.fff")
                                                .ParseFormats(new string[] { "yyyy/MM/dd HH:mm:ss.fff", "yyyy-MM-ddTHH:mm:ss.fffZ" })
                                                .Events(e => e.Open("onDateTimePickerOpen"))
                                                .HtmlAttributes(new { id = "_endDate", onkeydown = "return false;" })

                                                )
                                        </div>
                                    </div>
                                    @if (activeRole == "GFMS.Requestor" && User.IsInRole("GFMS.Admin Approver"))
                                    {
                                        <div class="col-lg-12">
                                            <label class="form-label">Recurrence</label>
                                            @(Html.Kendo().RecurrenceEditor()
                                                .Name("RecurrenceEditor")
                                                .Value(detail.RecurrenceRule)
                                                )
                                        </div>
                                        <input type="hidden" name="RecurrenceRule" id="RecurrenceRule">
                                    }
                                    <div class="row mb-3">
                                        <div class="col-lg-12">
                                            <label class="form-label">Equipment Needed</label>
                                            @(Html.Kendo().MultiSelect()
                                                .Name("EquipmentNeeded")
                                                .Placeholder("Please select needed equipment/s")
                                                .DownArrow(true)
                                                .NoDataTemplateId("noDataTemplate")
                                                .DataTextField("EquipmentName")
                                                .DataValueField("Id")
                                                .Value(detail.EquipmentNeeded?.Split(new[] { ',' }, StringSplitOptions.RemoveEmptyEntries))
                                                .Filter("contains")
                                                .AutoBind(true)
                                                .DataSource(source =>
                                                {
                                                    source.Read(read =>
                                                    {
                                                        read.Action("GetEquipments", "Global");
                                                    });
                                                })

                                                )

                                            @* <input type="text" class="form-control" name="EquipmentNeeded" placeholder="EquipmentNeeded" value="@detail.EquipmentNeeded"> *@
                                        </div>
                                    </div>
                                    <div class="col-lg-12">
                                        <div>
                                            <label class="form-label">
                                                Purpose
                                                <span id="charCount" class="form-label-description">0/50</span>
                                            </label>
                                            <textarea class="form-control" rows="3" name="_purpose" id="purposeTextarea" maxlength="50">@detail.Purpose</textarea>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer d-flex justify-content-between align-items-center">
                        <a data-bs-dismiss="modal" class="btn btn-link link-secondary">
                            Go Back
                        </a>
                        <div class="ms-auto">
                            @if (Model.ReservationHeader.Status != "CANCELLED" && Model.ReservationHeader.Status != "DISAPPROVED" && Model.ReservationHeader.Status != "APPROVED")
                            {
                                <button type="submit" class="btn btn-primary ms-auto">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M12 5l0 14" /><path d="M5 12l14 0" /></svg>
                                    Update
                                </button>
                            }
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
@*END OF MODAL*@