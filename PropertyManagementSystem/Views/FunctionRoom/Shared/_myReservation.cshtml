
    @(
        Html.Kendo().Grid<PropertyManagementSystem.Models.ReservationViewModel>()
        .Name("reservationGrid2")
        .ToolBar(tools => tools.Excel())
        .Excel(excel => excel
        .FileName("Reservations.xlsx")
        .AllPages(true))
        .Columns(columns =>
        {
            columns.Bound(c => c.ReservationId).Visible(false).Exportable(false);
            columns.Bound(c => c.ReservationDetailId).Visible(false).Exportable(false);
            columns.Bound(c => c.ReservationCode);
            columns.ForeignKey(c => c.ChargeToCompany, ds => ds.Read(r => r.Action("getCompanies", "Global")), "Id", "CompanyCode")
            .Title("Charge To Company")
            .Filterable(ftb => ftb.Cell(cell => cell.ShowOperators(false)));
            columns.Bound(c => c.DepartmentName);
            columns.Bound(c => c.Requestor);
            columns.Bound(c => c.RequestorEmail).Hidden(true);
            columns.Bound(c => c.Status).ClientTemplate(
            "<div class='datagrid-content'>" +
            "# if (Status === 'PENDING' || Status === 'DRAFT') { #" +
            "<span class='status status-blue'><span class='status-dot'></span><strong>#: Status #</strong></span>" +
            "# } else if (Status === \"FOR DEPARTMENT HEAD'S APPROVAL\" || Status === \"FOR ADMIN APPROVER'S APPROVAL\" || Status === \"FOR ADMIN MANAGER'S APPROVAL\" || Status === \"APPROVED\") { #" +
            "<span class='status status-green'><span class='status-dot'></span><strong><strong> #: Status # </strong></strong></span>" +
            "# } else if (Status === 'CANCELLED' || Status === 'DISAPPROVED' || Status === 'DELETED') { #" +
            "<span class='status status-red'><span class='status-dot'></span><strong> #: Status # </strong></span>" +
            "# } else { #" +
            "<span>#: Status #</span>" +
            "# } #" +
            "</div>"
            ).Title("Status").Width(350);
            columns.Command(command =>
            {
                command.Custom("view")
            .Text("<i class='ti ti-eye'></i>View")
            .Click("onViewClickReservationList")
            .HtmlAttributes(new { @class = "k-button k-grid-View k-button-sm k-rounded-md k-button-solid k-button-solid-success" });

                command.Custom("delete")
            .Text("<i class='ti ti-trash'></i>Delete")
            .Click("onDeleteClickReservation")
            .HtmlAttributes(new { @class = "k-button k-grid-Delete", style = "display: none;" });
            })
            .Title("Actions")
            .Width(350)
            .Exportable(false);
        })
        .NoRecords()
        .Pageable()
        .Groupable()
        .Filterable()
        .Scrollable()
        .ToolBar(toolbar =>
        {
            toolbar.Search();
        })
        .DataSource(dataSource => dataSource
        .Ajax()
        .Model(model =>
        {
            model.Id(p => p.ReservationId);
            model.Field(p => p.CanDelete);
            model.Field(p => p.Status);
            model.Field(p => p.GUID);
            model.Field(p => p.ReservationType);
            model.Field(p => p.ReservationDetailId);
        })
        .Read(read => read.Action("getFunctionRoomReservation", "FunctionRoom", new { gridType = "myReservation" }))
        .PageSize(50)
        )
        .Events(events => events.DataBound("onGridDataBound"))
        )


