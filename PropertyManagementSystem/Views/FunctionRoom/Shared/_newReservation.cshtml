@model PropertyManagementSystem.Models.ReservationViewModel
@inject PropertyManagementSystem.Services.IRoleService RoleService
@{
    var employee = await RoleService.GetUserName(User);
    var activeRole = await RoleService.GetActiveRoleAsync(User);
}
@*NEW RESERVATION MODAL *@
<div class="modal modal-blur fade" id="modal-newReservation" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">New Reservation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="fcFRM1" asp-controller="FunctionRoom" asp-action="CreateReservation" method="post">
                <div class="modal-body">
                    <div class="row mb-3">
                        <div class="col-lg-6">
                            <label class="form-label required">Requestor Name</label>
                            <input class="form-control" name="_requestor" type="text" value="@employee.Fullname" readonly>
                        </div>
                        <div class="col-lg-6">
                            <label class="form-label required">Employee Id</label>
                            <input class="form-control"  value="@employee.EmployeeID" readonly>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-lg-12">
                            <label class="form-label required">Requestor Email</label>
                            <input class="form-control" name="_requestorEmail" type="email" value="@employee.Email" readonly>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label required">Charge to Company:</label>
                        @(Html.Kendo().DropDownList()
                            .Name("_company")
                            .DataTextField("Company")
                            .DataValueField("Id")
                            .Value(employee.CompanyId.ToString())
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("getCompanies", "Global");
                                });
                            })
                            .HtmlAttributes(new { style = "width: 100%; font-size: 15px; font-weight: bold; border-color: var(--tblr-muted); opacity: .8;" })
                            .OptionLabel("Select Company")
                            )
                    </div>
                    <div class="mb-3">
                        <label class="form-label required">Charge to Department</label>
                        @(Html.Kendo().DropDownList()
                            .Name("_department")
                            .DataTextField("DepartmentName")
                            .DataValueField("Id")
                            .CascadeFrom("_company")
                            .Value(employee.DepartmentId.ToString())
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("getDepartments", "Global").Data("filterDepartments");
                                }).ServerFiltering(true);
                            })
                            .HtmlAttributes(new { style = "width: 100%; font-size: 15px; font-weight: bold; border-color: var(--tblr-muted); opacity: .8;"})
                            )
                    </div>
                    @if(activeRole == "GFMS.Requestor" && User.IsInRole("GFMS.Admin Approver"))
                    {
                        <div class="mb-3 d-flex justify-content-between align-items-center">
                            <label class="form-label mb-0 required">Free of Charge?</label>
                            <div class="d-flex align-items-center">
                                <span class="me-2 form-label">No</span>
                                <span class="form-check form-check-single form-switch me-5">
                                    <input required class="form-check-input" name="_isFreeOfCharge" type="checkbox" value="true" required/>
                                </span>
                                <span class="ms-2 form-label">Yes</span>
                            </div>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button id="svbtn15" type="submit" class="btn btn btn-success ms-auto">Create</button>
                </div>
            </form>

        </div>
    </div>
</div>
@*END - NEW RESERVATION MODAL *@
