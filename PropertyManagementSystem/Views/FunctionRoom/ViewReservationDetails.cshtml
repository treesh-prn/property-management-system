@model PropertyManagementSystem.Models.ReservationViewModel

@{
    ViewData["Title"] = "View Reservation Details";
}
@inject PropertyManagementSystem.Services.IRoleService RoleService
@inject SignInManager<IdentityUser> SignInManager
@using Microsoft.AspNetCore.Identity

@{
    var employee = await RoleService.GetUserName(User);
    var gfmsRoles = await RoleService.GetRolesAsync(User);
    var activeRole = await RoleService.GetActiveRoleAsync(User);
}
<div class="page-wrapper">
    <!-- Page header -->
    <div class="page-header d-print-none">
        <div class="container-xl">
            <div class="row g-2 align-items-center">
                <div class="col">
                    <!-- Page pre-title -->
                    <div class="page-pretitle">
                        View Reservation
                    </div>
                    <h2 class="page-title">
                        Reservation Details
                    </h2>
                </div>
                <!-- Page title actions -->
                <div class="col-auto ms-auto d-print-none">
                    @* <div class="btn-list">
                    <a href="@Url.Action("Index", "FunctionRoom")" class="btn btn-primary bg-green">
                    <i class="ti ti-arrow-left icon"></i>
                    Go Back
                    </a>
                    </div> *@
                </div>
            </div>
        </div>
    </div>
    <!-- Page body -->
    <div class="page-body">
        <div class="container-xl">
            <div class="row row-cards">
                <div class="col-lg-3">
                    <div class="card text-center">
                        <div class="card-header card-header-light">
                            <h3 class="card-title">@Model.ReservationHeader.ReservationCode</h3>
                            <div class="ms-auto">
                                @if (Model.ReservationHeader.Status == "APPROVED")
                                {
                                    <span class='status status-teal'><span class='status-dot status-dot-animated'></span>@Model.ReservationHeader.Status</span>
                                }
                                else if (Model.ReservationHeader.Status == "FOR DEPARTMENT HEAD'S APPROVAL" || Model.ReservationHeader.Status == "FOR ADMIN APPROVER'S APPROVAL" || Model.ReservationHeader.Status == "FOR ADMIN MANAGER'S APPROVAL")
                                {
                                    <span class='status status-teal'><span class='status-dot status-dot-animated'></span>FOR APPROVAL</span>
                                }
                                else if (Model.ReservationHeader.Status == "CANCELLED" || Model.ReservationHeader.Status == "DISAPPROVED")
                                {
                                    <span class='status status-red'><span class='status-dot status-dot-animated'></span>@Model.ReservationHeader.Status</span>
                                }
                                else
                                {
                                    <span class='status status-blue'><span class='status-dot status-dot-animated'></span>@Model.ReservationHeader.Status</span>
                                }
                            </div>
                        </div>
                        <img class="img-responsive2 mx-auto" src="@Url.Content("~/img/calendar.jpg")" alt="Reservation Image">

                            <h5 class="card-title">Reservation Details</h5>
                            <table class="table table-borderless text-left">
                                <tbody>
                                    <tr>
                                        <th scope="row">Requestor:</th>
                                        <td>@Model.ReservationHeader.Requestor</td>
                                    </tr>
                                    <tr>
                                        <th scope="row">Email:</th>
                                        <td>@Model.ReservationHeader.RequestorEmail</td>
                                    </tr>
                                    <tr>
                                        <th scope="row">Date Filed:</th>
                                        <td>@Model.ReservationHeader.DateFiled</td>
                                    </tr>
                                </tbody>
                            </table>
                    </div>
                </div>
                <div class="col-lg-9">
                    <div class="card">
                        <div class="card-header">
                            <div>
                                <h3 class="card-title">
                                    Facilities Reservation Details
                                </h3>
                            </div>
                            <div class="ms-auto">
                                <h1 class="card-title">
                                    <a href="@Url.Action("ViewReport", "Report", new { reportName = "ReservationReport", reservationId = Model.ReservationHeader.ReservationId })">
                                        <i class="ti ti-printer" style="font-size: 1.4em; color:gray"></i>
                                    </a>
                                </h1>
                            </div>

                        </div>
                        <div class="card-body">
                            <div class="modal-content">
                                @if (Model.ReservationHeader.Requestor == employee.Fullname && Model.ReservationHeader.Status == "DRAFT")
                                {
                                    <partial name="Shared/_draft"/>
                                }
                                @foreach (var detail in Model.ReservationDetails)
                                {
                                    @if (User.IsInRole("GFMS.Requestor"))
                                    {
                                        @if (Model.ReservationHeader.Status == "FOR DEPARTMENT HEAD'S APPROVAL" || Model.ReservationHeader.Status == "FOR ADMIN APPROVER'S APPROVAL")
                                        {
                                            <partial name="Shared/_update" />
                                        }
                                        else
                                        {
                                            <partial name="Shared/_view" />
                                        }
                                    }
                                    else if (User.IsInRole("GFMS.Department Head"))
                                    {
                                        @if (Model.ReservationHeader.Requestor == employee.Fullname)
                                        {
                                            <partial name="Shared/_view" />
                                        }
                                        else if (Model.ReservationHeader.Requestor != employee.Fullname && Model.ReservationHeader.Status == "FOR DEPARTMENT HEAD'S APPROVAL")
                                        {
                                            <partial name="Shared/DepartmentHead/_pending" />
                                        }
                                        else if (Model.ReservationHeader.Approver == employee.Fullname)
                                        {
                                            <partial name="Shared/_view" />
                                        }
                                    }
                                    else if(User.IsInRole("GFMS.Admin Approver"))
                                    {
                                        @if (Model.ReservationHeader.Requestor == employee.Fullname)
                                        {
                                            <partial name="Shared/_view" />
                                        }
                                        else if (Model.ReservationHeader.Requestor != employee.Fullname && Model.ReservationHeader.Status == "FOR ADMIN APPROVER'S APPROVAL")
                                        {
                                            <partial name="Shared/AdminApprover/_pending"/>
                                        }
                                        else if (Model.ReservationHeader.Requestor != employee.Fullname)
                                        {
                                            <partial name="Shared/_view" />
                                        }
                                    }
                                    else if(User.IsInRole("GFMS.Admin Manager"))
                                    {
                                        @if (Model.ReservationHeader.Requestor == employee.Fullname)
                                        {
                                            <partial name="Shared/_view" />
                                        }
                                        else if (Model.ReservationHeader.Requestor != employee.Fullname && Model.ReservationHeader.Status == "FOR ADMIN MANAGER'S APPROVAL")
                                        {
                                            <partial name="Shared/AdminManager/_pending" />
                                        }
                                        else if (Model.ReservationHeader.Requestor != employee.Fullname)
                                        {
                                            <partial name="Shared/_view" />
                                        }
                                    }
                                    else
                                    {
                                        <partial name="Shared/_view" />
                                    }
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
