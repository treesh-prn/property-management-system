@model PropertyManagementSystem.Models.ReservationViewModel

@{
    ViewData["Title"] = "View Reservation Details";
}
<div class="page-wrapper">
    <!-- Page header -->
    <div class="page-header d-print-none">
        <div class="container-xl">
            <div class="row g-2 align-items-center">
                <div class="col">
                    <!-- Page pre-title -->
                    <div class="page-pretitle">
                        View Reservation
                    </div>
                    <h2 class="page-title">
                        Reservation Details
                    </h2>
                </div>
                <!-- Page title actions -->
                <div class="col-auto ms-auto d-print-none">
                    @* <div class="btn-list">
                    <a href="@Url.Action("Index", "FunctionRoom")" class="btn btn-primary bg-green">
                    <i class="ti ti-arrow-left icon"></i>
                    Go Back
                    </a>
                    </div> *@
                </div>
            </div>
        </div>
    </div>
    <!-- Page body -->
    <div class="page-body">
        <div class="container-xl">
            <div class="row row-cards">
                <div class="col-lg-3">
                    <div class="card text-center">
                        <div class="card-header card-header-light">
                            <h3 class="card-title">Reservation #@Model.ReservationHeader.ReservationId</h3>
                        </div>
                        <img class="img-responsive2 mx-auto" src="@Url.Content("~/img/calendar.jpg")" alt="Reservation Image">
                        <div class="card-body">
                            <h5 class="card-title">Reservation Details</h5>
                            <table class="table table-borderless text-left">
                                <tbody>
                                    <tr>
                                        <th scope="row">Requestor</th>
                                        <td>@Model.ReservationHeader.Requestor</td>
                                    </tr>
                                    <tr>
                                        <th scope="row">Email</th>
                                        <td>@Model.ReservationHeader.RequestorEmail</td>
                                    </tr>
                                    <tr>
                                        <th scope="row">Date Filed</th>
                                        <td>@Model.ReservationHeader.DateFiled</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="col-lg-9">
                    <div class="card">
                        <div class="card-header">
                            <div>
                                <h3 class="card-title">
                                    Facilities Reservation Form
                                </h3>
                                <p class="card-subtitle">
                                </p>
                            </div>
                        </div>
                        @foreach (var detail in Model.ReservationDetails)
                        {
                            <div class="card-body">
                                <div class="modal-content">
                                    <form asp-action="EditReservationDetails" method="post">
                                        <input type="hidden" name="ReservationDetailId" value="@detail.ReservationDetailId">
                                        <input type="hidden" name="ReservationId" value="@detail.ReservationId">
                                        <div class="modal-body">
                                            <div id="dynamic-rows">
                                                <div class="row mb-3">
                                                    <div class="col-lg-12">
                                                        <label class="form-label">Number of Attendees</label>
                                                        <input type="number" class="form-control" name="NumberOfGuest" placeholder="Number of Attendees" value="@detail.NumberOfGuest">
                                                    </div>
                                                </div>
                                            </div>

                                            <label class="form-label">Duration of Stay</label>
                                            <div class="row mb-3">
                                                <div class="col-lg-6">
                                                    <label class="form-label required">Start Date</label>
                                                    @(
                                                        Html.Kendo().DateTimePicker()
                                                        .Name("StartDate")
                                                        .Value(detail.StartDate)
                                                        .DateInput(true)
                                                        .Format("yyyy/MM/dd HH:mm:ss.fff")
                                                        .ParseFormats(new string[] { "yyyy/MM/dd HH:mm:ss.fff", "yyyy-MM-ddTHH:mm:ss.fffZ" })
                                                        )
                                                </div>
                                                <div class="col-lg-6">
                                                    <label class="form-label required">End Date</label>
                                                    @(
                                                        Html.Kendo().DateTimePicker()
                                                        .Name("EndDate")
                                                        .Value(detail.EndDate)
                                                        .Format("yyyy/MM/dd HH:mm:ss.fff")
                                                        .ParseFormats(new string[] { "yyyy/MM/dd HH:mm:ss.fff", "yyyy-MM-ddTHH:mm:ss.fffZ" })
                                                        )
                                                </div>
                                            </div>
                                            <div class="row mb-3">
                                                <div class="col-lg-12">
                                                    <label class="form-label">Equipment Needed</label>
                                                    @(Html.Kendo().MultiSelect()
                                                        .Name("EquipmentNeeded")
                                                        .Placeholder("Please select needed equipment/s")
                                                        .DownArrow(true)
                                                        .NoDataTemplateId("noDataTemplate")
                                                        .DataTextField("EquipmentName")
                                                        .DataValueField("EquipmentId")
                                                        .Value(detail.EquipmentNeeded?.Split(new[]{','}, StringSplitOptions.RemoveEmptyEntries))
                                                        .Filter("contains")
                                                        .AutoBind(false)
                                                        .DataSource(source =>
                                                        {
                                                            source.Read(read =>
                                                            {
                                                                read.Action("GetEquipments", "Global");
                                                            });
                                                        })
                                                        )

                                                    @* <input type="text" class="form-control" name="EquipmentNeeded" placeholder="EquipmentNeeded" value="@detail.EquipmentNeeded"> *@
                                                </div>
                                            </div>
                                            <div class="row mb-3">
                                                <div class="col-lg-12">
                                                    <div>
                                                        <label class="form-label">
                                                            Contact Number
                                                        </label>
                                                        <div class="input-group mb-2">
                                                            <span class="input-group-text">
                                                                +63
                                                            </span>
                                                            <input type="text" class="form-control" name="_contactNumber" placeholder="Contact Number" maxlength="10">
                                                        </div>

                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-12">
                                                <div>
                                                    <label class="form-label">
                                                        Purpose
                                                        <span class="form-label-description">26/50</span>
                                                    </label>
                                                    <textarea class="form-control" rows="3" name="Purpose">@detail.Purpose</textarea>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="modal-footer">
                                            <a href="@Url.Action("Index", "FunctionRoom")" class="btn btn-link link-secondary">
                                                Cancel
                                            </a>
                                            <button type="submit" class="btn btn-primary ms-auto">
                                                Update
                                            </button>
                                        </div>
                                    </form>

                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script id="noDataTemplate" type="text/x-kendo-tmpl">
    <div class="kd-nodata-wrapper">
        # var value = instance.input.val(); #
        # var id = instance.element[0].id; #
        <div>
            No data found. Do you want to add new item - '#: value #' ?
        </div>
    </div>
    <br />
    <button class="k-button k-button-solid-base k-button-solid k-button-md k-rounded-md" onclick="addNew('#: id #', '#: value #')" ontouchend="addNew('#: id #', '#: value #')">Add new item</button>
</script>
