@model PropertyManagementSystem.Models.ReservationViewModel;

@{
    ViewData["Title"] = "View Reservation Details";
}
@inject PropertyManagementSystem.Services.IRoleService RoleService
@inject SignInManager<ApplicationUser> SignInManager
@using Microsoft.AspNetCore.Identity

@{
    var employee = await RoleService.GetUserName(User);
    var gfmsRoles = await RoleService.GetRolesAsync(User);
    var employeeName = employee?.Fullname ?? string.Empty;
    var identityEmail = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
        ?? User.FindFirst("email")?.Value
        ?? User.Identity?.Name;
    var isOwner = PropertyManagementSystem.Services.ReservationOwnership.IsOwner(
        Model.ReservationHeader,
        identityEmail,
        employee?.Email);
}
<div class="page-wrapper reservation-page reservation-detail-page unified-detail-view requestor-detail-view function-room-detail-view">
    <div class="col-lg-6 ms-auto alert alert-warning alert-dismissible fade show custom-alert" role="alert"
         style="display:@(TempData["AlertMessage"] != null ? "block" : "none");">
        <div class="d-flex">
            <div>
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon alert-icon">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                    <circle cx="12" cy="12" r="9" />
                    <line x1="12" y1="8" x2="12" y2="12" />
                    <line x1="12" y1="16" x2="12.01" y2="16" />
                </svg>
            </div>
            <div>
                <h4 class="alert-title">@TempData["AlertType"]</h4>
                <div class="text-secondary">
                    @if (TempData["AlertMessage"] != null)
                    {
                        <strong>@TempData["AlertMessage"]</strong>
                        <br />
                        @TempData["AlertSubMessage"]
                    }
                </div>
            </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>


    <!-- Page header -->
    <div class="page-header d-print-none">
        <div class="container-xl">
            <div class="row g-2 align-items-center">
                <div class="col">
                    <!-- Page pre-title -->
                    <div class="page-pretitle">View Reservation</div>
                    <h2 class="page-title">
                       Facilities Reservation
                    </h2>
                    <div class="text-secondary mt-1">Review room booking details, schedule, approval status, and available actions.</div>

                </div>
                <!-- Page title actions -->
            </div>
        </div>
    </div>
    <div class="container-xl">
        <div class="reservation-detail-hero reservation-detail-hero-with-actions">
            <div class="reservation-detail-hero-copy">
                <span class="reservation-eyebrow">Booking overview</span>
                <h3>@Model.ReservationHeader.ReservationCode</h3>
                <p>Function room request details, approval status, schedule, and assigned room information.</p>
            </div>
            @if (isOwner && (Model.ReservationHeader.Status == "FOR DEPARTMENT HEAD'S APPROVAL" || Model.ReservationHeader.Status == "FOR RESCHEDULING"))
            {
                <div class="reservation-detail-edit-action"><a class="btn btn-primary btn-sm" asp-action="EditReservation" asp-route-id="@Model.ReservationHeader.GUID"><i class="ti ti-pencil" aria-hidden="true"></i> Edit Reservation</a></div>
            }
            <div class="reservation-detail-hero-meta">
                <div>
                    <span>Date Filed</span>
                    <strong>@(Model.ReservationHeader.DateFiled?.ToString("MMM d, yyyy h:mm tt") ?? "Not available")</strong>
                </div>
                <div>
                    <span>Requestor</span>
                    <strong>@Model.ReservationHeader.Requestor</strong>
                </div>
            </div>
        </div>
    </div>
    <!-- Page body -->
    <div class="page-body">
        <div class="container-xl">
            <div class="reservation-detail-workspace @(isOwner && Model.ReservationHeader.Status != "DRAFT" ? "has-status-sidebar" : string.Empty)">
                @if (isOwner && Model.ReservationHeader.Status != "DRAFT")
                {
                    <aside class="request-status-sidebar" aria-label="Request approval status">
                        <partial name="~/Views/Shared/_RequestStatus.cshtml" model="Model" />
                    </aside>
                }
                <main class="reservation-detail-main">
                <div class="row row-cards">
               
                <div class="col-lg-12">
                    <div class="card reservation-form-card">
                       
                        @if (isOwner)
                        {
                            @if (Model.ReservationHeader.Status == "FOR DEPARTMENT HEAD'S APPROVAL" ||
                                 Model.ReservationHeader.Status == "FOR RESCHEDULING")
                            {
                                <partial name="Shared/_update" />
                            }
                            else if (Model.ReservationHeader.Status == "DRAFT")
                            {
                                <partial name="Shared/_draft" />
                            }
                            else
                            {
                                <partial name="Shared/_view" />
                            }
                        }
                        else if (Model.ReservationHeader.Status == "FOR DEPARTMENT HEAD'S APPROVAL" &&
                                 gfmsRoles.Contains("GFMS.Department Head"))
                        {
                            <partial name="Shared/DepartmentHead/_pending" />
                        }
                        else if ((Model.ReservationHeader.Status == "FOR ADMIN APPROVER'S APPROVAL" || Model.ReservationHeader.Status == "FOR ADMIN MANAGER'S APPROVAL") &&
                                 gfmsRoles.Contains("GFMS.Admin Approver"))
                        {
                            <partial name="Shared/AdminApprover/_pending" />
                        }
                        else
                        {
                            <partial name="Shared/_view" />
                        }
                    </div>
                </div>
            </div>
                </main>
            </div>
        </div>
    </div>
</div>
