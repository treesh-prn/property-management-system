@{
    ViewData["Title"] = "Home Page";

}
<div class="page-wrapper">
    <!-- Page header -->
    <div class="page-header d-print-none">
        <div class="container-xl">
            <div class="row g-2 align-items-center">
                <div class="col">
                    <!-- Page pre-title -->
                    <div class="page-pretitle">
                        Reservation
                    </div>
                    <h2 class="page-title">
                        FUNCTION ROOM
                    </h2>
                </div>
                <!-- Page title actions -->
                <div class="col-auto ms-auto d-print-none">
                    <div class="btn-list">
                        @*   <span class="d-none d-sm-inline">
                        <a href="#" class="btn">
                        New view
                        </a>
                        </span>
                        <a href="#" class="btn btn-primary d-none d-sm-inline-block" data-bs-toggle="modal" data-bs-target="#modal-report">
                        <!-- Download SVG icon from http://tabler-icons.io/i/plus -->
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M12 5l0 14" /><path d="M5 12l14 0" /></svg>
                        Create new report
                        </a>
                        <a href="#" class="btn btn-primary d-sm-none btn-icon" data-bs-toggle="modal" data-bs-target="#modal-report" aria-label="Create new report">
                        <!-- Download SVG icon from http://tabler-icons.io/i/plus -->
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M12 5l0 14" /><path d="M5 12l14 0" /></svg>
                        </a> *@
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Page body -->
    <div class="page-body">
        <div class="container-xl">
            <div class="row row-deck row-cards">
                <div class="col-lg-12 col-md-12">
                    <div class="card">
                        <div class="card-header">
                            <ul class="nav nav-tabs card-header-tabs">
                                <li class="nav-item">
                                    <a class="nav-link active" data-bs-toggle="tab" href="#myReservation">
                                        My Reservation
                                    </a>
                                </li>
                                @if (User.IsInRole("GFMS.Department Head") || User.IsInRole("GFMS.Requestor"))
                                {
                                    <li class="nav-item">
                                        <a class="nav-link" data-bs-toggle="tab" href="#reservationApproval">
                                            Reservation Requests
                                        </a>
                                    </li>
                                }
                            </ul>
                            <h3 class="card-title"></h3>
                            <div class="card-actions">
                            </div>
                        </div>
                        <div class="card-body p-0 tab-content">
                            <div id="myReservation" class="tab-pane active">
                                @(
                                    Html.Kendo().Grid<PropertyManagementSystem.Models.ReservationViewModel>()
                                    .Name("reservationGrid2")
                                    .ToolBar(tools => tools.Excel())
                                    .Excel(excel => excel
                                    .FileName("Reservations.xlsx")
                                    .AllPages(true))
                                    .Columns(columns =>
                                    {
                                        columns.Bound(c => c.ReservationId).Visible(false).Exportable(false);
                                        columns.Bound(c => c.ReservationDetailId).Visible(false).Exportable(false);
                                        columns.ForeignKey(c => c.ChargeToCompany, ds => ds.Read(r => r.Action("getCompanies", "Global")), "Id", "Company").Width(250).Title("Charge To Company").Filterable(ftb => ftb.Cell(cell => cell.ShowOperators(false)));
                                        columns.Bound(c => c.DepartmentName).Width(650);
                                        columns.Bound(c => c.Requestor).Width(150);
                                        columns.Bound(c => c.RequestorEmail).Hidden(true);
                                        columns.Bound(c => c.Status).ClientTemplate(
                                        "<div class='datagrid-content'>" +
                                        "# if (Status === 'PENDING' || Status === 'DRAFT') { #" +
                                        "<span class='status status-blue'><span class='status-dot'></span><strong>#: Status #</strong></span>" +
                                        "# } else if (Status === 'FOR APPROVAL') { #" +
                                        "<span class='status status-green'><span class='status-dot'></span><strong>#: Status #</strong></span>" +
                                        "# } else if (Status === 'CANCELLED') { #" +
                                        "<span class='status status-red'><span class='status-dot'></span>#: Status #</span>" +
                                        "# } else { #" +
                                        "<span>#: Status #</span>" +
                                        "# } #" +
                                        "</div>"
                                        ).Title("Status");
                                        columns.Command(command =>
                                        {
                                            command.Custom("view")
                                        .Text("<i class='ti ti-eye'></i>View")
                                        .Click("onViewClickReservationList")
                                        .HtmlAttributes(new { @class = "k-button k-grid-View k-button-sm k-rounded-md k-button-solid k-button-solid-success" });

                                            command.Custom("delete")
                                        .Text("<i class='ti ti-x'></i> Cancel")
                                        .Click("onDeleteClick")
                                        .HtmlAttributes(new { @class = "k-button k-grid-delete k-button-sm k-rounded-md k-button-solid k-button-solid-danger delete-button" });
                                        })
                                        .Title("Actions")
                                        .Exportable(false);

                                    })
                                    .Scrollable()
                                    .ToolBar(toolbar =>
                                    {
                                        toolbar.Search();
                                    })
                                    .DataSource(dataSource => dataSource
                                    .Ajax()
                                    .Model(model =>
                                    {
                                        model.Id(p => p.ReservationId);
                                        model.Field(p => p.GUID);
                                        model.Field(p => p.ReservationType);
                                        model.Field(p => p.ReservationDetailId);
                                    })
                                    .Read(read => read.Action("getFunctionRoomReservation", "FunctionRoom"))
                                    .PageSize(50)
                                    )
                                    )
                            </div>
                            <div id="reservationApproval" class="tab-pane fade">
                                @(
                                    Html.Kendo().Grid<PropertyManagementSystem.Models.ReservationViewModel>()
                                    .Name("reservationGrid")
                                    .ToolBar(tools => tools.Excel())
                                    .Excel(excel => excel
                                    .FileName("Reservations.xlsx")
                                    .AllPages(true))
                                    .Columns(columns =>
                                    {
                                        columns.Bound(c => c.ReservationId).Visible(false).Exportable(false);
                                        columns.Bound(c => c.ReservationDetailId).Visible(false).Exportable(false);
                                        columns.ForeignKey(c => c.ChargeToCompany, ds => ds.Read(r => r.Action("getCompanies", "Global")), "Id", "Company").Width(250).Title("Charge To Company").Filterable(ftb => ftb.Cell(cell => cell.ShowOperators(false)));
                                        columns.Bound(c => c.DepartmentName).Width(650);
                                        columns.Bound(c => c.Requestor).Width(150);
                                        columns.Bound(c => c.RequestorEmail).Hidden(true);
                                        columns.Bound(c => c.Status).ClientTemplate(
                                        "<div class='datagrid-content'>" +
                                        "# if (Status === 'PENDING' || Status === 'DRAFT') { #" +
                                        "<span class='status status-blue'><span class='status-dot'></span><strong>#: Status #</strong></span>" +
                                        "# } else if (Status === 'FOR APPROVAL') { #" +
                                        "<span class='status status-green'><span class='status-dot'></span><strong>#: Status #</strong></span>" +
                                        "# } else if (Status === 'CANCELLED') { #" +
                                        "<span class='status status-red'><span class='status-dot'></span>#: Status #</span>" +
                                        "# } else { #" +
                                        "<span>#: Status #</span>" +
                                        "# } #" +
                                        "</div>"
                                        ).Title("Status");
                                        columns.Command(command =>
                                        {
                                            command.Custom("view")
                                        .Text("<i class='ti ti-eye'></i>View")
                                        .Click("onViewClickReservationList")
                                        .HtmlAttributes(new { @class = "k-button k-grid-View k-button-sm k-rounded-md k-button-solid k-button-solid-success" });

                                            command.Custom("delete")
                                        .Text("<i class='ti ti-x'></i> Cancel")
                                        .Click("onDeleteClick")
                                        .HtmlAttributes(new { @class = "k-button k-grid-delete k-button-sm k-rounded-md k-button-solid k-button-solid-danger delete-button" });
                                        })
                                        .Title("Actions")
                                        .Exportable(false);

                                    })
                                    .Scrollable()
                                    .ToolBar(toolbar =>
                                    {
                                        toolbar.Search();
                                    })
                                    .DataSource(dataSource => dataSource
                                    .Ajax()
                                    .Model(model =>
                                    {
                                        model.Id(p => p.ReservationId);
                                        model.Field(p => p.GUID);
                                        model.Field(p => p.ReservationType);
                                        model.Field(p => p.ReservationDetailId);
                                    })
                                    .Read(read => read.Action("getFunctionRoomReservation", "FunctionRoom"))
                                    .PageSize(50)
                                    )
                                    )
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>
@*DELETE MODAL*@
<div class="modal modal-blur fade" id="modal-danger" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered" role="document">
        <div class="modal-content">
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            <div class="modal-status bg-danger"></div>
            <div class="modal-body text-center py-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="icon mb-2 text-danger icon-lg" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M12 9v4" /><path d="M10.363 3.591l-8.106 13.534a1.914 1.914 0 0 0 1.636 2.871h16.214a1.914 1.914 0 0 0 1.636 -2.87l-8.106 -13.536a1.914 1.914 0 0 0 -3.274 0z" /><path d="M12 16h.01" /></svg>
                <h3>Are you sure?</h3>
                <div class="text-secondary">Do you really want to remove this record? This action cannot be undone.</div>
            </div>
            <form id="delete-form" action="@Url.Action("DeleteReservationDetails", "Dorm")" method="post">
                <div class="modal-footer">
                    <div class="w-100">
                        <div class="row">
                            <div class="col">
                                <a href="#" class="btn w-100" data-bs-dismiss="modal">
                                    Cancel
                                </a>
                            </div>
                            <div class="col">
                                <button type="submit" class="btn btn-danger w-100" id="confirm-delete">
                                    Delete
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                <input type="hidden" name="ReservationId" id="modal-reservation-id" />
            </form>
        </div>
    </div>
</div>
@*END DELETE MODAL*@
