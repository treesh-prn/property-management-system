
@{
    ViewData["Title"] = "Home Page";

}
<div class="page-wrapper">
    <!-- Page header -->
    <div class="page-header d-print-none">
        <div class="container-xl">
            <div class="row g-2 align-items-center">
                <div class="col">
                    <!-- Page pre-title -->
                    <div class="page-pretitle">
                        Reservation
                    </div>
                    <h2 class="page-title">
                        FUNCTION ROOM
                    </h2>
                </div>
                <!-- Page title actions -->
                <div class="col-auto ms-auto d-print-none">
                    <div class="btn-list">
                        <a href="#" class="btn btn-primary d-none d-sm-inline-block" data-bs-toggle="modal" data-bs-target="#modal-newReservation">
                            <i class="ti ti-plus"></i>
                            Create New Reservation
                        </a>

                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Page body -->
    <div class="page-body">
        <div class="container-xl">
            <div class="row row-deck row-cards">
                <div class="col-lg-12 col-md-12">
                    <div class="card">
                        <div class="card-header">
                            <ul class="nav nav-tabs card-header-tabs">
                                <li class="nav-item">
                                    <a class="nav-link active" data-bs-toggle="tab" href="#myReservation">
                                        My Reservation
                                    </a>
                                </li>
                                @if (User.IsInRole("GFMS.Department Head") || User.IsInRole("GFMS.Admin Approver") || User.IsInRole("GFMS.Admin Manager"))
                                {
                                    <li class="nav-item">
                                        <a class="nav-link" data-bs-toggle="tab" href="#reservationApproval">
                                            Reservation Requests
                                        </a>
                                    </li>
                                }
                            </ul>
                            <h3 class="card-title"></h3>
                            <div class="card-actions">
                            </div>
                        </div>
                        <div class="card-body p-0 tab-content">
                            <div id="myReservation" class="tab-pane active">
                                @(
                                    Html.Kendo().Grid<PropertyManagementSystem.Models.ReservationViewModel>()
                                    .Name("reservationGrid2")
                                    .ToolBar(tools => tools.Excel())
                                    .Excel(excel => excel
                                    .FileName("Reservations.xlsx")
                                    .AllPages(true))
                                    .Columns(columns =>
                                    {
                                        columns.Bound(c => c.ReservationId).Visible(false).Exportable(false);
                                        columns.Bound(c => c.ReservationDetailId).Visible(false).Exportable(false);
                                        columns.ForeignKey(c => c.ChargeToCompany, ds => ds.Read(r => r.Action("getCompanies", "Global")), "Id", "Company").Title("Charge To Company").Filterable(ftb => ftb.Cell(cell => cell.ShowOperators(false)));
                                        columns.Bound(c => c.DepartmentName);
                                        columns.Bound(c => c.Requestor);
                                        columns.Bound(c => c.RequestorEmail).Hidden(true);
                                        columns.Bound(c => c.Status).ClientTemplate(
                                        "<div class='datagrid-content'>" +
                                        "# if (Status === 'PENDING' || Status === 'DRAFT') { #" +
                                        "<span class='status status-blue'><span class='status-dot'></span><strong>#: Status #</strong></span>" +
                                        "# } else if (Status === \"FOR DEPARTMENT HEAD'S APPROVAL\" || Status === \"FOR ADMIN APPROVER'S APPROVAL\" || Status === \"FOR ADMIN MANAGER'S APPROVAL\" || Status === \"APPROVED\") { #" +
                                        "<span class='status status-green'><span class='status-dot'></span><strong><strong> #: Status # </strong></strong></span>" +
                                        "# } else if (Status === 'CANCELLED' || Status === 'DISAPPROVED') { #" +
                                        "<span class='status status-red'><span class='status-dot'></span><strong> #: Status # </strong></span>" +
                                        "# } else { #" +
                                        "<span>#: Status #</span>" +
                                        "# } #" +
                                        "</div>"
                                        ).Title("Status").Width(350);
                                        columns.Command(command =>
                                        {
                                            command.Custom("view")
                                        .Text("<i class='ti ti-eye'></i>View")
                                        .Click("onViewClickReservationList")
                                        .HtmlAttributes(new { @class = "k-button k-grid-View k-button-sm k-rounded-md k-button-solid k-button-solid-success", style = "width: 250px;" });
                                        })
                                        .Title("Actions")
                                        .Width(300)
                                        .Exportable(false);

                                    })
                                    .NoRecords()
                                    .Groupable()
                                    .Filterable()
                                    .Scrollable()
                                    .ToolBar(toolbar =>
                                    {
                                        toolbar.Search();
                                    })
                                    .DataSource(dataSource => dataSource
                                    .Ajax()
                                    .Model(model =>
                                    {
                                        model.Id(p => p.ReservationId);
                                        model.Field(p => p.GUID);
                                        model.Field(p => p.ReservationType);
                                        model.Field(p => p.ReservationDetailId);
                                    })
                                    .Read(read => read.Action("getFunctionRoomReservation", "FunctionRoom", new { gridType = "myReservation" }))
                                    .PageSize(50)
                                    )
                                    )
                            </div>
                            <div id="reservationApproval" class="tab-pane fade">
                                @(
                                    Html.Kendo().Grid<PropertyManagementSystem.Models.ReservationViewModel>()
                                    .Name("reservationGrid")
                                    .ToolBar(tools => tools.Excel())
                                    .Excel(excel => excel
                                    .FileName("Reservations.xlsx")
                                    .AllPages(true))
                                    .Columns(columns =>
                                    {
                                        columns.Bound(c => c.ReservationId).Visible(false).Exportable(false);
                                        columns.Bound(c => c.ReservationDetailId).Visible(false).Exportable(false);
                                        columns.ForeignKey(c => c.ChargeToCompany, ds => ds.Read(r => r.Action("getCompanies", "Global")), "Id", "Company").Title("Charge To Company").Filterable(ftb => ftb.Cell(cell => cell.ShowOperators(false)));
                                        columns.Bound(c => c.DepartmentName);
                                        columns.Bound(c => c.Requestor);
                                        columns.Bound(c => c.RequestorEmail).Hidden(true);
                                        columns.Bound(c => c.Status).ClientTemplate(
                                        "<div class='datagrid-content'>" +
                                        "# if (Status === 'PENDING' || Status === 'DRAFT') { #" +
                                        "<span class='status status-blue'><span class='status-dot'></span><strong>#: Status #</strong></span>" +
                                        "# } else if (Status === \"FOR DEPARTMENT HEAD'S APPROVAL\" || Status === \"FOR ADMIN APPROVER'S APPROVAL\" || Status === \"FOR ADMIN MANAGER'S APPROVAL\" || Status === \"APPROVED\") { #" +
                                        "<span class='status status-green'><span class='status-dot'></span><strong>#: Status #</strong></span>" +
                                        "# } else if (Status === 'CANCELLED' || Status === 'DISAPPROVED') { #" +
                                        "<span class='status status-red'><span class='status-dot'></span><strong> #: Status # </strong></span>" +
                                        "# } else { #" +
                                        "<span>#: Status #</span>" +
                                        "# } #" +
                                        "</div>"
                                        ).Title("Status").Width(350);
                                        columns.Command(command =>
                                        {
                                            command.Custom("view")
                                        .Text("<i class='ti ti-eye'></i>View")
                                        .Click("onViewClickReservationList")
                                        .HtmlAttributes(new { @class = "k-button k-grid-View k-button-sm k-rounded-md k-button-solid k-button-solid-success width", style = "width: 250px;" });
                                        })
                                        .Width(300)
                                        .Title("Actions")
                                        .Exportable(false);

                                    })
                                    .NoRecords()
                                    .Filterable()
                                    .Groupable()
                                    .Scrollable()
                                    .ToolBar(toolbar =>
                                    {
                                        toolbar.Search();
                                    })
                                    .DataSource(dataSource => dataSource
                                    .Ajax()
                                    .Model(model =>
                                    {
                                        model.Id(p => p.ReservationId);
                                        model.Field(p => p.GUID);
                                        model.Field(p => p.ReservationType);
                                        model.Field(p => p.ReservationDetailId);
                                    })
                                    .Read(read => read.Action("getFunctionRoomReservation", "FunctionRoom", new { gridType = "reservationApproval" }))
                                    .PageSize(50)
                                    )
                                    )
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<partial name="Shared/_newReservation" />