@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
    Layout = "_Layout";
}


<main class="page-wrapper">
    <div class="page-body">
        <div class="container-tight py-5">
            <div class="request-empty-state" role="alert">
                <span class="request-empty-icon" aria-hidden="true"><i class="ti ti-alert-circle"></i></span>
                <h1>We could not complete that request</h1>
                <p>Something unexpected happened. Return home and try the action again.</p>
                @if (Model?.ShowRequestId == true)
                {
                    <p class="request-reference">Reference: <code>@Model.RequestId</code></p>
                }
                <a asp-action="Index" asp-controller="Home" class="btn btn-primary">
                    <i class="ti ti-home" aria-hidden="true"></i> Return Home
                </a>
            </div>
        </div>
    </div>
</main>
