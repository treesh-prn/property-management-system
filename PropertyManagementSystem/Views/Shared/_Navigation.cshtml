@inject PropertyManagementSystem.Services.IRoleService RoleService
@inject SignInManager<ApplicationUser> SignInManager
@using Microsoft.AspNetCore.Identity

@{
    var employee = await RoleService.GetUserName(User);
    var gfmsRoles = await RoleService.GetRolesAsync(User);
    var activeRole = await RoleService.GetActiveRoleAsync(User);
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var account = isAuthenticated && string.IsNullOrWhiteSpace(employee?.Fullname)
        ? await UserManager.GetUserAsync(User)
        : null;
    var displayName = !string.IsNullOrWhiteSpace(employee?.Fullname)
        ? employee.Fullname.Trim()
        : account?.UserName ?? User.Identity?.Name ?? "User";
    var nameParts = displayName.Split('@')[0]
        .Split(new[] { ' ', '.', '_', '-' }, StringSplitOptions.RemoveEmptyEntries);
    var initials = nameParts.Length > 1
        ? $"{nameParts[0][0]}{nameParts[^1][0]}".ToUpperInvariant()
        : nameParts.Length == 1
            ? nameParts[0][..Math.Min(2, nameParts[0].Length)].ToUpperInvariant()
            : "U";
    var isRequestor = activeRole == "GFMS.Requestor";
    var canAccessAdminModules = activeRole == "GFMS.System Admin"
        || activeRole == "GFMS.Admin Approver"
        || activeRole == "GFMS.Admin Manager";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var displayRole = string.IsNullOrWhiteSpace(activeRole)
        ? "No role assigned"
        : activeRole.Replace("GFMS.", string.Empty);
}
<div class="mb-3">
    <header class="navbar navbar-expand-md d-print-none" data-bs-theme="dark">
        <div class="container-xl">
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbar-menu" aria-controls="navbar-menu" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <p class="navbar-brand navbar-brand-autodark d-none-navbar-horizontal pe-0 pe-md-3 mt-1 small">
                <a href="@Url.Action("Index", "Home")" aria-label="Property Management System home">
                    <img src="@Url.Content("~/img/Logo.png")" width="110" height="32" alt="TECO" class="navbar-brand-image">
                </a><small>Property Management System</small>
            </p>
            <div class="navbar-nav flex-row order-md-last">
                <div class="d-none d-md-flex">
                </div>
                @if (isAuthenticated)
                {
                    <div class="nav-item dropdown">
                        <a href="#" class="nav-link d-flex lh-1 text-reset p-0" data-bs-toggle="dropdown" aria-label="Open user menu">
                            <span class="avatar me-3" aria-hidden="true">
                                <span class="badge bg-success"></span>@initials
                            </span>
                            <div class="d-none d-xl-block ps-2">
                                <div>@displayName</div>
                                <div class="mt-1 small text-white">@displayRole</div>
                            </div>
                        </a>
                        <div class="dropdown-menu dropdown-menu-end dropdown-menu-arrow">
                            <div class="hr-text my-3">Active role</div>
                            @foreach (var role in gfmsRoles)
                            {
                                <a class="dropdown-item @(role == activeRole ? "text-danger active-role fw-semibold" : "")"
                                   asp-controller="Home" asp-action="ChangeRole" asp-route-role="@role">
                                    @role
                                </a>
                            }
                            <div class="dropdown-divider"></div>
                            <a asp-area="Identity" asp-page="/Account/Manage/Index" class="dropdown-item">
                                <i class="ti ti-user me-2" aria-hidden="true"></i>My Profile
                            </a>
                            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout"
                                  asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                                <button type="submit" class="dropdown-item">
                                    <i class="ti ti-logout me-2" aria-hidden="true"></i>Sign Out
                                </button>
                            </form>
                        </div>
                    </div>
                }
                else
                {
                    <partial name="_LoginPartial" />
                }
            </div>
        </div>
    </header>
    <header class="navbar-expand-md">
        <div class="collapse navbar-collapse" id="navbar-menu">
            <div class="navbar">
                <div class="container-xl">
                    <div class="row flex-fill align-items-center">
                        <div class="col">
                            <ul class="navbar-nav">
                                <li class="nav-item @(currentController == "Home" ? "active" : "")">
                                    <a class="nav-link" href="@Url.Action("Index", "Home")" aria-current="@(currentController == "Home" ? "page" : null)">
                                        <span class="nav-link-icon d-md-none d-lg-inline-block">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                                <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                                                <path d="M5 12l-2 0l9 -9l9 9l-2 0"></path>
                                                <path d="M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-7"></path>
                                                <path d="M9 21v-6a2 2 0 0 1 2 -2h2a2 2 0 0 1 2 2v6"></path>
                                            </svg>
                                        </span>
                                        <span class="nav-link-title">
                                            <strong>Home</strong>
                                        </span>
                                    </a>
                                </li>
                                <li class="nav-item @(currentController == "FunctionRoom" ? "active" : "")">
                                    <a class="nav-link" href="@(isRequestor ? Url.Action("ReservationList", "FunctionRoom") : Url.Action("Index", "FunctionRoom"))" aria-current="@(currentController == "FunctionRoom" ? "page" : null)">
                                        <span class="nav-link-icon d-md-none d-lg-inline-block">
                                            <i class="ti ti-briefcase icon"></i>
                                        </span>
                                        <span class="nav-link-title">
                                            <strong>Facility Reservation</strong>
                                        </span>
                                    </a>
                                </li>
                                <li class="nav-item @(currentController == "Accommodation" ? "active" : "")">
                                    <a class="nav-link" href="@(isRequestor ? Url.Action("ReservationList", "Accommodation") : Url.Action("Index", "Accommodation"))" aria-current="@(currentController == "Accommodation" ? "page" : null)">
                                        <span class="nav-link-icon d-md-none d-lg-inline-block">
                                            <i class="ti ti-door icon"></i>
                                        </span>
                                        <span class="nav-link-title">
                                            <strong>Guesthouse</strong>
                                        </span>
                                    </a>
                                </li>
                                <li class="nav-item @(currentController == "Dorm" ? "active" : "")">
                                    @if (isRequestor && !DormHousingApplicationFeature.IsEnabled)
                                    {
                                        <span class="nav-link disabled opacity-50" aria-disabled="true" title="Dorm and Housing applications are coming soon">
                                            <span class="nav-link-icon d-md-none d-lg-inline-block">
                                                <i class="ti ti-lock icon"></i>
                                            </span>
                                            <span class="nav-link-title">
                                                <strong>My Housing</strong>
                                                <small class="ms-1">Coming soon</small>
                                            </span>
                                        </span>
                                    }
                                    else
                                    {
                                        <a class="nav-link" href="@Url.Action("Index", "Dorm")" aria-current="@(currentController == "Dorm" ? "page" : null)">
                                            <span class="nav-link-icon d-md-none d-lg-inline-block">
                                                <i class="ti ti-bed icon"></i>
                                            </span>
                                            <span class="nav-link-title">
                                                <strong>@(isRequestor ? "My Housing" : "Dorm & Housing")</strong>
                                            </span>
                                        </a>
                                    }
                                </li>
                                @if (canAccessAdminModules)
                                {
                                    <li class="nav-item dropdown">
                                        <a class="nav-link dropdown-toggle" href="#navbar-third" data-bs-toggle="dropdown" data-bs-auto-close="outside" role="button" aria-expanded="false">
                                            <span class="nav-link-icon d-md-none d-lg-inline-block">
                                                <i class="ti ti-settings icon"></i>
                                            </span>
                                            <span class="nav-link-title">
                                                <strong>Setup </strong>
                                            </span>
                                        </a>
                                        <div class="dropdown-menu" id="maintenance">
                                            <a class="dropdown-item" href="@Url.Action("Index", "Facility")">
                                                <strong>Facilities</strong>
                                            </a>
                                            <a class="dropdown-item" href="@Url.Action("GuestRoom", "Room")">
                                                <strong>Guest Room</strong>
                                            </a>
                                            <a class="dropdown-item" href="@Url.Action("FunctionRoom", "Room")">
                                                <strong>Function Room</strong>
                                            </a>
                                            <a class="dropdown-item" href="@Url.Action("DormRoom", "Room")">
                                                <strong>Dorm Room</strong>
                                            </a>
                                            <a class="dropdown-item" href="@Url.Action("Index", "Equipment")">
                                                <strong>Equipments</strong>
                                            </a>
                                        </div>
                                    </li>
                                    <li class="nav-item dropdown">
                                        <a class="nav-link dropdown-toggle" href="#navbar-third" data-bs-toggle="dropdown" data-bs-auto-close="outside" role="button" aria-expanded="false">
                                            <span class="nav-link-icon d-md-none d-lg-inline-block">
                                                <i class="ti ti-article icon"></i>
                                            </span>
                                            <span class="nav-link-title">
                                                <strong>Reports</strong>
                                            </span>
                                        </a>
                                        <div class="dropdown-menu" id="maintenance">
                                            <a class="dropdown-item" href="@Url.Action("MonthlyChargesReport", "Report")">
                                                <strong>Company & Department Charges</strong>
                                            </a>
                                            <a class="dropdown-item" href="@Url.Action("Index", "Report")">
                                                <strong>Reservation Occupancy</strong>
                                            </a>
                                        </div>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </header>
</div>
