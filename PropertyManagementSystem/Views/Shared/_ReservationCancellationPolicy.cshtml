<div class="modal modal-blur fade reservation-policy-modal" id="reservationCancellationPolicy" tabindex="-1" aria-labelledby="reservationPolicyTitle" aria-describedby="reservationPolicyDescription" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <div class="reservation-policy-heading">
                    <span class="reservation-policy-icon"><i class="ti ti-alert-triangle" aria-hidden="true"></i></span>
                    <div><div class="page-pretitle">Before you submit</div><h2 class="modal-title" id="reservationPolicyTitle">Cancellation Policy Notice</h2></div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="reservation-policy-notice" id="reservationPolicyDescription">Reservations that are not cancelled at least <strong>one hour before the scheduled start</strong> will be <strong>charged to the department</strong>.</div>
                <p class="text-secondary mb-0 mt-3">Do you want to proceed with your reservation submission?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-link link-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" data-confirm-reservation-policy>Confirm &amp; Submit</button>
            </div>
        </div>
    </div>
</div>
