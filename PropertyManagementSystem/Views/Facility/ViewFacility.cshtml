@model PropertyManagementSystem.Models.GFMS_Facility;

@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
@{
    ViewData["Title"] = "Facility Details";
    var linkedEquipment = ((IReadOnlyList<PropertyManagementSystem.Models.FacilityEquipmentLinkOption>)(ViewBag.EquipmentLinkOptions
        ?? new List<PropertyManagementSystem.Models.FacilityEquipmentLinkOption>()))
        .Where(option => option.Selected)
        .ToList();
}
<div class="page-wrapper management-page management-detail-page">
    <!-- Page header -->
    <div class="page-header d-print-none">
        <div class="container-xl">
            <div class="row g-2 align-items-center">
                <div class="col">
                    <!-- Page pre-title -->
                    <div class="page-pretitle">
                        View Facility
                    </div>
                    <h2 class="page-title">
                        Facility Details
                    </h2>
                    <div class="text-secondary mt-1">Review facility classification, location, and operating status.</div>
                </div>
            </div>
        </div>
    </div>
    <!-- Page body -->
    <div class="page-body">
        <div class="container-xl">
            <div class="row row-cards management-detail-layout">
                <div class="col-lg-3">
                    <div class="card management-media-card">
                        <div class="card-header card-header-light">
                            <h3 class="card-title">@Model.FacilityName</h3>
                        </div>
                        @*<div class="img-responsive img-responsive-16x9 card-img-top" style="background-image: url(/img/guest-room.jpg)"></div>*@
                        <img class="img-responsive2" src="@Url.Content("~/img/facility-room.jpg")" alt="@Model.FacilityName facility preview">
                        @*<div class="card-body p-0">
                        Lorem Ipsum Dolor Sit Amet
                        </div>*@
                    </div>
                </div>
                <div class="col-lg-9">
                    <div class="card management-detail-card management-record-details">
                            <div class="card-header management-record-header">
                                <span class="accommodation-details-icon" aria-hidden="true"><i class="ti ti-building-community"></i></span>
                                <div>
                                    <h3 class="card-title">@Model.FacilityName</h3>
                                    <p class="card-subtitle">Classification, location, and operating information.</p>
                                </div>
                                <div class="card-actions">
                                    <a href="#offcanvasEnd" class="btn btn-primary" data-bs-toggle="offcanvas" data-bs-target="#offcanvasEnd" aria-controls="offcanvasEnd">
                                        <i class="ti ti-edit" aria-hidden="true"></i>
                                        Edit Facility
                                    </a>
                                </div>
                            </div>
                            <div class="card-body">
                                <h4 class="management-record-section-title">Facility information</h4>
                                <div class="datagrid">
                                    <div class="datagrid-item">
                                        <div class="datagrid-title">Facility Name</div>
                                        <div class="datagrid-content">@Model.FacilityName</div>
                                    </div>
                                    <div class="datagrid-item">
                                        <div class="datagrid-title">Facility Classification</div>
                                        <div class="datagrid-content">@Model.FacilityClassification</div>
                                    </div>
                                    <div class="datagrid-item">
                                        <div class="datagrid-title">Location</div>
                                        @if (Model.FacilityLocation.Equals("MILL"))
                                        {
                                            <div class="datagrid-content">@Model.FacilityLocation
                                                <span class="nav-link-icon d-md-none d-lg-inline-block">
                                                    <i class="ti ti-building-factory-2"></i>
                                                </span>
                                            </div>
                                        }else{
                                            <div class="datagrid-content">
                                                @Model.FacilityLocation
                                                <span class="nav-link-icon d-md-none d-lg-inline-block">
                                                    <i class="ti ti-building-skyscraper"></i>
                                                </span>
                                            </div>
                                        }
                                    </div>
                                    <div class="datagrid-item">
                                        <div class="datagrid-title">Active Status</div>
                                        <div class="datagrid-content">
                                            @if (Model.isActive.Equals(false))
                                            {
                                                <span class="status status-red">
                                                    Inactive
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="status status-green">
                                                    Active
                                                </span>
                                            }
                                        </div>
                                    </div>
                                    <div class="datagrid-item datagrid-item-wide">
                                        <div class="datagrid-title">Linked Equipment</div>
                                        <div class="datagrid-content">
                                            @if (linkedEquipment.Count == 0)
                                            {
                                                <span class="text-secondary">No equipment linked</span>
                                            }
                                            else
                                            {
                                                <div class="reservation-equipment-chips">
                                                    @foreach (var item in linkedEquipment)
                                                    {
                                                        var behavior = item.LinkType == PropertyManagementSystem.Models.EquipmentLinkTypes.Included
                                                            ? "Included"
                                                            : "Add-on";
                                                        <span class="badge @(item.LinkType == PropertyManagementSystem.Models.EquipmentLinkTypes.Included ? "bg-blue-lt" : "bg-secondary-lt")">
                                                            @item.DefaultQuantity× @item.EquipmentName · @behavior
                                                        </span>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="card-footer management-record-footer d-print-none">
                                <a href="@Url.Action("Index", "Facility")" class="btn btn-link link-secondary px-0">
                                    <i class="ti ti-arrow-left" aria-hidden="true"></i>
                                    <span>Back to Facilities</span>
                                </a>
                            </div>
                    </div>
                </div>
            </div>
            @*<button class="btn btn-primary" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasRight" aria-controls="offcanvasRight">Toggle right offcanvas</button>*@
            @*off canvas edit form*@
            <div class="offcanvas offcanvas-end management-offcanvas" tabindex="-1" id="offcanvasEnd" aria-labelledby="offcanvasEndLabel">
                <div class="offcanvas-header">
                    <div>
                        <span class="reservation-eyebrow">Facility setup</span>
                        <h2 class="offcanvas-title" id="offcanvasEndLabel">Edit Facility</h2>
                        <p>Update the facility classification, location, and status.</p>
                    </div>
                    <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                </div>
                <div class="offcanvas-body">
                    <partial name="Shared/_update"/>
                </div>
            </div>
        </div>
    </div>
</div>
