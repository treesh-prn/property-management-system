@model PropertyManagementSystem.Models.GFMS_Facility;

@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
@{
    ViewData["Title"] = "Home Page";

}
<div class="page-wrapper">
    <!-- Page header -->
    <div class="page-header d-print-none">
        <div class="container-xl">
            <div class="row g-2 align-items-center">
                <div class="col">
                    <!-- Page pre-title -->
                    <div class="page-pretitle">
                        View Facility
                    </div>
                    <h2 class="page-title">
                        Facility Details
                    </h2>
                </div>
                <!-- Page title actions -->
                <div class="col-auto ms-auto d-print-none">
                    <div class="btn-list">
                        <a href="@Url.Action("Index", "Facility")" class="btn btn-primary bg-green">
                            <i class="ti ti-arrow-left icon"></i>
                            Go Back
                        </a>
                        @*   <span class="d-none d-sm-inline">
                        <a href="#" class="btn">
                        New view
                        </a>
                        </span>
                        <a href="#" class="btn btn-primary d-none d-sm-inline-block" data-bs-toggle="modal" data-bs-target="#modal-report">
                        <!-- Download SVG icon from http://tabler-icons.io/i/plus -->
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M12 5l0 14" /><path d="M5 12l14 0" /></svg>
                        Create new report
                        </a>
                        <a href="#" class="btn btn-primary d-sm-none btn-icon" data-bs-toggle="modal" data-bs-target="#modal-report" aria-label="Create new report">
                        <!-- Download SVG icon from http://tabler-icons.io/i/plus -->
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M12 5l0 14" /><path d="M5 12l14 0" /></svg>
                        </a> *@
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Page body -->
    <div class="page-body">
        <div class="container-xl">
            <div class="row row-cards">
                <div class="col-md-3">
                    <div class="card">
                        <div class="card-header card-header-light">
                            <h3 class="card-title">@Model.FacilityName</h3>
                        </div>
                        @*<div class="img-responsive img-responsive-16x9 card-img-top" style="background-image: url(/img/guest-room.jpg)"></div>*@
                        <img class="img-responsive2" src="@Url.Content("~/img/guest-room.jpg")">
                        @*<div class="card-body p-0">
                        Lorem Ipsum Dolor Sit Amet
                        </div>*@
                    </div>
                </div>
                <div class="col-lg-9">
                    <div class="card">
                        <div class="card">
                            <div class="card-header">
                                <div>
                                    <h3 class="card-title">
                                        @Model.FacilityName
                                    </h3>
                                    <p class="card-subtitle">
                                    </p>
                                </div>
                                <div class="card-actions">
                                    <a href="#offcanvasEnd" class="btn btn-primary" data-bs-toggle="offcanvas" data-bs-target="#offcanvasEnd" aria-controls="offcanvasEnd">
                                        Edit Room
                                    </a>
                                </div>
                            </div>
                            <div class="card-body">
                                <div class="datagrid">
                                    <div class="datagrid-item">
                                        <div class="datagrid-title">Facility Name</div>
                                        <div class="datagrid-content">@Model.FacilityName</div>
                                    </div>
                                    <div class="datagrid-item">
                                        <div class="datagrid-title">Facility Classification</div>
                                        <div class="datagrid-content">@Model.FacilityClassification</div>
                                    </div>
                                    <div class="datagrid-item">
                                        <div class="datagrid-title">Location</div>
                                        @if (Model.FacilityLocation.Equals("MILL"))
                                        {
                                            <div class="datagrid-content">@Model.FacilityLocation
                                                <span class="nav-link-icon d-md-none d-lg-inline-block">
                                                    <i class="ti ti-building-factory-2"></i>
                                                </span>
                                            </div>
                                        }else{
                                            <div class="datagrid-content">
                                                @Model.FacilityLocation
                                                <span class="nav-link-icon d-md-none d-lg-inline-block">
                                                    <i class="ti ti-building-skyscraper"></i>
                                                </span>
                                            </div>
                                        }
                                    </div>
                                    <div class="datagrid-item">
                                        <div class="datagrid-title">Active Status</div>
                                        <div class="datagrid-content">
                                            @if (Model.isActive.Equals(false))
                                            {
                                                <span class="status status-red">
                                                    Inactive
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="status status-green">
                                                    Active
                                                </span>
                                            }
                                        </div>
                                    </div>
                                    <div class="datagrid-item hide">
                                        <div class="datagrid-title">Checkbox</div>
                                        <div class="datagrid-content">
                                            <label class="form-check">
                                                <input class="form-check-input" type="checkbox" checked>
                                                <span class="form-check-label">Click me</span>
                                            </label>
                                        </div>
                                    </div>
                                    <div class="datagrid-item">
                                        <div class="datagrid-title">Icon</div>
                                        <div class="datagrid-content">
                                            <!-- Download SVG icon from http://tabler-icons.io/i/check -->
                                            <svg xmlns="http://www.w3.org/2000/svg" class="icon text-green" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M5 12l5 5l10 -10" /></svg>
                                            Checked
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="card-body p-0">
                        </div>
                    </div>
                </div>
            </div>
            @*<button class="btn btn-primary" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasRight" aria-controls="offcanvasRight">Toggle right offcanvas</button>*@
            @*off canvas edit form*@
            <div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasEnd" aria-labelledby="offcanvasEndLabel">
                <div class="offcanvas-header">
                    <h2 class="offcanvas-title" id="offcanvasEndLabel">Edit Room</h2>
                    <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                </div>
                <div class="offcanvas-body">
                    <partial name="Shared/_update"/>
                </div>
            </div>
        </div>
    </div>
</div>