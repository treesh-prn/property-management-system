@{
    ViewData["Title"] = "Home Page";

}
<div class="page-wrapper">
    <!-- Page header -->
    <div class="page-header d-print-none">
        <div class="container-xl">
            <div class="row g-2 align-items-center">
                <div class="col">
                    <!-- Page pre-title -->
                    <div class="page-pretitle">
                        SETUP
                    </div>
                    <h2 class="page-title">
                        FACILITY
                    </h2>
                </div>
                <!-- Page title actions -->
                <div class="col-auto ms-auto d-print-none">
                    <div class="btn-list">
                        @*   <span class="d-none d-sm-inline">
                        <a href="#" class="btn">
                        New view
                        </a>
                        </span>
                        <a href="#" class="btn btn-primary d-none d-sm-inline-block" data-bs-toggle="modal" data-bs-target="#modal-report">
                        <!-- Download SVG icon from http://tabler-icons.io/i/plus -->
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M12 5l0 14" /><path d="M5 12l14 0" /></svg>
                        Create new report
                        </a>
                        <a href="#" class="btn btn-primary d-sm-none btn-icon" data-bs-toggle="modal" data-bs-target="#modal-report" aria-label="Create new report">
                        <!-- Download SVG icon from http://tabler-icons.io/i/plus -->
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M12 5l0 14" /><path d="M5 12l14 0" /></svg>
                        </a> *@
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Page body -->
    <div class="page-body">
        <div class="container-xl">
            <div class="row row-deck row-cards">
                <div class="col-lg-12 col-md-12">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title"></h3>
                            <div class="card-actions">
                                <a href="#" data-bs-toggle="modal" data-bs-target="#modal-newFacility" class="btn btn-primary">
                                    <i class="ti ti-home-plus icon"></i>
                                    New Facility
                                </a>
                            </div>
                        </div>
                        <div class="card-body p-0">
                            @(
                                Html.Kendo().Grid<PropertyManagementSystem.Models.GFMS_Facility>()
                                .Name("facilityGrid")
                                .ToolBar(tools => tools.Excel())
                                .Excel(excel => excel
                                .FileName("Facilities.xlsx")
                                .AllPages(true))
                                .Columns(columns =>
                                {
                                    columns.Bound(c => c.FacilityId).Visible(false).Exportable(false);
                                    columns.Bound(c => c.FacilityName);
                                    columns.Bound(c => c.FacilityLocation);
                                    columns.Bound(c => c.isActive).Width(100);
                                   
                                })
                                .Scrollable()
                                .ToolBar(toolbar =>
                                {
                                    toolbar.Search();
                                })
                                .DataSource(dataSource => dataSource
                                .Ajax()
                                .Model(model => model.Id(p => p.FacilityId))
                                .Read(read => read.Action("getFacilities", "Facility"))
                                .PageSize(50)
                                )
                            )


                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>



@*NEW FACILITY MODAL *@
<div class="modal modal-blur fade" id="modal-newFacility" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">New Facility</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="fcFRM1" asp-controller="Facility" asp-action="newFacility" enctype="multipart/form-data" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label required">Name </label>
                        <input class="form-control" name="_name" type="text" required="required">
                    </div>
                    <div class="mb-3">
                        <label class="form-label required">Location</label>
                        <input class="form-control" name="_location" type="text" required="required">
                    </div>
                    <label class="row">
                        <span class="col">Is Active</span>
                        <span class="col-auto">
                            <label class="form-check form-check-single form-switch">
                                <input class="form-check-input" name="_isActive" type="checkbox" checked>
                            </label>
                        </span>
                    </label>
                 </div>
                
                 
                 <div class="modal-footer">
                    <button id="svbtn15" type="submit" class="btn btn btn-success ms-auto">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>
@*END - NEW FACILITY MODAL *@