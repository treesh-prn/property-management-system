@model IReadOnlyList<PropertyManagementSystem.Models.FacilityEquipmentLinkOption>
@using PropertyManagementSystem.Models

<div class="management-form-section-title">Linked equipment</div>
<p class="text-secondary small mb-3">
    Included items are automatically assigned with this facility. Add-ons remain optional during reservation entry.
</p>

@if (Model.Count == 0)
{
    <div class="alert alert-info mb-3">
        Create active equipment inventory first, then return here to link it to this facility.
    </div>
}
else
{
    <div class="facility-equipment-link-list">
        @for (var index = 0; index < Model.Count; index++)
        {
            var option = Model[index];
            <div class="facility-equipment-link-item">
                <input type="hidden" name="equipmentLinks[@index].EquipmentId" value="@option.EquipmentId" />
                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox"
                           id="equipment-link-@option.EquipmentId"
                           name="equipmentLinks[@index].Selected" value="true"
                           @(option.Selected ? "checked" : null) />
                    <label class="form-check-label fw-semibold" for="equipment-link-@option.EquipmentId">
                        @option.EquipmentName
                        <span class="text-secondary fw-normal">(@option.AvailableQuantity in inventory)</span>
                    </label>
                </div>
                <div class="row g-2">
                    <div class="col-sm-5">
                        <label class="form-label">Relationship</label>
                        <select class="form-select" name="equipmentLinks[@index].LinkType">
                            <option value="@EquipmentLinkTypes.Included" selected="@(option.LinkType == EquipmentLinkTypes.Included ? "selected" : null)">Automatically included</option>
                            <option value="@EquipmentLinkTypes.AddOn" selected="@(option.LinkType == EquipmentLinkTypes.AddOn ? "selected" : null)">Available add-on</option>
                        </select>
                    </div>
                    <div class="col-sm-3">
                        <label class="form-label">Default quantity</label>
                        <input class="form-control" type="number"
                               name="equipmentLinks[@index].DefaultQuantity"
                               value="@option.DefaultQuantity" min="1" max="@Math.Max(option.AvailableQuantity, 1)" />
                    </div>
                    <div class="col-sm-4 d-flex align-items-end">
                        <label class="management-toggle-row w-100 mb-0">
                            <span class="form-label mb-0">Fixed to facility</span>
                            <span class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox"
                                       name="equipmentLinks[@index].IsFixed" value="true"
                                       @(option.IsFixed ? "checked" : null) />
                            </span>
                        </label>
                    </div>
                </div>
            </div>
        }
    </div>
}
