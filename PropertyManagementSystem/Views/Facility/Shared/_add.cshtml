<form id="fcFRM1" asp-controller="Facility" asp-action="newFacility" enctype="multipart/form-data" method="post">
        <div class="management-form-section-title">Facility information</div>
        <div class="mb-3">
            <label class="form-label required">Facility Name </label>
            <input class="form-control" name="_name" type="text" required="required">
        </div>

        <div class="mb-3">
            <label class="form-label required">Facility Location</label>
            @(Html.Kendo().DropDownList()
                .Name("_location")
                .BindTo(new List<SelectListItem>
            {
            new SelectListItem() {
            Text = "MILL",
            Value = "MILL"
            },
            new SelectListItem() {
            Text = "MAKATI",
            Value = "MAKATI"
            },
            })
                .HtmlAttributes(new { style = "width: 100%" })
                )
        </div>
        <div class="mb-3">
            <label class="form-label required">Facility Classification</label>
            @(Html.Kendo().DropDownList()
                .Name("_classification")
                .BindTo(new List<SelectListItem>
            {
            new SelectListItem() {
            Text = "FUNCTION ROOM",
            Value = "FUNCTION ROOM"
            },
            new SelectListItem() {
            Text = "GUESTHOUSE",
            Value = "GUESTHOUSE"
            },
            new SelectListItem() {
            Text = "DORM",
            Value = "DORM"
            },
            })
                .HtmlAttributes(new { style = "width: 100%" })
                )
        </div>
        <div class="management-form-section-title">Availability</div>
        <div class="management-toggle-row">
            <label for="isActiveCheckbox" class="form-label me-auto">Is Active</label>
            <div class="form-check form-switch">
                <input class="form-check-input" id="isActiveCheckbox" name="_isActive" type="checkbox" value="true" checked>
            </div>
        </div>
        <div class="management-form-actions">
            <button type="submit" class="btn btn-primary"><i class="ti ti-plus" aria-hidden="true"></i> Add Facility</button>
        </div>
</form>
