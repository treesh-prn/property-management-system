@model PropertyManagementSystem.Models.EquipmentViewModel;

@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
@{
    ViewData["Title"] = "Home Page";
    var hasLocationLinks = Model.LocationLinks.Count > 0;
}
<div class="page-wrapper management-page management-detail-page">
    <!-- Page header -->
    <div class="page-header d-print-none">
        <div class="container-xl">
            <div class="row g-2 align-items-center">
                <div class="col">
                    <!-- Page pre-title -->
                    <div class="page-pretitle">
                        View Equipment
                    </div>
                    <h2 class="page-title">
                        Equipment Details
                    </h2>
                    <div class="text-secondary mt-1">Review equipment availability, rates, assignment, and operating status.</div>
                </div>
            </div>
        </div>
    </div>
    <!-- Page body -->
    <div class="page-body">
        <div class="container-xl">
            <div class="row row-cards management-detail-layout">
                <div class="col-md-3">
                    <div class="card management-media-card">
                        <div class="card-header card-header-light">
                            <h3 class="card-title">@Model.EquipmentName</h3>
                        </div>
                        @*<div class="img-responsive img-responsive-16x9 card-img-top" style="background-image: url(/img/guest-room.jpg)"></div>*@
                        <img class="img-responsive2" src="@Url.Content("~/img/equipment.jpg")" alt="Equipment preview">
                        @*<div class="card-body p-0">
                        Lorem Ipsum Dolor Sit Amet
                        </div>*@
                    </div>
                </div>
                <div class="col-lg-9">
                    <div class="card management-detail-card">
                            <div class="card-header">
                                <div>
                                    <span class="reservation-eyebrow">Equipment record</span>
                                    <h3 class="card-title">@Model.EquipmentName</h3>
                                    <p class="card-subtitle">Inventory, pricing, and assignment information.</p>
                                </div>
                                <div class="card-actions">
                                    <a href="#offcanvasEnd" class="btn btn-primary" data-bs-toggle="offcanvas" data-bs-target="#offcanvasEnd" aria-controls="offcanvasEnd">
                                        <i class="ti ti-edit" aria-hidden="true"></i>
                                        Edit Equipment
                                    </a>
                                </div>
                            </div>
                            <div class="card-body">
                                <div class="datagrid">
                                    <div class="datagrid-item">
                                        <div class="datagrid-title">Equipment Name</div>
                                        <div class="datagrid-content">@Model.EquipmentName</div>
                                    </div>
                                    <div class="datagrid-item">
                                        <div class="datagrid-title">Equipment Quantity</div>
                                        <div class="datagrid-content">@Model.EquipmentQty</div>
                                    </div>
                                    <div class="datagrid-item">
                                        <div class="datagrid-title">Purchase Cost</div>
                                        <div class="datagrid-content">
                                            <span class="nav-link-icon d-md-none d-lg-inline-block">
                                                <i class="ti ti-currency-peso"></i>
                                            </span>
                                            @Model.PurchaseCost
                                        </div>
                                        
                                    </div>
                                    <div class="datagrid-item">
                                        <div class="datagrid-title">Whole Day Cost</div>
                                        <div class="datagrid-content">
                                            <span class="nav-link-icon d-md-none d-lg-inline-block">
                                                <i class="ti ti-currency-peso"></i>
                                            </span>
                                            @Model.WholeDayCost
                                        </div>
                                    </div>
                                    <div class="datagrid-item">
                                        <div class="datagrid-title">Half Day Cost</div>
                                        <div class="datagrid-content">
                                            <span class="nav-link-icon d-md-none d-lg-inline-block">
                                                <i class="ti ti-currency-peso"></i>
                                            </span>
                                            @Model.HalfDayCost
                                        </div>
                                    </div>
                                    <div class="datagrid-item">
                                        <div class="datagrid-title">Remarks</div>
                                        @if (Model.Remarks == null)
                                        {
                                            <div class="datagrid-content">-</div>
                                        }
                                        else
                                        {
                                            <div class="datagrid-content">@Model.Remarks</div>
                                        }
                                    </div>
                                    <div class="datagrid-item">
                                        <div class="datagrid-title">Active Status</div>
                                        <div class="datagrid-content">
                                            @if (Model.isActive.Equals(false))
                                            {
                                                <span class="status status-red">
                                                    Inactive
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="status status-green">
                                                    Active
                                                </span>
                                            }
                                        </div>
                                    </div>
                                    <div class="datagrid-item">
                                        <div class="datagrid-title">Facility Equipment?</div>
                                        <div class="datagrid-content">
                                            @if (Model.isFacilityEquipment != true && !hasLocationLinks)
                                            {
                                                <span class="status status-red">
                                                    No
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="status status-green">
                                                    Yes
                                                </span>
                                            }
                                        </div>
                                    </div>
                                    <div class="datagrid-item">
                                        <div class="datagrid-title">Facility</div>
                                        @if (hasLocationLinks)
                                        {
                                            <div class="datagrid-content">@string.Join(", ", Model.LocationLinks.Select(link => link.FacilityName).Distinct())</div>
                                        }
                                        else if (Model.FacilityId == null)
                                        {
                                            <div class="datagrid-content">-</div>
                                        }
                                        else
                                        {
                                            <div class="datagrid-content">@Model.FacilityName</div>
                                        }
                                    </div>
                                    <div class="datagrid-item">
                                        <div class="datagrid-title">Room</div>
                                        @if (hasLocationLinks)
                                        {
                                            var linkedRooms = Model.LocationLinks
                                                .Where(link => !string.IsNullOrWhiteSpace(link.RoomName))
                                                .Select(link => link.RoomName)
                                                .Distinct()
                                                .ToList();
                                            <div class="datagrid-content">@(linkedRooms.Count == 0 ? "All rooms" : string.Join(", ", linkedRooms))</div>
                                        }
                                        else if (Model.RoomId == null)
                                        {
                                            <div class="datagrid-content">-</div>
                                        }
                                        else
                                        {
                                            <div class="datagrid-content">@Model.RoomName</div>
                                        }
                                    </div>
                                    @if (hasLocationLinks || Model.isFacilityEquipment == true)
                                    {
                                        <div class="datagrid-item datagrid-item-wide">
                                            <div class="datagrid-title">Location Links</div>
                                            <div class="datagrid-content">
                                                @if (Model.LocationLinks.Count > 0)
                                                {
                                                    <div class="reservation-equipment-chips">
                                                        @foreach (var link in Model.LocationLinks)
                                                        {
                                                            <span class="badge @(link.LinkType == "INCLUDED" ? "bg-blue-lt" : "bg-secondary-lt")">
                                                                @link.DefaultQuantity× @link.FacilityName@(string.IsNullOrWhiteSpace(link.RoomName) ? "" : $" / {link.RoomName}") · @(link.LinkType == "INCLUDED" ? "Included" : "Add-on")
                                                            </span>
                                                        }
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span>@Model.FacilityName @(string.IsNullOrWhiteSpace(Model.RoomName) ? "" : $"/ {Model.RoomName}")</span>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="card-footer d-print-none">
                                <a href="@Url.Action("Index", "Equipment")" class="btn btn-link link-secondary px-0">
                                    <i class="ti ti-arrow-left" aria-hidden="true"></i>
                                    <span>Back to Equipment</span>
                                </a>
                            </div>
                    </div>
                </div>
            </div>
            @*<button class="btn btn-primary" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasRight" aria-controls="offcanvasRight">Toggle right offcanvas</button>*@
            @*off canvas edit form*@
            <div class="offcanvas offcanvas-end management-offcanvas" tabindex="-1" id="offcanvasEnd" aria-labelledby="offcanvasEndLabel">
                <div class="offcanvas-header">
                    <div>
                        <span class="reservation-eyebrow">Equipment setup</span>
                        <h2 class="offcanvas-title" id="offcanvasEndLabel">Edit Equipment</h2>
                        <p>Update inventory, pricing, and assignment information.</p>
                    </div>
                    <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                </div>
                <div class="offcanvas-body">
                    <partial name="Shared/_update"/>
                </div>
            </div>
        </div>
    </div>
</div>
