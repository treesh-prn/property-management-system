@model PropertyManagementSystem.Models.GFMS_Equipments;

@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
@{
    ViewData["Title"] = "Home Page";

}
<div class="page-wrapper">
    <!-- Page header -->
    <div class="page-header d-print-none">
        <div class="container-xl">
            <div class="row g-2 align-items-center">
                <div class="col">
                    <!-- Page pre-title -->
                    <div class="page-pretitle">
                        View Equipment
                    </div>
                    <h2 class="page-title">
                        Equipment Details
                    </h2>
                </div>
                <!-- Page title actions -->
                <div class="col-auto ms-auto d-print-none">
                    <div class="btn-list">
                        <a href="@Url.Action("Index", "Equipment")" class="btn btn-primary bg-green">
                            <i class="ti ti-arrow-left icon"></i>
                            Go Back
                        </a>
                        @*   <span class="d-none d-sm-inline">
                        <a href="#" class="btn">
                        New view
                        </a>
                        </span>
                        <a href="#" class="btn btn-primary d-none d-sm-inline-block" data-bs-toggle="modal" data-bs-target="#modal-report">
                        <!-- Download SVG icon from http://tabler-icons.io/i/plus -->
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M12 5l0 14" /><path d="M5 12l14 0" /></svg>
                        Create new report
                        </a>
                        <a href="#" class="btn btn-primary d-sm-none btn-icon" data-bs-toggle="modal" data-bs-target="#modal-report" aria-label="Create new report">
                        <!-- Download SVG icon from http://tabler-icons.io/i/plus -->
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M12 5l0 14" /><path d="M5 12l14 0" /></svg>
                        </a> *@
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Page body -->
    <div class="page-body">
        <div class="container-xl">
            <div class="row row-cards">
                <div class="col-md-3">
                    <div class="card">
                        <div class="card-header card-header-light">
                            <h3 class="card-title">@Model.EquipmentName</h3>
                        </div>
                        @*<div class="img-responsive img-responsive-16x9 card-img-top" style="background-image: url(/img/guest-room.jpg)"></div>*@
                        <img class="img-responsive2" src="@Url.Content("~/img/equipment.jpg")">
                        @*<div class="card-body p-0">
                        Lorem Ipsum Dolor Sit Amet
                        </div>*@
                    </div>
                </div>
                <div class="col-lg-9">
                    <div class="card">
                        <div class="card">
                            <div class="card-header">
                                <div>
                                    <h3 class="card-title">
                                        @Model.EquipmentName
                                    </h3>
                                    <p class="card-subtitle">
                                    </p>
                                </div>
                                <div class="card-actions">
                                    <a href="#offcanvasEnd" class="btn btn-primary" data-bs-toggle="offcanvas" data-bs-target="#offcanvasEnd" aria-controls="offcanvasEnd">
                                        Edit Equipment
                                    </a>
                                </div>
                            </div>
                            <div class="card-body">
                                <div class="datagrid">
                                    <div class="datagrid-item">
                                        <div class="datagrid-title">Equipment Name</div>
                                        <div class="datagrid-content">@Model.EquipmentName</div>
                                    </div>
                                    <div class="datagrid-item">
                                        <div class="datagrid-title">Equipment Quantity</div>
                                        <div class="datagrid-content">@Model.EquipmentQty</div>
                                    </div>
                                    <div class="datagrid-item">
                                        <div class="datagrid-title">Purchase Cost</div>
                                        <div class="datagrid-content">
                                            <span class="nav-link-icon d-md-none d-lg-inline-block">
                                                <i class="ti ti-currency-peso"></i>
                                            </span>
                                            @Model.PurchaseCost
                                        </div>
                                        
                                    </div>
                                    <div class="datagrid-item">
                                        <div class="datagrid-title">Whole Day Cost</div>
                                        <div class="datagrid-content">
                                            <span class="nav-link-icon d-md-none d-lg-inline-block">
                                                <i class="ti ti-currency-peso"></i>
                                            </span>
                                            @Model.WholeDayCost
                                        </div>
                                    </div>
                                    <div class="datagrid-item">
                                        <div class="datagrid-title">Half Day Cost</div>
                                        <div class="datagrid-content">
                                            <span class="nav-link-icon d-md-none d-lg-inline-block">
                                                <i class="ti ti-currency-peso"></i>
                                            </span>
                                            @Model.HalfDayCost
                                        </div>
                                    </div>
                                    <div class="datagrid-item">
                                        <div class="datagrid-title">Active Status</div>
                                        <div class="datagrid-content">
                                            @if (Model.isActive.Equals(false))
                                            {
                                                <span class="status status-red">
                                                    Inactive
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="status status-green">
                                                    Active
                                                </span>
                                            }
                                        </div>
                                    </div>
                                    <div class="datagrid-item">
                                        <div class="datagrid-title">Remarks</div>
                                        @if(Model.Remarks == null)
                                        {
                                            <div class="datagrid-content">-</div>
                                        }
                                        else
                                        {
                                            <div class="datagrid-content">@Model.Remarks</div>
                                        }                                       
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="card-body p-0">
                        </div>
                    </div>
                </div>
            </div>
            @*<button class="btn btn-primary" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasRight" aria-controls="offcanvasRight">Toggle right offcanvas</button>*@
            @*off canvas edit form*@
            <div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasEnd" aria-labelledby="offcanvasEndLabel">
                <div class="offcanvas-header">
                    <h2 class="offcanvas-title" id="offcanvasEndLabel">Edit Room</h2>
                    <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                </div>
                <div class="offcanvas-body">
                <partial name="Shared/_update" />
                </div>
            </div>
        </div>
    </div>
</div>