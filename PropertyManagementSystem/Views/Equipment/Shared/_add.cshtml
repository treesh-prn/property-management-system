<form id="fcFRM1" asp-controller="Equipment" asp-action="newEquipments" enctype="multipart/form-data" method="post">
    <div class="mb-3">
        <label for="equipmentName" class="form-label required">Equipment Name</label>
        <input id="equipmentName" class="form-control" name="_name" type="text" required>
    </div>

    <div class="mb-3">
        <label for="equipmentQty" class="form-label required">Equipment Qty</label>
        <input id="equipmentQty" class="form-control" name="_quantity" type="number" min="1" required>
    </div>

    <div class="mb-3">
        <label for="purchaseCost" class="form-label required">Purchase Cost</label>
        <input id="purchaseCost" class="form-control" name="_purCost" type="number" step="0.01" min="0" required>
    </div>

    <div class="mb-3">
        <label for="halfCost" class="form-label required">Half Cost</label>
        <input id="halfCost" class="form-control" name="_halfCost" type="number" step="0.01" min="0" required>
    </div>

    <div class="mb-3">
        <label for="wholeCost" class="form-label required">Whole Day Cost</label>
        <input id="wholeCost" class="form-control" name="_wholeCost" type="number" step="0.01" min="0" required>
    </div>

    <div class="mb-3">
        <label for="remarks" class="form-label required">Remarks</label>
        <input id="remarks" class="form-control" name="_remarks" type="text" required>
    </div>

    <div class="mb-3 d-flex align-items-center">
        <label for="isActiveCheckbox" class="form-label me-auto">Is Active</label>
        <div class="form-check form-switch">
            <input id="isActiveCheckbox" class="form-check-input" name="_isActive" type="checkbox" value="true" checked>
        </div>
    </div>

    <div class="mb-3 d-flex align-items-center">
        <label for="isFacilityEquipment" class="form-label me-auto">Is Facility Equipment?</label>
        <div class="form-check form-switch">
            <input id="isFacilityEquipment" class="form-check-input" name="_isFacilityEquipment" type="checkbox" value="true">
        </div>
    </div>

    <!-- Facility and Room Dropdowns Wrapper -->
    <div id="facilityRoomWrapper" style="display: none;">
        <div class="mb-3">
            <label for="facilityId" class="form-label required">Facility</label>
            @(
                Html.Kendo().DropDownList()
                .Name("_facilityId")
                .DataTextField("FacilityName")
                .DataValueField("FacilityId")
                .DataSource(source =>
                {
                    source.Read(read =>
                    {
                        read.Action("GetFacility", "FunctionRoom").Data("filterFacilities");
                    });
                })
                .HtmlAttributes(new { style = "width: 100%" })
                .OptionLabel("Select Facility")
                )
        </div>
        <div class="mb-3">
            <label for="roomId" class="form-label required">Room</label>
            @(Html.Kendo().DropDownList()
                .Name("_roomId")
                .DataTextField("RoomName")
                .DataValueField("RoomId")
                .CascadeFrom("_facilityId")
                .DataSource(source =>
                {
                    source.Read(read =>
                    {
                        read.Action("GetRoom", "FunctionRoom").Data("filterRooms");
                    }).ServerFiltering(true);
                })
                .HtmlAttributes(new { style = "width: 100%" })
                .OptionLabel("Select Room")
                )
        </div>
    </div>

    <div class="mb-3 text-end">
        <button type="submit" class="btn btn-primary">Save Changes</button>
    </div>
</form>