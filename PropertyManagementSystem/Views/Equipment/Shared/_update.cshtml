@model PropertyManagementSystem.Models.GFMS_Equipments;
<form asp-action="EditEquipment" asp-controller="Equipment" method="post">
    <input type="hidden" name="Id" asp-for="Id" />
    <div class="mb-3">
        <label class="form-label required">Equipment Name </label>
        <input class="form-control" name="_name" type="text" required="required" asp-for="EquipmentName">
    </div>
    <div class="mb-3">
        <label class="form-label required">Equipment Quantity </label>
        <input class="form-control" name="_quantity" type="text" required="required" asp-for="EquipmentQty">
    </div>
    <div class="mb-3">
        <label class="form-label required">Purchase Cost </label>
        <input class="form-control" name="_purCost" type="text" required="required" asp-for="PurchaseCost">
    </div>
    <div class="mb-3">
        <label class="form-label required">Half Cost </label>
        <input class="form-control" name="_halfCost" type="text" required="required" asp-for="HalfDayCost">
    </div>
    <div class="mb-3">
        <label class="form-label required">Whole Day Cost </label>
        <input class="form-control" name="_wholeCost" type="text" required="required" asp-for="WholeDayCost">
    </div>
    <div class="mb-3">
        <label class="form-label required">Remarks</label>
        <input class="form-control" name="_remarks" type="text" required="required" asp-for="Remarks">
    </div>
    <label class="row">
        <span class="col form-label">Is Active</span>
        <span class="col-auto">
            <label class="form-check form-check-single form-switch">
                <input class="form-check-input" name="_isActive" type="checkbox" value="true" @(Model.isActive == true ? "checked" : "") />
            </label>
        </span>
    </label>
    <div class="mb-3 text-end">
        <button type="submit" class="btn btn-primary">Save Changes</button>
    </div>
</form>