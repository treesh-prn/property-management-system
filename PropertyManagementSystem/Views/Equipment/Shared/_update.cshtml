@model PropertyManagementSystem.Models.EquipmentViewModel;
<form asp-action="EditEquipment" asp-controller="Equipment" method="post">
    <input type="hidden" name="Id" asp-for="Id" />
    <div class="mb-3">
        <label class="form-label required">Equipment Name </label>
        <input class="form-control" name="_name" type="text" required="required" asp-for="EquipmentName">
    </div>
    <div class="mb-3">
        <label class="form-label required">Equipment Quantity </label>
        <input class="form-control" name="_quantity" type="text" required="required" asp-for="EquipmentQty">
    </div>
    <div class="mb-3">
        <label class="form-label required">Purchase Cost </label>
        <input class="form-control" name="_purCost" type="text" step="0.01" required="required" asp-for="PurchaseCost">
    </div>
    <div class="mb-3">
        <label class="form-label required">Half Cost </label>
        <input class="form-control" name="_halfCost" type="text" step="0.01" required="required" asp-for="HalfDayCost">
    </div>
    <div class="mb-3">
        <label class="form-label required">Whole Day Cost </label>
        <input class="form-control" name="_wholeCost" type="text" step="0.01" required="required" asp-for="WholeDayCost">
    </div>
    <div class="mb-3">
        <label class="form-label required">Remarks</label>
        <input class="form-control" name="_remarks" type="text" required="required" asp-for="Remarks">
    </div>
    <div class="mb-3 d-flex align-items-center">
        <label for="_isActive" class="form-label me-auto">Is Active?</label>
        <div class="form-check form-switch">
            <input class="form-check-input" name="_isActive" type="checkbox" value="true" @(Model.isActive == true ? "checked" : "") />
        </div>
    </div>
    <div class="mb-3 d-flex align-items-center">
        <label for="isFacilityEquipment" class="form-label me-auto">Is Facility Equipment?</label>
        <div class="form-check form-switch">
            <input id="isFacilityEquipment" class="form-check-input" name="_isFacilityEquipment" type="checkbox" value="true" @(Model.isFacilityEquipment == true ? "checked" : "")/>
        </div>
    </div>

    <!-- Facility and Room Dropdowns Wrapper -->
    <div id="facilityRoomWrapper" style="display: none;">
        <div class="mb-3">
            <label for="facilityId" class="form-label required">Facility</label>
            @(
                Html.Kendo().DropDownList()
                .Name("_facilityId")
                .DataTextField("FacilityName")
                .DataValueField("FacilityId")
                .Value(Model.RoomId.ToString())
                .DataSource(source =>
                {
                    source.Read(read =>
                    {
                        read.Action("GetFacility", "FunctionRoom").Data("filterFacilities");
                    });
                })
                .HtmlAttributes(new { style = "width: 100%" })
                .OptionLabel("Select Facility")
                )
        </div>
        <div class="mb-3">
            <label for="roomId" class="form-label required">Room</label>
            @(Html.Kendo().DropDownList()
                .Name("_roomId")
                .DataTextField("RoomName")
                .DataValueField("RoomId")
                .Value(Model.RoomId.ToString())
                .CascadeFrom("_facilityId")
                .DataSource(source =>
                {
                    source.Read(read =>
                    {
                        read.Action("GetRoom", "FunctionRoom").Data("filterRooms");
                    }).ServerFiltering(true);
                })
                .HtmlAttributes(new { style = "width: 100%" })
                .OptionLabel("Select Room")
                )
        </div>
    <div class="mb-3 text-end">
        <button type="submit" class="btn btn-primary">Save Changes</button>
    </div>
</form>