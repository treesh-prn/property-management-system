@model PropertyManagementSystem.Models.ReservationViewModel;

@{
    ViewData["Title"] = "View Reservation Details";
}
@inject PropertyManagementSystem.Services.IRoleService RoleService
@inject SignInManager<ApplicationUser> SignInManager
@using Microsoft.AspNetCore.Identity

@{
    var employee = await RoleService.GetUserName(User);
    var gfmsRoles = await RoleService.GetRolesAsync(User);
    var activeRole = await RoleService.GetActiveRoleAsync(User);

    var alertMessage = TempData["AlertMessage"] as string;
    var alertSubMessage = TempData["AlertSubMessage"] as string;
    var alertType = TempData["AlertType"] as string;
}
<div class="page-wrapper">
    @if (!string.IsNullOrEmpty(alertMessage))
    {

        @if (alertType == "Success")
        {
            <div class="col-lg-6 ms-auto alert alert-success alert-dismissible fade show custom-alert" role="alert"
                 style="display:@(TempData["AlertMessage"] != null ? "block" : "none");">
                <div class="d-flex">
                    <div>
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon alert-icon icon-2">
                            <path d="M5 12l5 5l10 -10"></path>
                        </svg>
                    </div>
                    <div>
                        <h4 class="alert-title">@TempData["AlertType"]</h4>
                        <div class="text-secondary">
                            @if (TempData["AlertMessage"] != null)
                            {
                                <strong>@TempData["AlertMessage"]</strong>
                                <br />
                                @TempData["AlertSubMessage"]
                            }
                        </div>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        else if (alertType == "Warning")
        {
            <div class="col-lg-6 ms-auto alert alert-warning alert-dismissible fade show custom-alert" role="alert"
                 style="display:@(TempData["AlertMessage"] != null ? "block" : "none");">
                <div class="d-flex">
                    <div>
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon alert-icon">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                            <circle cx="12" cy="12" r="9" />
                            <line x1="12" y1="8" x2="12" y2="12" />
                            <line x1="12" y1="16" x2="12.01" y2="16" />
                        </svg>
                    </div>
                    <div>
                        <h4 class="alert-title">@TempData["AlertType"]</h4>
                        <div class="text-secondary">
                            @if (TempData["AlertMessage"] != null)
                            {
                                <strong>@TempData["AlertMessage"]</strong>
                                <br />
                                @TempData["AlertSubMessage"]
                            }
                        </div>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    }
    <!-- Page header -->
    <div class="page-header d-print-none">
        <div class="container-xl">
            <div class="row g-2 align-items-center">
                <div class="col">
                    <!-- Page pre-title -->
                    <div class="page-pretitle">
                        View Application
                    </div>
                    <h2 class="page-title">
                        Dorm and Housing
                    </h2>

                </div>
                <!-- Page title actions -->
            </div>
        </div>
    </div>
    <!-- Page body -->
    <div class="page-body">
        <div class="container-xl">
            <div class="row row-cards">
                <!-- Main Content Column (Expands to full width when DRAFT) -->
                <div class="@(Model.DormerHistoryDetails != null && Model.DormerHistoryDetails.Any() && Model.ReservationHeader.Status != "DRAFT" ? "col-lg-9" : "col-lg-12")">
                    @if (activeRole == "GFMS.Requestor")
                    {
                        if (User.IsInRole("GFMS.Admin Approver") && Model.ReservationHeader.Status != "DRAFT")
                        {
                            <partial name="Shared/_view" />
                        }
                        else if (Model.ReservationHeader.Status == "FOR DEPARTMENT HEAD'S APPROVAL" ||
                        (Model.ReservationHeader.Status == "FOR ADMIN APPROVER'S APPROVAL" && Model.ReservationDetails.FirstOrDefault().FacilityId == 0))
                        {
                            <partial name="Shared/_update" />
                        }
                        else if (Model.ReservationHeader.Status == "FOR ADMIN MANAGER'S APPROVAL" ||
                        Model.ReservationHeader.Status == "FOR ADMIN APPROVER'S APPROVAL" ||
                        Model.ReservationHeader.Status == "APPROVED" ||
                        Model.ReservationHeader.Status == "CANCELLED" ||
                        Model.ReservationHeader.Status == "FOR RENEWAL" ||
                        Model.ReservationHeader.Status == "DISAPPROVED")
                        {
                            <partial name="Shared/_view" />
                        }
                        else
                        {
                            <partial name="Shared/_draft" />
                        }
                    }
                    else if (activeRole == "GFMS.Admin Approver")
                    {
                        if (Model.ReservationHeader.Status == "FOR ADMIN APPROVER'S APPROVAL")
                        {
                            <partial name="Shared/AdminApprover/_pending" />
                        }
                        else
                        {
                            <partial name="Shared/_view" />
                        }
                    }
                    else if (activeRole == "GFMS.Admin Manager")
                    {
                        if (Model.ReservationHeader.Status == "FOR ADMIN MANAGER'S APPROVAL")
                        {
                            <partial name="Shared/AdminManager/_pending" />
                        }
                        else
                        {
                            <partial name="Shared/_view" />
                        }
                    }
                    else if (activeRole == "GFMS.Department Head")
                    {
                        if (Model.ReservationHeader.Status == "FOR DEPARTMENT HEAD'S APPROVAL")
                        {
                            <partial name="Shared/DepartmentHead/_pending" />
                        }
                        else
                        {
                            <partial name="Shared/_view" />
                        }
                    }
                </div>

                <!-- Right Sidebar: Room Transfer History (Only when NOT DRAFT) -->
                @if (Model.DormerHistoryDetails != null && Model.DormerHistoryDetails.Any() && Model.ReservationHeader.Status != "DRAFT")
                {
                    <div class="col-lg-3">
                        <div class="card">
                            <div class="card-body">
                                <h3 class="card-title">Dormer Room Transfer History</h3>

                                <ul class="steps steps-vertical">
                                    @foreach (var history in Model.DormerHistoryDetails)
                                    {
                                        <li class="step-item">
                                            <div class="h4 m-0">
                                                @if (history.Status == "FOR RENEWAL")
                                                {
                                                    <span class="badge bg-warning text-dark">RENEWAL</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-info text-white">@history.Status</span>
                                                }
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(history.NewFacility) || !string.IsNullOrWhiteSpace(history.NewRoom))
                                            {
                                                <div class="text-secondary mt-1">
                                                    From <strong>@history.PreviousFacility - @history.PreviousRoom</strong>
                                                    @if (!string.IsNullOrWhiteSpace(history.NewFacility) || !string.IsNullOrWhiteSpace(history.NewRoom))
                                                    {
                                                        <strong> → @history.NewFacility - @history.NewRoom</strong>
                                                    }
                                                </div>
                                            }
                                            <small class="text-muted">Transferred by: @history.TransferredBy</small><br />
                                            <small class="text-muted">@history.TransferDate?.ToString("MMM dd, yyyy hh:mm tt")</small>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                    </div>
                }

            </div>
        </div>
    </div>
</div>