@model PropertyManagementSystem.Models.ReservationViewModel
@inject PropertyManagementSystem.Services.IRoleService RoleService
@{
    var employee = await RoleService.GetUserName(User);
    var firstDetail = Model.ReservationDetails?.FirstOrDefault();
    var applicantCivilStatus = DormHousingEligibilityPolicy.NormalizeCivilStatus(employee?.MaritalStatus);
    var applicantCivilStatusLabel = DormHousingEligibilityPolicy.GetCivilStatusLabel(applicantCivilStatus);
    var canApplyForHousing = DormHousingEligibilityPolicy.CanApplyForUnit(
        applicantCivilStatus,
        DormHousingEligibilityPolicy.HousingUnit);
}
<div class="card-header reservation-update-trigger-bar">
    <button type="button" class="btn btn-primary ms-auto" data-bs-toggle="modal" data-bs-target="#modal-update">
        <i class="ti ti-pencil" aria-hidden="true"></i>
        Edit Application
    </button>
</div>
<partial name="~/Views/Dorm/Shared/_reservationDetails.cshtml" model="Model" />
<div class="card-body legacy-module-summary" hidden>
    <div class="row align-items-start">
        <div class="col-2">
            <img src="@Url.Content("~/img/dorm-room.jpg")" alt="Accommodation" class="rounded img-fluid">
        </div>
        <div class="col-9">
            <div class="text-primary h3 d-flex align-items-center">
                <span>@Model.ReservationHeader.ReservationCode</span>

                <span class="ms-3">

                    @if (Model.ReservationHeader.Status == "APPROVED")
                    {
                        <span class='status status-teal'>
                            <span class='status-dot status-dot-animated'></span>@Model.ReservationHeader.Status
                        </span>
                    }
                    else if (Model.ReservationHeader.Status == "FOR DEPARTMENT HEAD'S APPROVAL" || Model.ReservationHeader.Status == "FOR ADMIN APPROVER'S APPROVAL" || Model.ReservationHeader.Status == "FOR ADMIN MANAGER'S APPROVAL")
                    {
                        <span class='status status-teal'>
                            <span class='status-dot status-dot-animated'></span>FOR APPROVAL
                        </span>
                    }
                    else if (Model.ReservationHeader.Status == "CANCELLED" || Model.ReservationHeader.Status == "DISAPPROVED")
                    {
                        <span class='status status-red'>
                            <span class='status-dot status-dot-animated'></span>@Model.ReservationHeader.Status
                        </span>
                    }
                    else
                    {
                        <span class='status status-blue'>
                            <span class='status-dot status-dot-animated'></span>@Model.ReservationHeader.Status
                        </span>
                    }
                </span>
            </div>

            <div class="row mt-3">
                <div class="col-lg-3 col-md-6 mb-4">
                    <div class="datagrid-item">
                        <div class="datagrid-title text-primary">Requestor</div>
                        <div class="datagrid-content">@Model.ReservationHeader.Requestor</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 mb-4">
                    <div class="datagrid-item">
                        <div class="datagrid-title text-primary">Email</div>
                        <div class="datagrid-content">@Model.ReservationHeader.RequestorEmail</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 mb-4">
                    <div class="datagrid-item">
                        <div class="datagrid-title text-primary">Department</div>
                        <div class="datagrid-content">@Model.Department.DepartmentCode</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 mb-4">
                    <div class="datagrid-item">
                        <div class="datagrid-title text-primary">Contact Number</div>
                        <div class="datagrid-content">@(string.IsNullOrWhiteSpace(firstDetail?.ContactNumber) ? "Not provided" : $"+63 {firstDetail.ContactNumber}")</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 mb-4">
                    <div class="datagrid-item">
                        <div class="datagrid-title text-primary">Date Filed</div>
                        <div class="datagrid-content">@Model.ReservationHeader.DateFiled</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 mb-4">
                    <div class="datagrid-item">
                        <div class="datagrid-title text-primary">Schedule Type</div>
                        @if (firstDetail?.ScheduleType == 0)
                        {
                            <div class="datagrid-content">Regular</div>
                        }
                        else
                        {
                            <div class="datagrid-content">Shifting</div>
                        }
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 mb-4">
                    <div class="datagrid-item">
                        <div class="datagrid-title text-primary">Applied Unit</div>
                        @if (firstDetail?.AppliedUnit == 0)
                        {
                            <div class="datagrid-content">Dorm</div>
                        }
                        else
                        {
                            <div class="datagrid-content">Housing</div>
                        }
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 mb-4">
                    <div class="datagrid-item">
                        <div class="datagrid-title text-primary">Number of Dependents</div>
                        <div class="datagrid-content">@Model.ReservationDetails.Count()</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 mb-4">
                    <div class="datagrid-item">
                        <div class="datagrid-title text-primary">Letter of Intent</div>
                        <div class="datagrid-content">
                            <a href="@firstDetail?.FileAttachment" target="_blank">
                                @firstDetail?.FileAttachment
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@if (firstDetail?.FacilityId is int facilityId && facilityId != 0)
{
    <div class="accordion legacy-module-details" id="accordion-example" hidden>
        <div class="accordion-item">
            <h2 class="accordion-header" id="heading-1">
                <button class="accordion-button " type="button" data-bs-toggle="collapse" data-bs-target="#collapse-1" aria-expanded="true">
                    ROOM DETAILS
                </button>
            </h2>
            <div id="collapse-1" class="accordion-collapse collapse show" data-bs-parent="#accordion-example">
                <div class="accordion-body pt-0">
                    <div class="card-body">
                        <div class="row align-items-start">
                            <div class="col-2">
                            </div>
                            <div class="col-9">
                                <div class="row mt-3">
                                    <div class="col-lg-3 col-md-6 mb-4">
                                        <div class="datagrid-item">
                                            <div class="datagrid-title text-primary">Dorm Number</div>
                                            <div class="datagrid-content">@Model.Facility.FacilityName </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-3 col-md-6 mb-4">
                                        <div class="datagrid-item">
                                            <div class="datagrid-title text-primary">Room Number</div>

                                            <div class="datagrid-content">@Model.Room.RoomName</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<form asp-action="UpdateReservationStatus" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="ReservationDetailId" value="@firstDetail?.ReservationDetailId">
    <input type="hidden" name="ReservationId" value="@firstDetail?.ReservationId">
    <div class="card-footer d-flex justify-content-between align-items-center">
        <a href="@Url.Action("ReservationList", "Dorm")" class="btn btn-link link-secondary">
            Go Back
        </a>
        <div class="ms-auto">
            @if (Model.ReservationHeader.Requestor == employee.Fullname && Model.ReservationHeader.Status != "CANCELLED" && Model.ReservationHeader.Status != "DISAPPROVED")
            {

                <button type="button" class="btn btn-red m-1" data-bs-toggle="modal" data-bs-target="#modal-danger">
                    <span>
                        <i class="ti ti-x m-1"></i>
                    </span>
                    Cancel
                </button>
            }
        </div>
    </div>
</form>
@*ASSIGN FACILITY MODAL*@
@foreach (var detail in Model.ReservationDetails)
{
    <div class="modal modal-blur fade" id="modal-update" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered update-workflow-dialog" role="document">
            <div class="modal-content update-workflow-modal">
                <div class="modal-header">
                    <div class="update-workflow-heading">
                        <span class="update-workflow-icon" aria-hidden="true"><i class="ti ti-home-edit"></i></span>
                        <div>
                            <span class="reservation-eyebrow">Dorm and housing</span>
                            <h5 class="modal-title">Edit Application</h5>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-action="UpdateReservationDetails" asp-controller="Dorm" method="post" class="update-workflow-form">
                    <input type="hidden" name="reservationId" value="@Model.ReservationHeader.ReservationId">
                    <input type="hidden" name="_civilStat" value="@applicantCivilStatus">
                    <input type="hidden" class="form-control" name="@Model.ReservationDetails.FirstOrDefault().ReservationDetailId" asp-for="@Model.ReservationDetails.FirstOrDefault().ReservationDetailId">
                    <div class="modal-body update-workflow-body">
                        <div id="dynamic-rows">
                            <div class="row">
                                <div class="col-lg-12">
                                    <div class="card">
                                        <div class="card-header">
                                            <h3 class="card-title">Applicant Details</h3>
                                        </div>
                                        <div class="card-body">
                                            <div class="alert @(canApplyForHousing ? "alert-success" : "alert-info") mb-3" role="status">
                                                <strong>Civil status on your employee profile: @applicantCivilStatusLabel</strong>
                                                <div class="mt-1">
                                                    @(canApplyForHousing
                                                        ? "You may apply for either Dorm or Housing."
                                                        : "You may apply for Dorm. Housing is available only when your profile shows Married.")
                                                </div>
                                            </div>
                                            <div class="form-selectgroup-boxes row mb-3">
                                                <div class="col-lg-6">
                                                    <label class="form-selectgroup-item">
                                                        <input type="radio" name="_unitApplied" value="0" class="form-selectgroup-input" asp-for="@Model.ReservationDetails.FirstOrDefault().AppliedUnit">
                                                        <span class="form-selectgroup-label d-flex align-items-center p-3">
                                                            <span class="me-3">
                                                                <span class="form-selectgroup-check"></span>
                                                            </span>
                                                            <span class="form-selectgroup-label-content">
                                                                <span class="form-selectgroup-title strong mb-1">Dorm</span>
                                                                <span class="form-selectgroup-description">Available for Single and Married employees</span>
                                                            </span>
                                                        </span>
                                                    </label>
                                                </div>
                                                <div class="col-lg-6">
                                                    <label class="form-selectgroup-item @(canApplyForHousing ? string.Empty : "opacity-50")">
                                                        <input type="radio" name="_unitApplied" value="1" class="form-selectgroup-input" asp-for="@Model.ReservationDetails.FirstOrDefault().AppliedUnit" disabled="@(canApplyForHousing ? null : "disabled")">
                                                        <span class="form-selectgroup-label d-flex align-items-center p-3">
                                                            <span class="me-3">
                                                                <span class="form-selectgroup-check"></span>
                                                            </span>
                                                            <span class="form-selectgroup-label-content">
                                                                <span class="form-selectgroup-title strong mb-1">Housing</span>
                                                                <span class="form-selectgroup-description">
                                                                    @(canApplyForHousing ? "Available based on your Married status" : "Available only when civil status is Married")
                                                                </span>
                                                            </span>
                                                        </span>
                                                    </label>
                                                </div>
                                            </div>
                                            <div class="row mb-3">
                                                <div class="col-lg-6">
                                                    <label class="form-label">Schedule Type</label>
                                                    <div class="form-selectgroup-boxes row mb-3">
                                                        <div class="col-lg-4">
                                                            <label class="form-selectgroup-item">
                                                                <input type="radio" name="_schedType" id="regularRadio" value="0" class="form-selectgroup-input" asp-for="@Model.ReservationDetails.FirstOrDefault().ScheduleType">
                                                                <span class="form-selectgroup-label d-flex align-items-center p-2">
                                                                    <span class="me-3">
                                                                        <span class="form-selectgroup-check"></span>
                                                                    </span>
                                                                    <span class="form-selectgroup-label-content">
                                                                        <span class="form-selectgroup-title strong mb-1">Regular</span>
                                                                    </span>
                                                                </span>
                                                            </label>
                                                        </div>
                                                        <div class="col-lg-3">
                                                            <label class="form-selectgroup-item">
                                                                <input type="radio" name="_schedType" value="1" id="swingRadio" class="form-selectgroup-input" asp-for="@Model.ReservationDetails.FirstOrDefault().ScheduleType">
                                                                <span class="form-selectgroup-label d-flex align-items-center p-2">
                                                                    <span class="me-3">
                                                                        <span class="form-selectgroup-check"></span>
                                                                    </span>
                                                                    <span class="form-selectgroup-label-content">
                                                                        <span class="form-selectgroup-title strong mb-1">Swing</span>
                                                                    </span>
                                                                </span>
                                                            </label>
                                                        </div>
                                                        <div class="col-lg-5">
                                                            <label class="form-selectgroup-item">
                                                                <input type="radio" name="_schedType" value="2" id="gyRadio" class="form-selectgroup-input" asp-for="@Model.ReservationDetails.FirstOrDefault().ScheduleType">
                                                                <span class="form-selectgroup-label d-flex align-items-center p-2">
                                                                    <span class="me-3">
                                                                        <span class="form-selectgroup-check"></span>
                                                                    </span>
                                                                    <span class="form-selectgroup-label-content">
                                                                        <span class="form-selectgroup-title strong mb-1">Graveyard</span>
                                                                    </span>
                                                                </span>
                                                            </label>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-lg-6">
                                                    <label class="form-label">
                                                        Contact Number
                                                    </label>
                                                    <div class="input-group pb-2">
                                                        <span class="input-group-text">
                                                            +63
                                                        </span>
                                                        <input type="text" class="form-control pb-2" name="_contactNumber" placeholder="Contact Number" asp-for="@Model.ReservationDetails.FirstOrDefault().ContactNumber" maxlength="10">
                                                    </div>

                                                </div>
                                            </div>
                                            <div class="row mb-3">
                                                <div class="col-lg-12">
                                                    <div>
                                                        <label class="form-label">
                                                            Permanent Home Address
                                                        </label>
                                                        <input type="text" class="form-control" name="_permanentAdd" placeholder="Permanent Home Address" asp-for="@Model.ReservationDetails.FirstOrDefault().PermanentAddress">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row mb-5">
                                                <div class="col-lg-12">
                                                    <div>
                                                        <label class="form-label">
                                                            Current Home Address
                                                        </label>
                                                        <input type="text" class="form-control" name="_currentAdd" placeholder="Current Home Address" asp-for="@Model.ReservationDetails.FirstOrDefault().CurrentAddress">
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="card mt-3">
                                        <div class="card-header">
                                            <h3 class="card-title">Home and Transportation Details</h3>
                                        </div>
                                        <div class="card-body">
                                            <div class="row mb-3">
                                                <div class="col-lg-6">
                                                    <label class="form-label">Home Ownership</label>
                                                    <div class="form-selectgroup-boxes row mb-3">
                                                        <div class="col-lg-4">
                                                            <label class="form-selectgroup-item">
                                                                <input type="radio" name="_homeOwnership" id="ownedRadio" value="0" class="form-selectgroup-input" asp-for="@Model.ReservationDetails.FirstOrDefault().HomeOwnership">
                                                                <span class="form-selectgroup-label d-flex align-items-center p-3">
                                                                    <span class="me-3">
                                                                        <span class="form-selectgroup-check"></span>
                                                                    </span>
                                                                    <span class="form-selectgroup-label-content">
                                                                        <span class="form-selectgroup-title strong mb-1">Owned</span>
                                                                    </span>
                                                                </span>
                                                            </label>
                                                        </div>
                                                        <div class="col-lg-3">
                                                            <label class="form-selectgroup-item">
                                                                <input type="radio" name="_homeOwnership" value="1" id="rentedRadio" class="form-selectgroup-input" asp-for="@Model.ReservationDetails.FirstOrDefault().HomeOwnership">
                                                                <span class="form-selectgroup-label d-flex align-items-center p-3">
                                                                    <span class="me-3">
                                                                        <span class="form-selectgroup-check"></span>
                                                                    </span>
                                                                    <span class="form-selectgroup-label-content">
                                                                        <span class="form-selectgroup-title strong mb-1">Rented</span>
                                                                    </span>
                                                                </span>
                                                            </label>
                                                        </div>
                                                        <div class="col-lg-5">
                                                            <label class="form-selectgroup-item">
                                                                <input type="radio" name="_homeOwnership" value="2" id="livingWithParentsRadio" class="form-selectgroup-input" asp-for="@Model.ReservationDetails.FirstOrDefault().HomeOwnership">
                                                                <span class="form-selectgroup-label d-flex align-items-center p-3">
                                                                    <span class="me-3">
                                                                        <span class="form-selectgroup-check"></span>
                                                                    </span>
                                                                    <span class="form-selectgroup-label-content">
                                                                        <span class="form-selectgroup-title strong mb-1">Living with Family</span>
                                                                    </span>
                                                                </span>
                                                            </label>
                                                        </div>
                                                    </div>
                                                    <div>
                                                        <label class="form-label">Location of Owned House</label>
                                                        <div class="form-selectgroup-boxes row mb-3">
                                                            <div class="col-lg-6">
                                                                <label class="form-selectgroup-item">
                                                                    <input type="radio" id="ownedHouseLocWithin" name="_ownedLocation" value="0" class="form-selectgroup-input" asp-for="@Model.ReservationDetails.FirstOrDefault().OwnedHouseLocation">
                                                                    <span class="form-selectgroup-label d-flex align-items-center p-2">
                                                                        <span class="me-3">
                                                                            <span class="form-selectgroup-check"></span>
                                                                        </span>
                                                                        <span class="form-selectgroup-label-content">
                                                                            <span class="form-selectgroup-title strong mb-1">Within Pampanga</span>
                                                                        </span>
                                                                    </span>
                                                                </label>
                                                            </div>
                                                            <div class="col-lg-6">
                                                                <label class="form-selectgroup-item">
                                                                    <input type="radio" id="ownedHouseLocOutside" name="_ownedLocation" value="1" class="form-selectgroup-input" asp-for="@Model.ReservationDetails.FirstOrDefault().OwnedHouseLocation">
                                                                    <span class="form-selectgroup-label d-flex align-items-center p-2">
                                                                        <span class="me-3">
                                                                            <span class="form-selectgroup-check"></span>
                                                                        </span>
                                                                        <span class="form-selectgroup-label-content">
                                                                            <span class="form-selectgroup-title strong mb-1">Outside Pampanga</span>
                                                                        </span>
                                                                    </span>
                                                                </label>
                                                            </div>
                                                        </div>
                                                        <div class="row mb-3">
                                                            <div class="col">
                                                                <label class="form-label">Specific Location</label>
                                                                <input type="text" id="specificLoc" class="form-control" name="_specificLocation" placeholder="Specific Location" asp-for="@Model.ReservationDetails.FirstOrDefault().SpecificLocation">
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <input type="hidden" id="add-row"></input>
                                                <div class="col-lg-6">
                                                    <label class="form-label">Mode of Transportation</label>
                                                    <div class="form-selectgroup-boxes row mb-3">
                                                        <div class="col-lg-6">
                                                            <label class="form-selectgroup-item">
                                                                <input type="radio" id="ownVehicle" name="_modeOfTransport" value="0" class="form-selectgroup-input" asp-for="@Model.ReservationDetails.FirstOrDefault().ModeOfTransportation">
                                                                <span class="form-selectgroup-label d-flex align-items-center p-3">
                                                                    <span class="me-3">
                                                                        <span class="form-selectgroup-check"></span>
                                                                    </span>
                                                                    <span class="form-selectgroup-label-content">
                                                                        <span class="form-selectgroup-title strong mb-1">Own Vehicle</span>
                                                                    </span>
                                                                </span>
                                                            </label>
                                                        </div>
                                                        <div class="col-lg-6">
                                                            <label class="form-selectgroup-item">
                                                                <input type="radio" id="commute" name="_modeOfTransport" value="1" class="form-selectgroup-input" asp-for="@Model.ReservationDetails.FirstOrDefault().ModeOfTransportation">
                                                                <span class="form-selectgroup-label d-flex align-items-center p-3">
                                                                    <span class="me-3">
                                                                        <span class="form-selectgroup-check"></span>
                                                                    </span>
                                                                    <span class="form-selectgroup-label-content">
                                                                        <span class="form-selectgroup-title strong mb-1">Commute</span>
                                                                    </span>
                                                                </span>
                                                            </label>
                                                        </div>
                                                    </div>
                                                    <div>
                                                        <div class="row mb-4">
                                                            <div class="col">
                                                                <label class="form-label mb-2">Type of Vehicle</label>
                                                                <input type="text" id="vehicleType" class="form-control" name="_vehicleType" placeholder="Type of Vehicle" asp-for="@Model.ReservationDetails.FirstOrDefault().VehicleType">
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div>
                                                        <div class="row mb-3">
                                                            <div class="col-lg-6">
                                                                <label class="form-label">Travel Time</label>
                                                                <input type="text" id="travelTime" class="form-control" name="_travelTime" placeholder="Travel Time" asp-for="@Model.ReservationDetails.FirstOrDefault().TravelTime">
                                                            </div>
                                                            <div class="col-lg-6">
                                                                <label class="form-label">Fare</label>
                                                                <input type="text" id="fare" class="form-control" name="_fare" placeholder="Fare" asp-for="@Model.ReservationDetails.FirstOrDefault().Fare" value="@Model.ReservationDetails.FirstOrDefault().Fare">
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="card mt-3 mb-3">
                                        <div class="card-header">
                                            <h3 class="card-title">Dependents</h3>
                                        </div>
                                        <div class="card-body">
                                            <label class="form-label">Civil Status</label>
                                            <div class="border rounded p-3 mb-3 bg-light">
                                                <div class="d-flex align-items-center gap-2">
                                                    <i class="ti ti-id-badge-2 text-primary" aria-hidden="true"></i>
                                                    <div>
                                                        <strong>@applicantCivilStatusLabel</strong>
                                                        <div class="text-secondary small">Retrieved from your employee profile and used to determine Housing eligibility.</div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div id="dynamic-rows-dependent-label">
                                                <label class="form-label">Dependents</label>
                                                <div class="row mb-3">
                                                    <div class="col-lg-2">
                                                        <label class="form-label">Name</label>
                                                    </div>
                                                    <div class="col-lg-1">
                                                        <label class="form-label">Age</label>
                                                    </div>
                                                    <div class="col-lg-4">
                                                        <label class="form-label">Other Information</label>
                                                    </div>
                                                    <div class="col-lg-2" id="position1">
                                                        <label class="form-label">Position</label>
                                                    </div>
                                                    <div class="col-lg-2" id="location1">
                                                        <label class="form-label">Name of School</label>
                                                    </div>

                                                </div>
                                            </div>
                                            <div id="dynamic-rows-dependent">
                                                @for (int i = 0; i < Model.ReservationDetails.Count; i++)
                                                {
                                                    var detail = Model.ReservationDetails[i];
                                                    <div class="row mb-3 original-row">
                                                        <div class="col-lg-2">
                                                            <input type="text" class="form-control" name="_dependents[]" placeholder="Name" value="@detail.DependentName">
                                                        </div>
                                                        <div class="col-lg-1">
                                                            <input type="text" class="form-control" name="_age[]" placeholder="Age" value="@detail.DependentAge">
                                                        </div>
                                                        <div class="col-lg-2">
                                                            <label class="form-selectgroup-item">
                                                                <input type="radio" name="_dependent_status[@i]" value="studying" class="form-selectgroup-input" @(detail.OtherInfo == "studying" ? "checked" : "")>
                                                                <span class="form-selectgroup-label d-flex align-items-center p-2">
                                                                    <span class="me-3">
                                                                        <span class="form-selectgroup-check"></span>
                                                                    </span>
                                                                    <span class="form-selectgroup-label-content">
                                                                        <span class="form-selectgroup-title strong mb-1">Studying</span>
                                                                    </span>
                                                                </span>
                                                            </label>
                                                        </div>
                                                        <div class="col-lg-2">
                                                            <label class="form-selectgroup-item">
                                                                <input type="radio" name="_dependent_status[@i]" value="working" class="form-selectgroup-input" @(detail.OtherInfo == "working" ? "checked" : "")>
                                                                <span class="form-selectgroup-label d-flex align-items-center p-2">
                                                                    <span class="me-3">
                                                                        <span class="form-selectgroup-check"></span>
                                                                    </span>
                                                                    <span class="form-selectgroup-label-content">
                                                                        <span class="form-selectgroup-title strong mb-1">Working</span>
                                                                    </span>
                                                                </span>
                                                            </label>
                                                        </div>
                                                        <div class="col-lg-2" id="position">
                                                            <input type="text" class="form-control" name="_position[]" placeholder="Position" value="@detail.WorkPosition">
                                                        </div>
                                                        <div class="col-lg-2" id="location">
                                                            <input type="text" class="form-control" name="_location[]" placeholder="Name of School" value="@detail.StudyLocation">
                                                        </div>
                                                        <div class="col-sm-1 d-flex align-items-end">
                                                            <button type="button" id="add-dependent" class="btn btn-primary ml-2 custom-padding">
                                                                <i class="ti ti-plus"></i>
                                                            </button>
                                                            <button type="button" class="btn btn-danger remove-row ml-2 custom-padding">
                                                                <i class="ti ti-trash"></i>
                                                            </button>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                            <div class="col-lg-12">
                                                <div>
                                                    <label class="form-label">
                                                        Attach Letter of Intent
                                                    </label>
                                                    @(Html.Kendo().Upload()
                                                        .Name("files")
                                                        .Async(a => a
                                                        .Save("Upload", "Dorm")
                                                        .Remove("Remove", "Dorm")
                                                        .AutoUpload(true)
                                                        )
                                                        .DropZone(".dropZoneElement")
                                                        .Events(e => e
                                                        .Upload("onUpload")
                                                        .Success("onSuccess")
                                                        .Error("onError")
                                                        )
                                                        )
                                                </div>
                                            </div>

                                            <input type="hidden" name="filePath" id="filePath" value="@Model.ReservationDetails.FirstOrDefault()?.FileAttachment" />

                                            <div id="uploadedFilesLinks">
                                                <ul id="fileLinksList">
                                                    @if (!string.IsNullOrEmpty(Model.ReservationDetails.FirstOrDefault()?.FileAttachment))
                                                    {
                                                        <li>
                                                            <a href="@Model.ReservationDetails.FirstOrDefault().FileAttachment" target="_blank" rel="noopener noreferrer">
                                                                @Model.ReservationDetails.FirstOrDefault().FileAttachment
                                                            </a>
                                                        </li>
                                                    }
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer update-workflow-footer">
                        <button type="button" data-bs-dismiss="modal" class="btn btn-outline-secondary">
                            Cancel
                        </button>
                        <div class="ms-auto">
                            @if (Model.ReservationHeader.Status != "CANCELLED" && Model.ReservationHeader.Status != "DISAPPROVED" && Model.ReservationHeader.Status != "APPROVED")
                            {
                                <button type="submit" class="btn btn-primary ms-auto">
                                    <i class="ti ti-device-floppy" aria-hidden="true"></i>
                                    Save Changes
                                </button>
                            }
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
@*END OF MODAL*@
@*CANCEL MODAL*@
<div class="modal modal-blur fade" id="modal-danger" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-md modal-dialog-centered" role="document">
        <div class="modal-content">
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            <div class="modal-status bg-danger"></div>
            <div class="modal-body text-center py-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="icon mb-2 text-danger icon-lg" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M12 9v4" /><path d="M10.363 3.591l-8.106 13.534a1.914 1.914 0 0 0 1.636 2.871h16.214a1.914 1.914 0 0 0 1.636 -2.87l-8.106 -13.536a1.914 1.914 0 0 0 -3.274 0z" /><path d="M12 16h.01" /></svg>
                <h3>Are you sure?</h3>
                <div class="text-secondary">Do you really want to disapprove this reservation? This action cannot be undone.</div>
            </div>
            <form asp-action="UpdateReservationStatus" method="post">
                @Html.AntiForgeryToken()
                <div class="m-1">
                    <div>
                        <label class="form-label">Reason <span class="form-label-description"></span></label>
                        <textarea class="form-control" rows="2" name="Remarks" required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <div class="w-100">
                        <input type="hidden" value="@Model.ReservationHeader.Status" />
                        <div class="row">
                            <div class="col">
                                <a href="#" class="btn w-100" data-bs-dismiss="modal">
                                    Go Back
                                </a>
                            </div>
                            <div class="col">
                                <button type="submit" name="action" value="Reject" class="btn btn-danger w-100">
                                    <i class="ti ti-ban m-1"></i> Disapprove
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                <input type="hidden" name="ReservationId" value="@firstDetail?.ReservationId" />
            </form>
        </div>
    </div>
</div>
@*CANCEL DELETE MODAL*@
