@model PropertyManagementSystem.Models.ReservationViewModel
<div class="card-body">
    <div class="row align-items-start">
        <div class="col-2">
        </div>
        <div class="col-9">
            <div class="row mt-3">
                <!-- Rest of the content remains the same -->
                <div class="col-lg-3 col-md-6 mb-4">
                    <div class="datagrid-item">
                        <div class="datagrid-title text-primary">Current Position</div>
                        @if (Model.Position != null && Model.Position.PositionName != null)
                        {
                            <div class="datagrid-content">@Model.Position.PositionName</div>
                        }
                        else
                        {
                            <div class="datagrid-content"> - </div>
                        }

                        
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 mb-4">
                    <div class="datagrid-item">
                        <div class="datagrid-title text-primary">Employment Level</div>
                        @if (Model.EmploymentLevel != null && Model.EmploymentLevel.Name != null)
                        {
                            <div class="datagrid-content">@Model.EmploymentLevel.Name</div>
                        }
                        else
                        {
                            <div class="datagrid-content"> - </div>
                        }

                        
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 mb-4">
                    <div class="datagrid-item">
                        <div class="datagrid-title text-primary">Is Critical on Operations?</div>
                        @if (Model.ReservationDetails.FirstOrDefault().isCritical != null)
                        {
                            @if (Model.ReservationDetails.FirstOrDefault().isCritical == true)
                            {
                                <div class="datagrid-content">
                                    <span class="status status-green">
                                        Yes
                                    </span>
                                </div>
                            }
                            else
                            {
                                <span class="status status-red">
                                    No
                                </span>
                            }
                        }
                        else
                        {
                            <div class="datagrid-content"> - </div>
                        }
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 mb-4">
                    <div class="datagrid-item">
                        <div class="datagrid-title text-primary">Is On Call?</div>
                        @if (Model.ReservationDetails.FirstOrDefault().isOnCall != null)
                        {
                            @if (Model.ReservationDetails.FirstOrDefault().isOnCall == true)
                            {
                                <div class="datagrid-content">
                                    <span class="status status-green">
                                        Yes
                                    </span>
                                </div>
                            }
                            else
                            {
                                <span class="status status-red">
                                    No
                                </span>
                            }
                        }
                        else
                        {
                            <div class="datagrid-content"> - </div>
                        }

                    </div>
                </div>
                <div class="col-lg-3 col-md-6 mb-4">
                    <div class="datagrid-item">
                        <div class="datagrid-title text-primary">Department Head Remarks</div>
                        @if (Model.ReservationDetails.FirstOrDefault().DeptHeadRemarks != null)
                        {
                            <div class="datagrid-content">@Model.ReservationDetails.FirstOrDefault().DeptHeadRemarks</div>
                        }else{
                            <div class="datagrid-content"> - </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>