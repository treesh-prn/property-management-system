@model PropertyManagementSystem.Models.ReservationViewModel;

<form asp-action="CreateReservationDetails" asp-controller="Dorm" method="post">
    <input type="hidden" class="form-control" name="_reservationId" asp-for="ReservationHeader.ReservationId">
    <div class="container container-lg mt-3">
        <div id="dynamic-rows">
            <div class="row">
                <div class="col-lg-8">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">Applicant Details</h3>
                        </div>
                        <div class="card-body">
                            <div class="form-selectgroup-boxes row mb-3">
                                <div class="col-lg-6">
                                    <label class="form-selectgroup-item">
                                        <input type="radio" name="_unitApplied" value="0" class="form-selectgroup-input" checked>
                                        <span class="form-selectgroup-label d-flex align-items-center p-3">
                                            <span class="me-3">
                                                <span class="form-selectgroup-check"></span>
                                            </span>
                                            <span class="form-selectgroup-label-content">
                                                <span class="form-selectgroup-title strong mb-1">Dorm</span>
                                            </span>
                                        </span>
                                    </label>
                                </div>
                                <div class="col-lg-6">
                                    <label class="form-selectgroup-item">
                                        <input type="radio" name="_unitApplied" value="1" class="form-selectgroup-input">
                                        <span class="form-selectgroup-label d-flex align-items-center p-3">
                                            <span class="me-3">
                                                <span class="form-selectgroup-check"></span>
                                            </span>
                                            <span class="form-selectgroup-label-content">
                                                <span class="form-selectgroup-title strong mb-1">Housing</span>
                                            </span>
                                        </span>
                                    </label>
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-lg-6">
                                    <label class="form-label">Schedule Type</label>
                                    <div class="form-selectgroup-boxes row mb-3">
                                        <div class="col-lg-4">
                                            <label class="form-selectgroup-item">
                                                <input type="radio" name="_schedType" id="regularRadio" value="0" class="form-selectgroup-input">
                                                <span class="form-selectgroup-label d-flex align-items-center p-2">
                                                    <span class="me-3">
                                                        <span class="form-selectgroup-check"></span>
                                                    </span>
                                                    <span class="form-selectgroup-label-content">
                                                        <span class="form-selectgroup-title strong mb-1">Regular</span>
                                                    </span>
                                                </span>
                                            </label>
                                        </div>
                                        <div class="col-lg-3">
                                            <label class="form-selectgroup-item">
                                                <input type="radio" name="_schedType" value="1" id="swingRadio" class="form-selectgroup-input">
                                                <span class="form-selectgroup-label d-flex align-items-center p-2">
                                                    <span class="me-3">
                                                        <span class="form-selectgroup-check"></span>
                                                    </span>
                                                    <span class="form-selectgroup-label-content">
                                                        <span class="form-selectgroup-title strong mb-1">Swing</span>
                                                    </span>
                                                </span>
                                            </label>
                                        </div>
                                        <div class="col-lg-5">
                                            <label class="form-selectgroup-item">
                                                <input type="radio" name="_schedType" value="2" id="gyRadio" class="form-selectgroup-input">
                                                <span class="form-selectgroup-label d-flex align-items-center p-2">
                                                    <span class="me-3">
                                                        <span class="form-selectgroup-check"></span>
                                                    </span>
                                                    <span class="form-selectgroup-label-content">
                                                        <span class="form-selectgroup-title strong mb-1">Graveyard</span>
                                                    </span>
                                                </span>
                                            </label>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-6">
                                    <label class="form-label">
                                        Contact Number
                                    </label>
                                    <div class="input-group pb-2">
                                        <span class="input-group-text">
                                            +63
                                        </span>
                                        <input type="text" class="form-control pb-2" name="_contactNumber" placeholder="Contact Number" asp-for="@Model.ReservationDetails.FirstOrDefault().ContactNumber" maxlength="10">
                                    </div>

                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-lg-6">
                                    <div>
                                        <label class="form-label">
                                            Permanent Home Address
                                        </label>
                                        <input type="text" class="form-control" name="_permanentAdd" placeholder="Permanent Home Address">
                                    </div>
                                </div>
                                <div class="col-lg-6">
                                    <div>
                                        <label class="form-label">
                                            Current Home Address
                                        </label>
                                        <input type="text" class="form-control" name="_currentAdd" placeholder="Current Home Address">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card mt-3">
                        <div class="card-header">
                            <h3 class="card-title">Home and Transportation Details</h3>
                        </div>
                        <div class="card-body">
                            <div class="row mb-3">
                                <div class="col-lg-6">
                                    <label class="form-label">Home Ownership</label>
                                    <div class="form-selectgroup-boxes row mb-3">
                                        <div class="col-lg-4">
                                            <label class="form-selectgroup-item">
                                                <input type="radio" name="_homeOwnership" id="ownedRadio" value="0" class="form-selectgroup-input">
                                                <span class="form-selectgroup-label d-flex align-items-center p-3">
                                                    <span class="me-3">
                                                        <span class="form-selectgroup-check"></span>
                                                    </span>
                                                    <span class="form-selectgroup-label-content">
                                                        <span class="form-selectgroup-title strong mb-1">Owned</span>
                                                    </span>
                                                </span>
                                            </label>
                                        </div>
                                        <div class="col-lg-3">
                                            <label class="form-selectgroup-item">
                                                <input type="radio" name="_homeOwnership" value="1" id="rentedRadio" class="form-selectgroup-input">
                                                <span class="form-selectgroup-label d-flex align-items-center p-3">
                                                    <span class="me-3">
                                                        <span class="form-selectgroup-check"></span>
                                                    </span>
                                                    <span class="form-selectgroup-label-content">
                                                        <span class="form-selectgroup-title strong mb-1">Rented</span>
                                                    </span>
                                                </span>
                                            </label>
                                        </div>
                                        <div class="col-lg-5">
                                            <label class="form-selectgroup-item">
                                                <input type="radio" name="_homeOwnership" value="2" id="livingWithParentsRadio" class="form-selectgroup-input">
                                                <span class="form-selectgroup-label d-flex align-items-center p-3">
                                                    <span class="me-3">
                                                        <span class="form-selectgroup-check"></span>
                                                    </span>
                                                    <span class="form-selectgroup-label-content">
                                                        <span class="form-selectgroup-title strong mb-1">Living with Family</span>
                                                    </span>
                                                </span>
                                            </label>
                                        </div>
                                    </div>
                                    <div>
                                        <label class="form-label">Location of Owned House</label>
                                        <div class="form-selectgroup-boxes row mb-3">
                                            <div class="col-lg-6">
                                                <label class="form-selectgroup-item">
                                                    <input type="radio" id="ownedHouseLocWithin" name="_ownedLocation" value="0" class="form-selectgroup-input">
                                                    <span class="form-selectgroup-label d-flex align-items-center p-2">
                                                        <span class="me-3">
                                                            <span class="form-selectgroup-check"></span>
                                                        </span>
                                                        <span class="form-selectgroup-label-content">
                                                            <span class="form-selectgroup-title strong mb-1">Within Pampanga</span>
                                                        </span>
                                                    </span>
                                                </label>
                                            </div>
                                            <div class="col-lg-6">
                                                <label class="form-selectgroup-item">
                                                    <input type="radio" id="ownedHouseLocOutside" name="_ownedLocation" value="1" class="form-selectgroup-input">
                                                    <span class="form-selectgroup-label d-flex align-items-center p-2">
                                                        <span class="me-3">
                                                            <span class="form-selectgroup-check"></span>
                                                        </span>
                                                        <span class="form-selectgroup-label-content">
                                                            <span class="form-selectgroup-title strong mb-1">Outside Pampanga</span>
                                                        </span>
                                                    </span>
                                                </label>
                                            </div>
                                        </div>
                                        <div class="row mb-3">
                                            <div class="col">
                                                <label class="form-label">Specific Location</label>
                                                <input type="text" id="specificLoc" class="form-control" name="_specificLocation" placeholder="Specific Location">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <input type="hidden" id="add-row"></input>
                                <div class="col-lg-6">
                                    <label class="form-label">Mode of Transportation</label>
                                    <div class="form-selectgroup-boxes row mb-3">
                                        <div class="col-lg-6">
                                            <label class="form-selectgroup-item">
                                                <input type="radio" id="ownVehicle" name="_modeOfTransport" value="0" class="form-selectgroup-input">
                                                <span class="form-selectgroup-label d-flex align-items-center p-3">
                                                    <span class="me-3">
                                                        <span class="form-selectgroup-check"></span>
                                                    </span>
                                                    <span class="form-selectgroup-label-content">
                                                        <span class="form-selectgroup-title strong mb-1">Own Vehicle</span>
                                                    </span>
                                                </span>
                                            </label>
                                        </div>
                                        <div class="col-lg-6">
                                            <label class="form-selectgroup-item">
                                                <input type="radio" id="commute" name="_modeOfTransport" value="1" class="form-selectgroup-input" asp-for="@Model.ReservationDetails.FirstOrDefault().ModeOfTransportation">
                                                <span class="form-selectgroup-label d-flex align-items-center p-3">
                                                    <span class="me-3">
                                                        <span class="form-selectgroup-check"></span>
                                                    </span>
                                                    <span class="form-selectgroup-label-content">
                                                        <span class="form-selectgroup-title strong mb-1">Commute</span>
                                                    </span>
                                                </span>
                                            </label>
                                        </div>
                                    </div>
                                    <div>
                                        <div class="row mb-4">
                                            <div class="col">
                                                <label class="form-label mb-2">Type of Vehicle</label>
                                                <input type="text" id="vehicleType" class="form-control" name="_vehicleType" placeholder="Type of Vehicle">
                                            </div>
                                        </div>
                                    </div>
                                    <div>
                                        <div class="row mb-3">
                                            <div class="col-lg-6">
                                                <label class="form-label">Travel Time</label>
                                                <input type="text" id="travelTime" class="form-control" name="_travelTime" placeholder="Travel Time">
                                            </div>
                                            <div class="col-lg-6">
                                                <label class="form-label">Fare</label>
                                                <input type="text" id="fare" class="form-control" name="_fare" placeholder="Fare">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card mt-3 mb-3">
                        <div class="card-header">
                            <h3 class="card-title">Dependents</h3>
                        </div>
                        <div class="card-body">
                            <label class="form-label">Civil Status</label>
                            <div class="form-selectgroup-boxes row mb-3">
                                <div class="col-lg-4">
                                    <label class="form-selectgroup-item">
                                        <input type="radio" name="_civilStat" value="SINGLE" class="form-selectgroup-input" checked>
                                        <span class="form-selectgroup-label d-flex align-items-center p-3">
                                            <span class="me-3">
                                                <span class="form-selectgroup-check"></span>
                                            </span>
                                            <span class="form-selectgroup-label-content">
                                                <span class="form-selectgroup-title strong mb-1">Single</span>
                                            </span>
                                        </span>
                                    </label>
                                </div>
                                <div class="col-lg-4">
                                    <label class="form-selectgroup-item">
                                        <input type="radio" name="_civilStat" value="MARRIED" class="form-selectgroup-input">
                                        <span class="form-selectgroup-label d-flex align-items-center p-3">
                                            <span class="me-3">
                                                <span class="form-selectgroup-check"></span>
                                            </span>
                                            <span class="form-selectgroup-label-content">
                                                <span class="form-selectgroup-title strong mb-1">Married</span>

                                            </span>
                                        </span>
                                    </label>
                                </div>
                                <div class="col-lg-4">
                                    <label class="form-selectgroup-item">
                                        <input type="radio" name="_civilStat" value="WIDOWED" class="form-selectgroup-input">
                                        <span class="form-selectgroup-label d-flex align-items-center p-3">
                                            <span class="me-3">
                                                <span class="form-selectgroup-check"></span>
                                            </span>
                                            <span class="form-selectgroup-label-content">
                                                <span class="form-selectgroup-title strong mb-1">Widowed</span>

                                            </span>
                                        </span>
                                    </label>
                                </div>
                            </div>
                            <div id="dynamic-rows-dependent-label">
                                <label class="form-label">Dependents</label>
                                <div class="row mb-3">
                                    <div class="col-lg-2">
                                        <label class="form-label">Name</label>
                                    </div>
                                    <div class="col-lg-1">
                                        <label class="form-label">Age</label>
                                    </div>
                                    <div class="col-lg-4">
                                        <label class="form-label">Other Information</label>
                                    </div>
                                </div>
                            </div>
                            <div id="dynamic-rows-dependent">
                                <div class="row mb-3 original-row">
                                    <div class="col-lg-2">
                                        <input type="text" class="form-control" name="_dependents[]" placeholder="Name">
                                    </div>
                                    <div class="col-lg-1">
                                        <input type="text" class="form-control" name="_age[]" placeholder="Age">
                                    </div>
                                    <div class="col-lg-2">
                                        <label class="form-selectgroup-item">
                                            <input type="radio" name="_dependent_status[0]" value="studying" class="form-selectgroup-input">
                                            <span class="form-selectgroup-label d-flex align-items-center p-2">
                                                <span class="me-3">
                                                    <span class="form-selectgroup-check"></span>
                                                </span>
                                                <span class="form-selectgroup-label-content">
                                                    <span class="form-selectgroup-title strong mb-1">Studying</span>
                                                </span>
                                            </span>
                                        </label>
                                    </div>
                                    <div class="col-lg-2">
                                        <label class="form-selectgroup-item">
                                            <input type="radio" name="_dependent_status[0]" value="working" class="form-selectgroup-input">
                                            <span class="form-selectgroup-label d-flex align-items-center p-2">
                                                <span class="me-3">
                                                    <span class="form-selectgroup-check"></span>
                                                </span>
                                                <span class="form-selectgroup-label-content">
                                                    <span class="form-selectgroup-title strong mb-1">Working</span>
                                                </span>
                                            </span>
                                        </label>
                                    </div>
                                    <div class="col-lg-2">
                                        <input type="text" class="form-control" name="_position[]" placeholder="Position">
                                    </div>
                                    <div class="col-lg-2">
                                        <input type="text" class="form-control" name="_location[]" placeholder="Location">
                                    </div>
                                    <div class="col-sm-1 d-flex align-items-end">
                                        <button type="button" id="add-dependent" class="btn btn-primary ml-2 custom-padding">
                                            <i class="ti ti-plus"></i>
                                        </button>
                                        <button type="button" class="btn btn-danger remove-row ml-2 custom-padding">
                                            <i class="ti ti-trash"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-12">
                                <div>
                                    <label class="form-label">
                                        Attach Letter of Intent
                                    </label>
                                    @(Html.Kendo().Upload()
                                        .Name("files")
                                        .Multiple(true)
                                        .Async(a => a
                                        .Save("Upload", "Dorm")
                                        .Remove("Remove", "Dorm")
                                        .AutoUpload(true)
                                        )
                                        .DropZone(".dropZoneElement")
                                        .Events(e => e
                                        .Success("onSuccess")
                                        .Error("onError")
                                        )
                                        )
                                </div>
                            </div>
                            <input type="hidden" name="filePath" id="filePath" />

                            <div id="uploadedFilesLinks" style="display: none;">
                                <ul id="fileLinksList"></ul>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="card booking-summary">
                        <div class="card-header">
                            <h3 class="card-title">Reservation Summary</h3>
                        </div>
                        <div class="card-body">
                            <div class="row align-items-start">
                                <div class="col-3">
                                    <img src="@Url.Content("~/img/dorm-room.jpg")" alt="Dorm Reservation" class="rounded">
                                </div>
                                <div class="col-9">
                                    <div class="text-primary h4 d-flex align-items-center">
                                        <span>@Model.ReservationHeader.ReservationCode</span>
                                        <span class="ms-3">
                                            @if (Model.ReservationHeader.Status == "APPROVED")
                                            {
                                                <span class='status status-teal'>
                                                    <span class='status-dot status-dot-animated'></span>@Model.ReservationHeader.Status
                                                </span>
                                            }
                                            else if (Model.ReservationHeader.Status == "FOR DEPARTMENT HEAD'S APPROVAL" || Model.ReservationHeader.Status == "FOR ADMIN APPROVER'S APPROVAL" || Model.ReservationHeader.Status == "FOR ADMIN MANAGER'S APPROVAL")
                                            {
                                                <span class='status status-teal'>
                                                    <span class='status-dot status-dot-animated'></span>FOR APPROVAL
                                                </span>
                                            }
                                            else if (Model.ReservationHeader.Status == "CANCELLED" || Model.ReservationHeader.Status == "DISAPPROVED")
                                            {
                                                <span class='status status-red'>
                                                    <span class='status-dot status-dot-animated'></span>@Model.ReservationHeader.Status
                                                </span>
                                            }
                                            else
                                            {
                                                <span class='status status-blue'>
                                                    <span class='status-dot status-dot-animated'></span>@Model.ReservationHeader.Status
                                                </span>
                                            }
                                        </span>
                                    </div>
                                    <div class="row mt-3">
                                        <dl class="row">
                                            <dt class="col-4 text-primary">Requestor:</dt>
                                            <dd class="col-8 ">@Model.ReservationHeader.Requestor</dd>
                                            <dt class="col-4 text-primary">Email:</dt>
                                            <dd class="col-8">@Model.ReservationHeader.RequestorEmail</dd>
                                            <dt class="col-4 text-primary">Department:</dt>
                                            <dd class="col-8"> @Model.Department.DepartmentCode </dd>
                                        </dl>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="card-footer d-flex justify-content-between align-items-center">
        <a href="@Url.Action("ReservationList", "Dorm")" class="btn btn-link link-secondary">
            Go Back
        </a>
        <button id="svbtn15" type="submit" class="btn btn btn-primary ms-auto">
            <!-- Download SVG icon from http://tabler-icons.io/i/plus -->
            <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M12 5l0 14" /><path d="M5 12l14 0" /></svg>
            Create
        </button>
    </div>
</form>