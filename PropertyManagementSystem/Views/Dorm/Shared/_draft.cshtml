@model PropertyManagementSystem.Models.ReservationViewModel
<div class="row">
    <!-- Accommodation Card -->
    <div class="col-md-9">
        <form asp-action="CreateReservationDetails" asp-controller="Dorm" method="post">
            <div class="card">
                <div class="card-body">
                    <input type="hidden" class="form-control" id="_reservationId" name="_reservationId" asp-for="ReservationHeader.ReservationId">
                    <input type="hidden" class="form-control" id="_isForRenewal" name="_isForRenewal" asp-for="ReservationHeader.isForRenewal">
                    <input type="hidden" class="form-control" id="_previousReservationId" name="_previousReservationId" asp-for="ReservationHeader.PreviousReservationId">
                    <div class="container container-lg mt-3">
                        <div id="dynamic-rows">
                            <div class="row">
                                <div class="col-lg-12">
                                    <div class="card">
                                        <div class="card-header">
                                            <h3 class="card-title">Applicant Details</h3>
                                        </div>
                                        <div class="card-body">
                                            <label class="form-label">Civil Status</label>
                                            <div class="form-selectgroup-boxes row mb-3">
                                                <div class="col-lg-4">
                                                    <label class="form-selectgroup-item">
                                                        <input type="radio" name="_civilStat" value="SINGLE" class="form-selectgroup-input" checked>
                                                        <span class="form-selectgroup-label d-flex align-items-center p-3">
                                                            <span class="me-3">
                                                                <span class="form-selectgroup-check"></span>
                                                            </span>
                                                            <span class="form-selectgroup-label-content">
                                                                <span class="form-selectgroup-title strong mb-1">Single</span>
                                                            </span>
                                                        </span>
                                                    </label>
                                                </div>
                                                <div class="col-lg-4">
                                                    <label class="form-selectgroup-item">
                                                        <input type="radio" name="_civilStat" value="MARRIED" class="form-selectgroup-input">
                                                        <span class="form-selectgroup-label d-flex align-items-center p-3">
                                                            <span class="me-3">
                                                                <span class="form-selectgroup-check"></span>
                                                            </span>
                                                            <span class="form-selectgroup-label-content">
                                                                <span class="form-selectgroup-title strong mb-1">Married</span>

                                                            </span>
                                                        </span>
                                                    </label>
                                                </div>
                                                <div class="col-lg-4">
                                                    <label class="form-selectgroup-item">
                                                        <input type="radio" name="_civilStat" value="WIDOWED" class="form-selectgroup-input">
                                                        <span class="form-selectgroup-label d-flex align-items-center p-3">
                                                            <span class="me-3">
                                                                <span class="form-selectgroup-check"></span>
                                                            </span>
                                                            <span class="form-selectgroup-label-content">
                                                                <span class="form-selectgroup-title strong mb-1">Widowed</span>

                                                            </span>
                                                        </span>
                                                    </label>
                                                </div>
                                            </div>
                                            <label class="form-label">Application Type</label>
                                            <div class="form-selectgroup-boxes row mb-3">
                                                <div class="col-lg-6">
                                                    <label class="form-selectgroup-item">
                                                        <input type="radio" name="_unitApplied" value="0" class="form-selectgroup-input" checked>
                                                        <span class="form-selectgroup-label d-flex align-items-center p-3">
                                                            <span class="me-3">
                                                                <span class="form-selectgroup-check"></span>
                                                            </span>
                                                            <span class="form-selectgroup-label-content">
                                                                <span class="form-selectgroup-title strong mb-1">Dorm</span>
                                                            </span>
                                                        </span>
                                                    </label>
                                                </div>

                                                <div class="col-lg-6">
                                                    <label class="form-selectgroup-item">
                                                        <input type="radio" name="_unitApplied" value="1" class="form-selectgroup-input">
                                                        <span class="form-selectgroup-label d-flex align-items-center p-3">
                                                            <span class="me-3">
                                                                <span class="form-selectgroup-check"></span>
                                                            </span>
                                                            <span class="form-selectgroup-label-content">
                                                                <span class="form-selectgroup-title strong mb-1">Housing</span>
                                                            </span>
                                                        </span>
                                                    </label>
                                                </div>
                                            </div>
                                            <div class="row mb-3">
                                                <div class="col-lg-6">
                                                    <label class="form-label">Schedule Type</label>
                                                    <div class="form-selectgroup-boxes row mb-3">
                                                        <div class="col-lg-6">
                                                            <label class="form-selectgroup-item">
                                                                <input type="radio" name="_schedType" id="regularRadio" value="0" class="form-selectgroup-input">
                                                                <span class="form-selectgroup-label d-flex align-items-center p-2">
                                                                    <span class="me-3">
                                                                        <span class="form-selectgroup-check"></span>
                                                                    </span>
                                                                    <span class="form-selectgroup-label-content">
                                                                        <span class="form-selectgroup-title strong mb-1">Regular</span>
                                                                    </span>
                                                                </span>
                                                            </label>
                                                        </div>
                                                        <div class="col-lg-6">
                                                            <label class="form-selectgroup-item">
                                                                <input type="radio" name="_schedType" value="1" id="swingRadio" class="form-selectgroup-input">
                                                                <span class="form-selectgroup-label d-flex align-items-center p-2">
                                                                    <span class="me-3">
                                                                        <span class="form-selectgroup-check"></span>
                                                                    </span>
                                                                    <span class="form-selectgroup-label-content">
                                                                        <span class="form-selectgroup-title strong mb-1">Shifting</span>
                                                                    </span>
                                                                </span>
                                                            </label>
                                                        </div>

                                                    </div>
                                                </div>
                                                <div class="col-lg-6">
                                                    <label class="form-label">
                                                        Contact Number
                                                    </label>
                                                    <div class="input-group pb-2">
                                                        <span class="input-group-text">
                                                            +63
                                                        </span>
                                                        <input type="text" class="form-control pb-2" name="_contactNumber" placeholder="Contact Number" asp-for="@Model.ReservationDetails.FirstOrDefault().ContactNumber" maxlength="10" required>
                                                    </div>

                                                </div>
                                            </div>
                                            <div class="row mb-3">
                                                <div class="col-lg-6">
                                                    <div>
                                                        <label class="form-label">
                                                            Permanent Home Address
                                                        </label>
                                                        <input type="text" class="form-control" name="_permanentAdd" placeholder="Permanent Home Address" required>
                                                    </div>
                                                </div>
                                                <div class="col-lg-6">
                                                    <div>
                                                        <label class="form-label">
                                                            Current Home Address
                                                        </label>
                                                        <input type="text" class="form-control" name="_currentAdd" placeholder="Current Home Address" required>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="card mt-3">
                            <div class="card-header">
                                <h3 class="card-title">Home and Transportation Details</h3>
                            </div>
                            <div class="card-body">
                                <div class="row mb-3">
                                    <div class="col-lg-6">
                                        <label class="form-label">Home Ownership</label>
                                        <div class="form-selectgroup-boxes row mb-3">
                                            <div class="col-lg-4">
                                                <label class="form-selectgroup-item">
                                                    <input type="radio" name="_homeOwnership" id="ownedRadio" value="0" class="form-selectgroup-input">
                                                    <span class="form-selectgroup-label d-flex align-items-center p-3">
                                                        <span class="me-3">
                                                            <span class="form-selectgroup-check"></span>
                                                        </span>
                                                        <span class="form-selectgroup-label-content">
                                                            <span class="form-selectgroup-title strong mb-1">Owned</span>
                                                        </span>
                                                    </span>
                                                </label>
                                            </div>
                                            <div class="col-lg-3">
                                                <label class="form-selectgroup-item">
                                                    <input type="radio" name="_homeOwnership" value="1" id="rentedRadio" class="form-selectgroup-input">
                                                    <span class="form-selectgroup-label d-flex align-items-center p-3">
                                                        <span class="me-3">
                                                            <span class="form-selectgroup-check"></span>
                                                        </span>
                                                        <span class="form-selectgroup-label-content">
                                                            <span class="form-selectgroup-title strong mb-1">Rent</span>
                                                        </span>
                                                    </span>
                                                </label>
                                            </div>
                                            <div class="col-lg-5">
                                                <label class="form-selectgroup-item">
                                                    <input type="radio" name="_homeOwnership" value="2" id="livingWithParentsRadio" class="form-selectgroup-input">
                                                    <span class="form-selectgroup-label d-flex align-items-center p-3">
                                                        <span class="me-3">
                                                            <span class="form-selectgroup-check"></span>
                                                        </span>
                                                        <span class="form-selectgroup-label-content">
                                                            <span class="form-selectgroup-title strong mb-1">Living w/ Family</span>
                                                        </span>
                                                    </span>
                                                </label>
                                            </div>
                                        </div>
                                        <div>
                                            <label class="form-label">Location of Owned House</label>
                                            <div class="form-selectgroup-boxes row mb-3">
                                                <div class="col-lg-6">
                                                    <label class="form-selectgroup-item">
                                                        <input type="radio" id="ownedHouseLocWithin" name="_ownedLocation" value="0" class="form-selectgroup-input">
                                                        <span class="form-selectgroup-label d-flex align-items-center p-2">
                                                            <span class="me-3">
                                                                <span class="form-selectgroup-check"></span>
                                                            </span>
                                                            <span class="form-selectgroup-label-content">
                                                                <span class="form-selectgroup-title strong mb-1">Within Pampanga</span>
                                                            </span>
                                                        </span>
                                                    </label>
                                                </div>
                                                <div class="col-lg-6">
                                                    <label class="form-selectgroup-item">
                                                        <input type="radio" id="ownedHouseLocOutside" name="_ownedLocation" value="1" class="form-selectgroup-input">
                                                        <span class="form-selectgroup-label d-flex align-items-center p-2">
                                                            <span class="me-3">
                                                                <span class="form-selectgroup-check"></span>
                                                            </span>
                                                            <span class="form-selectgroup-label-content">
                                                                <span class="form-selectgroup-title strong mb-1">Outside Pampanga</span>
                                                            </span>
                                                        </span>
                                                    </label>
                                                </div>
                                            </div>
                                            <div class="row mb-3">
                                                <div class="col">
                                                    <label class="form-label">Specific Location</label>
                                                    <input type="text" id="specificLoc" class="form-control" name="_specificLocation" placeholder="Specific Location" required>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <input type="hidden" id="add-row"></input>
                                    <div class="col-lg-6">
                                        <label class="form-label">Mode of Transportation</label>
                                        <div class="form-selectgroup-boxes row mb-3">
                                            <div class="col-lg-6">
                                                <label class="form-selectgroup-item">
                                                    <input type="radio" id="ownVehicle" name="_modeOfTransport" value="0" class="form-selectgroup-input">
                                                    <span class="form-selectgroup-label d-flex align-items-center p-3">
                                                        <span class="me-3">
                                                            <span class="form-selectgroup-check"></span>
                                                        </span>
                                                        <span class="form-selectgroup-label-content">
                                                            <span class="form-selectgroup-title strong mb-1">Own Vehicle</span>
                                                        </span>
                                                    </span>
                                                </label>
                                            </div>
                                            <div class="col-lg-6">
                                                <label class="form-selectgroup-item">
                                                    <input type="radio" id="commute" name="_modeOfTransport" value="1" class="form-selectgroup-input" asp-for="@Model.DormApplicants.ModeOfTransportation">
                                                    <span class="form-selectgroup-label d-flex align-items-center p-3">
                                                        <span class="me-3">
                                                            <span class="form-selectgroup-check"></span>
                                                        </span>
                                                        <span class="form-selectgroup-label-content">
                                                            <span class="form-selectgroup-title strong mb-1">Commute</span>
                                                        </span>
                                                    </span>
                                                </label>
                                            </div>
                                        </div>
                                        <div>
                                            <div class="row mb-4">
                                                <div class="col">
                                                    <label class="form-label mb-2">Plate Number</label>
                                                    <input type="text" id="plateNumber" class="form-control" name="_plateNumber" placeholder="Plate Number" required>
                                                </div>
                                            </div>
                                        </div>
                                        <div>
                                            <div class="row mb-3">
                                                <div class="col-lg-6">
                                                    <label class="form-label">Travel Time</label>
                                                    <input type="text" id="travelTime" class="form-control" name="_travelTime" placeholder="Travel Time" required>
                                                </div>
                                                <div class="col-lg-6">
                                                    <label class="form-label">Fare</label>
                                                    <input type="text" id="fare" class="form-control" name="_fare" placeholder="Fare" required>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="card mt-3 mb-3" id="dependents-card">
                            <div class="card-header">
                                <h3 class="card-title">Dependents</h3>
                            </div>
                            <div class="card-body">
                                <!-- Labels Row -->
                                <div id="dynamic-rows-dependent-label">
                                    <div class="row mb-3">
                                        <div class="col-lg-2 col-md-4 col-sm-6">
                                            <label class="form-label">Name</label>
                                        </div>
                                        <div class="col-lg-2 col-md-4 col-sm-6">
                                            <label class="form-label">Birthdate</label>
                                        </div>
                                        <div class="col-lg-4 col-md-4 col-sm-6">
                                            <label class="form-label">Other Information</label>
                                        </div>
                                    </div>
                                </div>

                                <!-- Dynamic Rows Container -->
                                <div id="dynamic-rows-dependent">
                                    <div class="row mb-3 original-row g-2 align-items-center">
                                        <div class="col-lg-2 col-md-4 col-sm-6">
                                            <input type="text" class="form-control" name="_dependents[]" placeholder="Name">
                                        </div>
                                        <div class="col-lg-2 col-md-4 col-sm-6">
                                            <input type="date" class="form-control" name="_age[]">
                                        </div>

                                        <!-- Styled Radio Buttons (No Overlap) -->
                                        <div class="col-lg-2 col-md-4 col-sm-6 d-flex justify-content-center">
                                            <div class="d-flex gap-1 flex-nowrap" style="white-space: nowrap;">
                                                <label class="form-selectgroup-item">
                                                    <input type="radio" name="_dependent_status[0]" value="studying" class="form-selectgroup-input">
                                                    <span class="form-selectgroup-label fw-bold px-2" style="min-width: 60px; text-align: center;">Studying</span>
                                                </label>
                                                <label class="form-selectgroup-item">
                                                    <input type="radio" name="_dependent_status[0]" value="working" class="form-selectgroup-input">
                                                    <span class="form-selectgroup-label fw-bold px-2" style="min-width: 60px; text-align: center;">Working</span>
                                                </label>
                                            </div>
                                        </div>
                                        <div class="col-lg-2 col-md-4 col-sm-6">
                                            <input type="text" class="form-control" name="_name[]" placeholder="Position">
                                        </div>
                                        <div class="col-lg-2 col-md-4 col-sm-6">
                                            <input type="text" class="form-control" name="_location[]" placeholder="Location">
                                        </div>

                                        <!-- Buttons (Reduced Spacing & Size) -->
                                        <div class="col-lg-2 col-md-3 col-sm-6 d-flex justify-content-center gap-2">
                                            <button type="button" id="add-dependent" class="btn btn-primary">
                                                <i class="ti ti-plus"></i>
                                            </button>
                                            <button type="button" class="btn btn-danger remove-row">
                                                <i class="ti ti-trash"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="card mt-3 mb-3">
                            <div class="card-header">
                                <h3 class="card-title">Letter of Intent</h3>
                            </div>
                            <div class="card-body">
                                <!-- Upload Section -->
                                <div class="mt-4">
                                    <label class="form-label">Attach Letter of Intent</label>
                                    @(Html.Kendo().Upload()
                                        .Name("files")
                                        .Async(a => a
                                        .Save("UploadFiles", "Dorm")
                                        .Remove("Remove", "Dorm")
                                        .AutoUpload(true)
                                        )
                                        .Multiple(true)
                                        .Files(f =>
                                        {
                                            if (Model.FileAttachments != null)
                                            {
                                                foreach (var file in Model.FileAttachments)
                                                {
                                                    f.Add()
                                                    .Name(System.IO.Path.GetFileName(file.FilePath))
                                                    .Extension(System.IO.Path.GetExtension(file.FilePath))
                                                    .Size(12345); // Mock file size
                                                }
                                            }
                                        })
                                        .Events(e => e
                                        .Success("onSuccess")
                                        .Error("onError")
                                        .Upload("onUpload")
                                        .Remove("onRemove")
                                        )
                                        )
                                </div>
                                <input type="hidden" id="filesToRemove" name="filesToRemove" value="" />
                                <input type="hidden" name="filePath" id="filePath" />
                                <div id="uploadedFilesLinks" style="display: none;">
                                    <ul id="fileLinksList"></ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer d-flex justify-content-between align-items-center">
                    <a href="@Url.Action("ReservationList", "Dorm")" class="btn btn-link link-secondary">
                        Go Back
                    </a>
                    <button id="svbtn15" type="submit" class="btn btn btn-primary ms-auto">
                        <!-- Download SVG icon from http://tabler-icons.io/i/plus -->
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M12 5l0 14" /><path d="M5 12l14 0" /></svg>
                        Submit
                    </button>
                </div>
            </div>
        </form>
    </div>
    <div class="card booking-summary col-lg-3 align-self-start">
        <div class="card-header">
            <h3 class="card-title mb-0">Reservation Summary</h3>
        </div>

        <div class="card-body p-3 text-center">
            <!-- Profile Image & Reservation Code -->
            <div class="d-flex flex-column align-items-center">
                <div class="profile-img mb-2">
                    <img src="@Url.Content("~/img/dorm-room.jpg")" alt="Dorm Reservation" class="rounded img-fluid border shadow-sm"
                         style="width: 90px; height: 90px; object-fit: cover;">
                </div>
                <span class="text-primary fw-bold">@Model.ReservationHeader.ReservationCode</span>

                <!-- Status Indicator -->
                @if (Model.ReservationHeader.Status == "APPROVED")
                {
                    <span class='status status-teal'>
                        <span class='status-dot status-dot-animated'></span>@Model.ReservationHeader.Status
                    </span>
                }
                else if (Model.ReservationHeader.Status.Contains("FOR") && Model.ReservationHeader.Status.Contains("APPROVAL"))
                {
                    <span class='status status-teal'>
                        <span class='status-dot status-dot-animated'></span>FOR APPROVAL
                    </span>
                }
                else if (Model.ReservationHeader.Status == "CANCELLED" || Model.ReservationHeader.Status == "DISAPPROVED")
                {
                    <span class='status status-red'>
                        <span class='status-dot status-dot-animated'></span>@Model.ReservationHeader.Status
                    </span>
                }
                else
                {
                    <span class='status status-blue'>
                        <span class='status-dot status-dot-animated'></span>@Model.ReservationHeader.Status
                    </span>
                }
            </div>
            <!-- User Details Section -->
            <div class="mt-3 d-flex justify-content-center">
                <table class="table table-borderless w-100 text-start" style="line-height: .5;">
                    <tbody>
                        <tr>
                            <td class="fw-bold text-primary">Requestor:</td>
                            <td>@Model.ReservationHeader.Requestor</td>
                        </tr>
                        <tr>
                            <td class="fw-bold text-primary">Employee ID:</td>
                            <td>@Model.Employees.EmployeeID</td>
                        </tr>
                        <tr>
                            <td class="fw-bold text-primary">Email:</td>
                            <td>@Model.ReservationHeader.RequestorEmail</td>
                        </tr>
                        <tr>
                            <td class="fw-bold text-primary">Department:</td>
                            <td>@Model.Department.DepartmentCode</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

