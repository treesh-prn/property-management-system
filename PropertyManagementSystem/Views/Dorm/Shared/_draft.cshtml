@model PropertyManagementSystem.Models.ReservationViewModel;

@{
    var applicantCivilStatus = DormHousingEligibilityPolicy.NormalizeCivilStatus(Model.ApplicantCivilStatus);
    var applicantCivilStatusLabel = DormHousingEligibilityPolicy.GetCivilStatusLabel(applicantCivilStatus);
    var canApplyForHousing = DormHousingEligibilityPolicy.CanApplyForUnit(
        applicantCivilStatus,
        DormHousingEligibilityPolicy.HousingUnit);
}

<form asp-action="CreateReservationDetails" asp-controller="Dorm" method="post" class="reservation-workflow-form" data-guided-workflow="dorm" data-preserve-draft="dorm">
    <input type="hidden" class="form-control" name="_reservationId" asp-for="ReservationHeader.ReservationId">
    <input type="hidden" name="_civilStat" value="@applicantCivilStatus">
    <nav class="request-workflow-steps" aria-label="Housing request progress">
        <button type="button" class="request-workflow-step is-active" data-workflow-target="0" aria-current="step">
            <span>1</span>
            <strong>Applicant</strong>
        </button>
        <button type="button" class="request-workflow-step" data-workflow-target="1">
            <span>2</span>
            <strong>Home &amp; travel</strong>
        </button>
        <button type="button" class="request-workflow-step" data-workflow-target="2">
            <span>3</span>
            <strong>Dependents</strong>
        </button>
    </nav>
    <div class="container container-lg mt-3">
        <div id="dynamic-rows">
            <div class="row">
                <div class="col-lg-8">
                    <div class="card reservation-input-card" data-workflow-panel="0">
                        <div class="card-header">
                            <h3 class="card-title">Applicant Details</h3>
                        </div>
                        <div class="card-body">
                            <div class="alert @(canApplyForHousing ? "alert-success" : "alert-info") mb-3" role="status">
                                <div class="d-flex align-items-start gap-2">
                                    <i class="ti @(canApplyForHousing ? "ti-circle-check" : "ti-info-circle") mt-1" aria-hidden="true"></i>
                                    <div>
                                        <strong>Civil status on your employee profile: @applicantCivilStatusLabel</strong>
                                        <div class="mt-1">
                                            @(canApplyForHousing
                                                ? "You may apply for either Dorm or Housing."
                                                : "You may apply for Dorm. Housing becomes available when your employee profile shows Married.")
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="form-selectgroup-boxes row mb-3">
                                <div class="col-lg-6">
                                    <label class="form-selectgroup-item">
                                        <input type="radio" name="_unitApplied" value="0" class="form-selectgroup-input" checked>
                                        <span class="form-selectgroup-label d-flex align-items-center p-3">
                                            <span class="me-3">
                                                <span class="form-selectgroup-check"></span>
                                            </span>
                                            <span class="form-selectgroup-label-content">
                                                <span class="form-selectgroup-title strong mb-1">Dorm</span>
                                                <span class="form-selectgroup-description">Available for Single and Married employees</span>
                                            </span>
                                        </span>
                                    </label>
                                </div>
                                <div class="col-lg-6">
                                    <label class="form-selectgroup-item @(canApplyForHousing ? string.Empty : "opacity-50")">
                                        <input type="radio" name="_unitApplied" value="1" class="form-selectgroup-input" disabled="@(canApplyForHousing ? null : "disabled")">
                                        <span class="form-selectgroup-label d-flex align-items-center p-3">
                                            <span class="me-3">
                                                <span class="form-selectgroup-check"></span>
                                            </span>
                                            <span class="form-selectgroup-label-content">
                                                <span class="form-selectgroup-title strong mb-1">Housing</span>
                                                <span class="form-selectgroup-description">
                                                    @(canApplyForHousing ? "Available based on your Married status" : "Available only when civil status is Married")
                                                </span>
                                            </span>
                                        </span>
                                    </label>
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-lg-6">
                                    <label class="form-label">Schedule Type</label>
                                    <div class="form-selectgroup-boxes row mb-3">
                                        <div class="col-lg-4">
                                            <label class="form-selectgroup-item">
                                                <input type="radio" name="_schedType" id="regularRadio" value="0" class="form-selectgroup-input">
                                                <span class="form-selectgroup-label d-flex align-items-center p-2">
                                                    <span class="me-3">
                                                        <span class="form-selectgroup-check"></span>
                                                    </span>
                                                    <span class="form-selectgroup-label-content">
                                                        <span class="form-selectgroup-title strong mb-1">Regular</span>
                                                    </span>
                                                </span>
                                            </label>
                                        </div>
                                        <div class="col-lg-3">
                                            <label class="form-selectgroup-item">
                                                <input type="radio" name="_schedType" value="1" id="swingRadio" class="form-selectgroup-input">
                                                <span class="form-selectgroup-label d-flex align-items-center p-2">
                                                    <span class="me-3">
                                                        <span class="form-selectgroup-check"></span>
                                                    </span>
                                                    <span class="form-selectgroup-label-content">
                                                        <span class="form-selectgroup-title strong mb-1">Swing</span>
                                                    </span>
                                                </span>
                                            </label>
                                        </div>
                                        <div class="col-lg-5">
                                            <label class="form-selectgroup-item">
                                                <input type="radio" name="_schedType" value="2" id="gyRadio" class="form-selectgroup-input">
                                                <span class="form-selectgroup-label d-flex align-items-center p-2">
                                                    <span class="me-3">
                                                        <span class="form-selectgroup-check"></span>
                                                    </span>
                                                    <span class="form-selectgroup-label-content">
                                                        <span class="form-selectgroup-title strong mb-1">Graveyard</span>
                                                    </span>
                                                </span>
                                            </label>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-6">
                                    <label class="form-label">
                                        Contact Number
                                    </label>
                                    <div class="input-group pb-2">
                                        <span class="input-group-text">
                                            +63
                                        </span>
                                        <input type="tel" class="form-control pb-2" name="_contactNumber" placeholder="10-digit mobile number" asp-for="@Model.ReservationDetails.FirstOrDefault().ContactNumber" maxlength="10" inputmode="numeric" pattern="[0-9]{10}" aria-describedby="dorm-contact-hint">
                                    </div>
                                    <small id="dorm-contact-hint" class="form-hint">Enter the 10 digits after +63.</small>

                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-lg-6">
                                    <div>
                                        <label class="form-label">
                                            Permanent Home Address
                                        </label>
                                        <input type="text" class="form-control" name="_permanentAdd" placeholder="Permanent Home Address">
                                    </div>
                                </div>
                                <div class="col-lg-6">
                                    <div>
                                        <label class="form-label">
                                            Current Home Address
                                        </label>
                                        <input type="text" class="form-control" name="_currentAdd" placeholder="Current Home Address">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card mt-3 reservation-input-card" data-workflow-panel="1" hidden>
                        <div class="card-header">
                            <h3 class="card-title">Home and Transportation Details</h3>
                        </div>
                        <div class="card-body">
                            <div class="row mb-3">
                                <div class="col-lg-6">
                                    <label class="form-label">Home Ownership</label>
                                    <div class="form-selectgroup-boxes row mb-3">
                                        <div class="col-lg-4">
                                            <label class="form-selectgroup-item">
                                                <input type="radio" name="_homeOwnership" id="ownedRadio" value="0" class="form-selectgroup-input">
                                                <span class="form-selectgroup-label d-flex align-items-center p-3">
                                                    <span class="me-3">
                                                        <span class="form-selectgroup-check"></span>
                                                    </span>
                                                    <span class="form-selectgroup-label-content">
                                                        <span class="form-selectgroup-title strong mb-1">Owned</span>
                                                    </span>
                                                </span>
                                            </label>
                                        </div>
                                        <div class="col-lg-3">
                                            <label class="form-selectgroup-item">
                                                <input type="radio" name="_homeOwnership" value="1" id="rentedRadio" class="form-selectgroup-input">
                                                <span class="form-selectgroup-label d-flex align-items-center p-3">
                                                    <span class="me-3">
                                                        <span class="form-selectgroup-check"></span>
                                                    </span>
                                                    <span class="form-selectgroup-label-content">
                                                        <span class="form-selectgroup-title strong mb-1">Rented</span>
                                                    </span>
                                                </span>
                                            </label>
                                        </div>
                                        <div class="col-lg-5">
                                            <label class="form-selectgroup-item">
                                                <input type="radio" name="_homeOwnership" value="2" id="livingWithParentsRadio" class="form-selectgroup-input">
                                                <span class="form-selectgroup-label d-flex align-items-center p-3">
                                                    <span class="me-3">
                                                        <span class="form-selectgroup-check"></span>
                                                    </span>
                                                    <span class="form-selectgroup-label-content">
                                                        <span class="form-selectgroup-title strong mb-1">Living with Family</span>
                                                    </span>
                                                </span>
                                            </label>
                                        </div>
                                    </div>
                                    <div>
                                        <label class="form-label">Location of Owned House</label>
                                        <div class="form-selectgroup-boxes row mb-3">
                                            <div class="col-lg-6">
                                                <label class="form-selectgroup-item">
                                                    <input type="radio" id="ownedHouseLocWithin" name="_ownedLocation" value="0" class="form-selectgroup-input">
                                                    <span class="form-selectgroup-label d-flex align-items-center p-2">
                                                        <span class="me-3">
                                                            <span class="form-selectgroup-check"></span>
                                                        </span>
                                                        <span class="form-selectgroup-label-content">
                                                            <span class="form-selectgroup-title strong mb-1">Within Pampanga</span>
                                                        </span>
                                                    </span>
                                                </label>
                                            </div>
                                            <div class="col-lg-6">
                                                <label class="form-selectgroup-item">
                                                    <input type="radio" id="ownedHouseLocOutside" name="_ownedLocation" value="1" class="form-selectgroup-input">
                                                    <span class="form-selectgroup-label d-flex align-items-center p-2">
                                                        <span class="me-3">
                                                            <span class="form-selectgroup-check"></span>
                                                        </span>
                                                        <span class="form-selectgroup-label-content">
                                                            <span class="form-selectgroup-title strong mb-1">Outside Pampanga</span>
                                                        </span>
                                                    </span>
                                                </label>
                                            </div>
                                        </div>
                                        <div class="row mb-3">
                                            <div class="col">
                                                <label class="form-label">Specific Location</label>
                                                <input type="text" id="specificLoc" class="form-control" name="_specificLocation" placeholder="Specific Location">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <input type="hidden" id="add-row"></input>
                                <div class="col-lg-6">
                                    <label class="form-label">Mode of Transportation</label>
                                    <div class="form-selectgroup-boxes row mb-3">
                                        <div class="col-lg-6">
                                            <label class="form-selectgroup-item">
                                                <input type="radio" id="ownVehicle" name="_modeOfTransport" value="0" class="form-selectgroup-input">
                                                <span class="form-selectgroup-label d-flex align-items-center p-3">
                                                    <span class="me-3">
                                                        <span class="form-selectgroup-check"></span>
                                                    </span>
                                                    <span class="form-selectgroup-label-content">
                                                        <span class="form-selectgroup-title strong mb-1">Own Vehicle</span>
                                                    </span>
                                                </span>
                                            </label>
                                        </div>
                                        <div class="col-lg-6">
                                            <label class="form-selectgroup-item">
                                                <input type="radio" id="commute" name="_modeOfTransport" value="1" class="form-selectgroup-input" asp-for="@Model.ReservationDetails.FirstOrDefault().ModeOfTransportation">
                                                <span class="form-selectgroup-label d-flex align-items-center p-3">
                                                    <span class="me-3">
                                                        <span class="form-selectgroup-check"></span>
                                                    </span>
                                                    <span class="form-selectgroup-label-content">
                                                        <span class="form-selectgroup-title strong mb-1">Commute</span>
                                                    </span>
                                                </span>
                                            </label>
                                        </div>
                                    </div>
                                    <div>
                                        <div class="row mb-4">
                                            <div class="col">
                                                <label class="form-label mb-2">Type of Vehicle</label>
                                                <input type="text" id="vehicleType" class="form-control" name="_vehicleType" placeholder="Type of Vehicle">
                                            </div>
                                        </div>
                                    </div>
                                    <div>
                                        <div class="row mb-3">
                                            <div class="col-lg-6">
                                                <label class="form-label">Travel Time</label>
                                                <input type="text" id="travelTime" class="form-control" name="_travelTime" placeholder="Travel Time">
                                            </div>
                                            <div class="col-lg-6">
                                                <label class="form-label">Fare</label>
                                                <input type="text" id="fare" class="form-control" name="_fare" placeholder="Fare">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card mt-3 mb-3 reservation-input-card" data-workflow-panel="2" hidden>
                        <div class="card-header">
                            <h3 class="card-title">Dependents</h3>
                        </div>
                        <div class="card-body">
                            <label class="form-label">Civil Status</label>
                            <div class="border rounded p-3 mb-3 bg-light">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="ti ti-id-badge-2 text-primary" aria-hidden="true"></i>
                                    <div>
                                        <strong>@applicantCivilStatusLabel</strong>
                                        <div class="text-secondary small">Retrieved from your employee profile and used to determine Housing eligibility.</div>
                                    </div>
                                </div>
                            </div>
                            <div id="dynamic-rows-dependent-label">
                                <label class="form-label">Dependents</label>
                                <div class="row mb-3">
                                    <div class="col-lg-2">
                                        <label class="form-label">Name</label>
                                    </div>
                                    <div class="col-lg-1">
                                        <label class="form-label">Age</label>
                                    </div>
                                    <div class="col-lg-4">
                                        <label class="form-label">Other Information</label>
                                    </div>
                                </div>
                            </div>
                            <div id="dynamic-rows-dependent">
                                <div class="row mb-3 original-row">
                                    <div class="col-lg-2">
                                        <input type="text" class="form-control" name="_dependents[]" placeholder="Name">
                                    </div>
                                    <div class="col-lg-1">
                                        <input type="text" class="form-control" name="_age[]" placeholder="Age">
                                    </div>
                                    <div class="col-lg-2">
                                        <label class="form-selectgroup-item">
                                            <input type="radio" name="_dependent_status[0]" value="studying" class="form-selectgroup-input">
                                            <span class="form-selectgroup-label d-flex align-items-center p-2">
                                                <span class="me-3">
                                                    <span class="form-selectgroup-check"></span>
                                                </span>
                                                <span class="form-selectgroup-label-content">
                                                    <span class="form-selectgroup-title strong mb-1">Studying</span>
                                                </span>
                                            </span>
                                        </label>
                                    </div>
                                    <div class="col-lg-2">
                                        <label class="form-selectgroup-item">
                                            <input type="radio" name="_dependent_status[0]" value="working" class="form-selectgroup-input">
                                            <span class="form-selectgroup-label d-flex align-items-center p-2">
                                                <span class="me-3">
                                                    <span class="form-selectgroup-check"></span>
                                                </span>
                                                <span class="form-selectgroup-label-content">
                                                    <span class="form-selectgroup-title strong mb-1">Working</span>
                                                </span>
                                            </span>
                                        </label>
                                    </div>
                                    <div class="col-lg-2">
                                        <input type="text" class="form-control" name="_position[]" placeholder="Position">
                                    </div>
                                    <div class="col-lg-2">
                                        <input type="text" class="form-control" name="_location[]" placeholder="Location">
                                    </div>
                                    <div class="col-sm-1 d-flex align-items-end">
                                        <button type="button" id="add-dependent" class="btn btn-primary ml-2 custom-padding">
                                            <i class="ti ti-plus"></i>
                                        </button>
                                        <button type="button" class="btn btn-danger remove-row ml-2 custom-padding">
                                            <i class="ti ti-trash"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-12">
                                <div>
                                    <label class="form-label">
                                        Attach Letter of Intent
                                    </label>
                                    @(Html.Kendo().Upload()
                                        .Name("files")
                                        .Async(a => a
                                        .Save("Upload", "Dorm")
                                        .Remove("Remove", "Dorm")
                                        .AutoUpload(true)
                                        )
                                        .DropZone(".dropZoneElement")
                                                        .Events(e => e
                                                        .Upload("onUpload")
                                                        .Success("onSuccess")
                                        .Error("onError")
                                        )
                                        )
                                </div>
                            </div>
                            <input type="hidden" name="filePath" id="filePath" />

                            <div id="uploadedFilesLinks" style="display: none;">
                                <ul id="fileLinksList"></ul>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="card booking-summary reservation-summary-panel" data-review-panel="dorm">
                        <div class="card-header">
                            <h3 class="card-title">Quick Review</h3>
                        </div>
                        <div class="card-body">
                            <div class="quick-review-intro">
                                <i class="ti ti-clipboard-check"></i>
                                <span>Review the housing application details before submitting.</span>
                            </div>
                            <dl class="quick-review-list">
                                <dt>Applied Unit</dt>
                                <dd data-review-value="unit">Dorm</dd>
                                <dt>Schedule Type</dt>
                                <dd data-review-value="schedule">Not selected</dd>
                                <dt>Contact Number</dt>
                                <dd data-review-value="contact">Not provided</dd>
                                <dt>Current Address</dt>
                                <dd data-review-value="currentAddress">Not provided</dd>
                                <dt>Home Ownership</dt>
                                <dd data-review-value="homeOwnership">Not selected</dd>
                                <dt>Dependents</dt>
                                <dd data-review-value="dependents">1 dependent row</dd>
                                <dt>Attachment</dt>
                                <dd data-review-value="attachment">No file uploaded</dd>
                            </dl>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="card-footer d-flex justify-content-between align-items-center">
        <a href="@Url.Action("ReservationList", "Dorm")" class="btn btn-link link-secondary" data-draft-back>
            Back to My Requests
        </a>
        <div class="request-workflow-actions ms-auto">
            <button type="button" class="btn btn-outline-secondary" data-workflow-previous hidden>
                <i class="ti ti-arrow-left" aria-hidden="true"></i>
                Previous
            </button>
            <button type="button" class="btn btn-primary" data-workflow-next>
                Continue
                <i class="ti ti-arrow-right" aria-hidden="true"></i>
            </button>
        </div>
        <button id="svbtn15" type="submit" class="btn btn-primary ms-2" data-workflow-submit hidden>
            <i class="ti ti-send" aria-hidden="true"></i>
            Submit Request
        </button>
    </div>
</form>
