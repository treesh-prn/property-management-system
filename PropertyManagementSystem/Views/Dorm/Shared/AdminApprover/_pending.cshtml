@model PropertyManagementSystem.Models.ReservationViewModel
<partial name="~/Views/Dorm/Shared/_reservationDetails.cshtml" model="Model" />
<div class="card-body legacy-module-summary" hidden>
    <div class="row align-items-start">
        <div class="col-2">
            <img src="@Url.Content("~/img/dorm-room.jpg")" alt="Accommodation" class="rounded img-fluid">
        </div>
        <div class="col-9">
            <div class="text-primary h3 d-flex align-items-center">
                <!-- Reservation Code -->
                <span>@Model.ReservationHeader.ReservationCode</span>

                <!-- Status placed at the end of the reservation code with a space -->
                <span class="ms-3">
                    <!-- Margin for spacing -->
                    @if (Model.ReservationHeader.Status == "APPROVED")
                    {
                        <span class='status status-teal'>
                            <span class='status-dot status-dot-animated'></span>@Model.ReservationHeader.Status
                        </span>
                    }
                    else if (Model.ReservationHeader.Status == "FOR DEPARTMENT HEAD'S APPROVAL" || Model.ReservationHeader.Status == "FOR ADMIN APPROVER'S APPROVAL" || Model.ReservationHeader.Status == "FOR ADMIN MANAGER'S APPROVAL")
                    {
                        <span class='status status-teal'>
                            <span class='status-dot status-dot-animated'></span>FOR APPROVAL
                        </span>
                    }
                    else if (Model.ReservationHeader.Status == "CANCELLED" || Model.ReservationHeader.Status == "DISAPPROVED")
                    {
                        <span class='status status-red'>
                            <span class='status-dot status-dot-animated'></span>@Model.ReservationHeader.Status
                        </span>
                    }
                    else
                    {
                        <span class='status status-blue'>
                            <span class='status-dot status-dot-animated'></span>@Model.ReservationHeader.Status
                        </span>
                    }
                </span>
            </div>

            <div class="row mt-3">
                <!-- Rest of the content remains the same -->
                <div class="col-lg-3 col-md-6 mb-4">
                    <div class="datagrid-item">
                        <div class="datagrid-title text-primary">Requestor</div>
                        <div class="datagrid-content">@Model.ReservationHeader.Requestor</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 mb-4">
                    <div class="datagrid-item">
                        <div class="datagrid-title text-primary">Email</div>
                        <div class="datagrid-content">@Model.ReservationHeader.RequestorEmail</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 mb-4">
                    <div class="datagrid-item">
                        <div class="datagrid-title text-primary">Department</div>
                        <div class="datagrid-content">@Model.Department.DepartmentCode</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 mb-4">
                    <div class="datagrid-item">
                        <div class="datagrid-title text-primary">Contact Number</div>
                        <div class="datagrid-content">+63 @Model.ReservationDetails.FirstOrDefault().ContactNumber</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 mb-4">
                    <div class="datagrid-item">
                        <div class="datagrid-title text-primary">Date Filed</div>
                        <div class="datagrid-content">@Model.ReservationHeader.DateFiled</div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 mb-4">
                    <div class="datagrid-item">
                        <div class="datagrid-title text-primary">Schedule Type</div>
                        @if (Model.ReservationDetails.FirstOrDefault().ScheduleType == 0)
                        {
                            <div class="datagrid-content">Regular</div>
                        }
                        else
                        {
                            <div class="datagrid-content">Shifting</div>
                        }
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 mb-4">
                    <div class="datagrid-item">
                        <div class="datagrid-title text-primary">Applied Unit</div>
                        @if (Model.ReservationDetails.FirstOrDefault().AppliedUnit == 0)
                        {
                            <div class="datagrid-content">Dorm</div>
                        }
                        else
                        {
                            <div class="datagrid-content">Housing</div>
                        }
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 mb-4">
                    <div class="datagrid-item">
                        <div class="datagrid-title text-primary">Letter of Intent</div>
                        <div class="datagrid-content">
                            <a href="@Model.ReservationDetails.FirstOrDefault().FileAttachment" target="_blank">
                                @Model.ReservationDetails.FirstOrDefault().FileAttachment
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<form asp-action="UpdateReservationStatus" method="post">
    <input type="hidden" name="ReservationId" value="@Model.ReservationHeader.ReservationId">
    <input type="hidden" class="form-control" name="@Model.ReservationDetails.FirstOrDefault().ReservationDetailId" asp-for="@Model.ReservationDetails.FirstOrDefault().ReservationDetailId">
    <div class="card-footer d-flex justify-content-between align-items-center">
        <a href="@Url.Action("ReservationList", "Dorm")" class="btn btn-link link-secondary">
            Go Back
        </a>
        <div>
            <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#modal-danger-@Model.ReservationDetails.FirstOrDefault().ReservationDetailId">
                <i class="ti ti-ban m-1"></i> Disapprove
            </button>
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modal-assign-@Model.ReservationDetails.FirstOrDefault().ReservationDetailId">
                <i class="ti ti-plus m-1"></i> Assign Dorm
            </button>
        </div>
    </div>
</form>
@*ASSIGN FACILITY MODAL*@
<div class="modal modal-blur fade" id="modal-assign-@Model.ReservationDetails.FirstOrDefault().ReservationDetailId" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-md modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Facility Assignment</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="UpdateReservationStatus" method="post">
                <div class="modal-body">
                    <input type="hidden" id="ReservationId" name="ReservationId" value="@Model.ReservationDetails.FirstOrDefault().ReservationId">
                    <input type="hidden" id="reservationDetailId" name="ReservationDetailId" value="@Model.ReservationDetails.FirstOrDefault().ReservationDetailId">
                    <div class="mb-3">
                        <label class="form-label required">Facility</label>
                        @(
                            Html.Kendo().DropDownList()
                            .Name("_facilityId")
                            .DataTextField("FacilityName")
                            .DataValueField("FacilityId")
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("GetDRM", "Global").Data("filterFacilities");
                                });
                            })
                            .HtmlAttributes(new { style = "width: 100%" })
                            .OptionLabel("Select Facility")
                            )
                    </div>
                    <div class="mb-3">
                        <label class="form-label required">Room</label>
                        @(Html.Kendo().DropDownList()
                            .Name("_roomId")
                            .DataTextField("RoomName")
                            .DataValueField("RoomId")
                            .CascadeFrom("_facilityId")
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("GetRoom", "Global").Data("filterRooms");
                                }).ServerFiltering(true);
                            })
                            .HtmlAttributes(new { style = "width: 100%" })
                            .OptionLabel("Select Room")
                            )
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn me-auto" data-bs-dismiss="modal">Close</button>
                    <button type="submit" name="action" id="showAlertButton" value="Approve" class="btn btn-primary" data-bs-dismiss="modal">Assign and Approve</button>
                </div>
            </form>
        </div>
    </div>
</div>
@*END OF MODAL*@
@*CANCEL MODAL*@
<div class="modal modal-blur fade" id="modal-danger-@Model.ReservationDetails.FirstOrDefault().ReservationDetailId" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-md modal-dialog-centered" role="document">
        <div class="modal-content">
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            <div class="modal-status bg-danger"></div>
            <div class="modal-body text-center py-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="icon mb-2 text-danger icon-lg" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M12 9v4" /><path d="M10.363 3.591l-8.106 13.534a1.914 1.914 0 0 0 1.636 2.871h16.214a1.914 1.914 0 0 0 1.636 -2.87l-8.106 -13.536a1.914 1.914 0 0 0 -3.274 0z" /><path d="M12 16h.01" /></svg>
                <h3>Are you sure?</h3>
                <div class="text-secondary">Do you really want to cancel this reservation? This action cannot be undone.</div>
            </div>
            <form asp-action="UpdateReservationStatus" method="post">
                @Html.AntiForgeryToken()
                <div class="m-1">
                    <div>
                        <label class="form-label">Remarks <span class="form-label-description"></span></label>
                        <textarea class="form-control" rows="2" name="Remarks" required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <div class="w-100">
                        <input type="hidden" value="@Model.ReservationHeader.Status" />
                        <div class="row">
                            <div class="col">
                                <a href="#" class="btn w-100" data-bs-dismiss="modal">
                                    Go Back
                                </a>
                            </div>
                            <div class="col">
                                <button type="submit" name="action" value="Reject" class="btn btn-danger w-100">
                                    <i class="ti ti-ban m-1"></i> Disapprove
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                <input type="hidden" name="ReservationId" value="@Model.ReservationDetails.FirstOrDefault().ReservationId" />
            </form>
        </div>
    </div>
</div>
@*CANCEL DELETE MODAL*@
