@model PropertyManagementSystem.Models.ReservationViewModel;
@inject PropertyManagementSystem.Services.IRoleService RoleService
@{
    var employee = await RoleService.GetUserName(User);
}
<form asp-action="UpdateReservationStatus" method="post">
    <div class="modal-body">
        <input type="hidden" name="ReservationId" value="@Model.ReservationHeader.ReservationId">
        <input type="hidden" class="form-control" name="@Model.ReservationDetails.FirstOrDefault().ReservationDetailId" asp-for="@Model.ReservationDetails.FirstOrDefault().ReservationDetailId">
        <h3 class="card-title">
            I. Requestor
        </h3>
        <div id="dynamic-rows">
            <label class="form-label">Unit Applied For</label>
            <div class="form-selectgroup-boxes row mb-3">
                <div class="col-lg-6">
                    <label class="form-selectgroup-item">
                        <input type="radio" name="_unitApplied" value="0" class="form-selectgroup-input" asp-for="@Model.ReservationDetails.FirstOrDefault().AppliedUnit" readonly>
                        <span class="form-selectgroup-label d-flex align-items-center p-3">
                            <span class="me-3">
                                <span class="form-selectgroup-check"></span>
                            </span>
                            <span class="form-selectgroup-label-content">
                                <span class="form-selectgroup-title strong mb-1">Dorm</span>
                            </span>
                        </span>
                    </label>
                </div>
                <div class="col-lg-6">
                    <label class="form-selectgroup-item">
                        <input type="radio" name="_unitApplied" value="1" class="form-selectgroup-input" asp-for="@Model.ReservationDetails.FirstOrDefault().AppliedUnit" readonly>
                        <span class="form-selectgroup-label d-flex align-items-center p-3">
                            <span class="me-3">
                                <span class="form-selectgroup-check"></span>
                            </span>
                            <span class="form-selectgroup-label-content">
                                <span class="form-selectgroup-title strong mb-1">Housing</span>
                            </span>
                        </span>
                    </label>
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-lg-6">
                    <label class="form-label">Schedule Type</label>
                    <div class="form-selectgroup-boxes row mb-3">
                        <div class="col-lg-4">
                            <label class="form-selectgroup-item">
                                <input type="radio" name="_schedType" id="regularRadio" value="0" class="form-selectgroup-input" asp-for="@Model.ReservationDetails.FirstOrDefault().ScheduleType" readonly>
                                <span class="form-selectgroup-label d-flex align-items-center p-2">
                                    <span class="me-3">
                                        <span class="form-selectgroup-check"></span>
                                    </span>
                                    <span class="form-selectgroup-label-content">
                                        <span class="form-selectgroup-title strong mb-1">Regular</span>
                                    </span>
                                </span>
                            </label>
                        </div>
                        <div class="col-lg-3">
                            <label class="form-selectgroup-item">
                                <input type="radio" name="_schedType" value="1" id="swingRadio" class="form-selectgroup-input" asp-for="@Model.ReservationDetails.FirstOrDefault().ScheduleType" readonly>
                                <span class="form-selectgroup-label d-flex align-items-center p-2">
                                    <span class="me-3">
                                        <span class="form-selectgroup-check"></span>
                                    </span>
                                    <span class="form-selectgroup-label-content">
                                        <span class="form-selectgroup-title strong mb-1">Swing</span>
                                    </span>
                                </span>
                            </label>
                        </div>
                        <div class="col-lg-5">
                            <label class="form-selectgroup-item">
                                <input type="radio" name="_schedType" value="2" id="gyRadio" class="form-selectgroup-input" asp-for="@Model.ReservationDetails.FirstOrDefault().ScheduleType" readonly>
                                <span class="form-selectgroup-label d-flex align-items-center p-2">
                                    <span class="me-3">
                                        <span class="form-selectgroup-check"></span>
                                    </span>
                                    <span class="form-selectgroup-label-content">
                                        <span class="form-selectgroup-title strong mb-1">Graveyard</span>
                                    </span>
                                </span>
                            </label>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <label class="form-label">
                        Contact Number
                    </label>
                    <div class="input-group pb-2">
                        <span class="input-group-text">
                            +63
                        </span>
                        <input type="text" class="form-control pb-2" name="_contactNumber" placeholder="Contact Number" asp-for="@Model.ReservationDetails.FirstOrDefault().ContactNumber" maxlength="10" readonly>
                    </div>

                </div>
            </div>
            <div class="row mb-3">
                <div class="col-lg-12">
                    <div>
                        <label class="form-label">
                            Permanent Home Address
                        </label>
                        <input type="text" class="form-control" name="_permanentAdd" placeholder="Permanent Home Address" asp-for="@Model.ReservationDetails.FirstOrDefault().PermanentAddress" readonly>
                    </div>
                </div>
            </div>
            <div class="row mb-5">
                <div class="col-lg-12">
                    <div>
                        <label class="form-label">
                            Current Home Address
                        </label>
                        <input type="text" class="form-control" name="_currentAdd" placeholder="Current Home Address" asp-for="@Model.ReservationDetails.FirstOrDefault().CurrentAddress" readonly>
                    </div>
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-lg-6">
                    <label class="form-label">Home Ownership</label>
                    <div class="form-selectgroup-boxes row mb-3">
                        <div class="col-lg-4">
                            <label class="form-selectgroup-item">
                                <input type="radio" name="_homeOwnership" id="ownedRadio" value="0" class="form-selectgroup-input" asp-for="@Model.ReservationDetails.FirstOrDefault().HomeOwnership" readonly>
                                <span class="form-selectgroup-label d-flex align-items-center p-3">
                                    <span class="me-3">
                                        <span class="form-selectgroup-check"></span>
                                    </span>
                                    <span class="form-selectgroup-label-content">
                                        <span class="form-selectgroup-title strong mb-1">Owned</span>
                                    </span>
                                </span>
                            </label>
                        </div>
                        <div class="col-lg-3">
                            <label class="form-selectgroup-item">
                                <input type="radio" name="_homeOwnership" value="1" id="rentedRadio" class="form-selectgroup-input" asp-for="@Model.ReservationDetails.FirstOrDefault().HomeOwnership" readonly>
                                <span class="form-selectgroup-label d-flex align-items-center p-3">
                                    <span class="me-3">
                                        <span class="form-selectgroup-check"></span>
                                    </span>
                                    <span class="form-selectgroup-label-content">
                                        <span class="form-selectgroup-title strong mb-1">Rented</span>
                                    </span>
                                </span>
                            </label>
                        </div>
                        <div class="col-lg-5">
                            <label class="form-selectgroup-item">
                                <input type="radio" name="_homeOwnership" value="2" id="livingWithParentsRadio" class="form-selectgroup-input" asp-for="@Model.ReservationDetails.FirstOrDefault().HomeOwnership" readonly>
                                <span class="form-selectgroup-label d-flex align-items-center p-3">
                                    <span class="me-3">
                                        <span class="form-selectgroup-check"></span>
                                    </span>
                                    <span class="form-selectgroup-label-content">
                                        <span class="form-selectgroup-title strong mb-1">Living with Family</span>
                                    </span>
                                </span>
                            </label>
                        </div>
                    </div>
                    <div>
                        <label class="form-label">Location of Owned House</label>
                        <div class="form-selectgroup-boxes row mb-3">
                            <div class="col-lg-6">
                                <label class="form-selectgroup-item">
                                    <input type="radio" id="ownedHouseLocWithin" name="_ownedLocation" value="0" class="form-selectgroup-input" asp-for="@Model.ReservationDetails.FirstOrDefault().OwnedHouseLocation" readonly>
                                    <span class="form-selectgroup-label d-flex align-items-center p-2">
                                        <span class="me-3">
                                            <span class="form-selectgroup-check"></span>
                                        </span>
                                        <span class="form-selectgroup-label-content">
                                            <span class="form-selectgroup-title strong mb-1">Within Pampanga</span>
                                        </span>
                                    </span>
                                </label>
                            </div>
                            <div class="col-lg-6">
                                <label class="form-selectgroup-item">
                                    <input type="radio" id="ownedHouseLocOutside" name="_ownedLocation" value="1" class="form-selectgroup-input" asp-for="@Model.ReservationDetails.FirstOrDefault().OwnedHouseLocation" readonly>
                                    <span class="form-selectgroup-label d-flex align-items-center p-2">
                                        <span class="me-3">
                                            <span class="form-selectgroup-check"></span>
                                        </span>
                                        <span class="form-selectgroup-label-content">
                                            <span class="form-selectgroup-title strong mb-1">Outside Pampanga</span>
                                        </span>
                                    </span>
                                </label>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col">
                                <label class="form-label">Specific Location</label>
                                <input type="text" id="specificLoc" class="form-control" name="_specificLocation" placeholder="Specific Location" asp-for="@Model.ReservationDetails.FirstOrDefault().SpecificLocation" readonly>
                            </div>
                        </div>
                    </div>
                </div>
                <input type="hidden" id="add-row"> </input>
                <div class="col-lg-6">
                    <label class="form-label">Mode of Transportation</label>
                    <div class="form-selectgroup-boxes row mb-3">
                        <div class="col-lg-6">
                            <label class="form-selectgroup-item">
                                <input type="radio" id="ownVehicle" name="_modeOfTransport" value="0" class="form-selectgroup-input" asp-for="@Model.ReservationDetails.FirstOrDefault().ModeOfTransportation" readonly>
                                <span class="form-selectgroup-label d-flex align-items-center p-3">
                                    <span class="me-3">
                                        <span class="form-selectgroup-check"></span>
                                    </span>
                                    <span class="form-selectgroup-label-content">
                                        <span class="form-selectgroup-title strong mb-1">Own Vehicle</span>
                                    </span>
                                </span>
                            </label>
                        </div>
                        <div class="col-lg-6">
                            <label class="form-selectgroup-item">
                                <input type="radio" id="commute" name="_modeOfTransport" value="1" class="form-selectgroup-input" asp-for="@Model.ReservationDetails.FirstOrDefault().ModeOfTransportation" readonly>
                                <span class="form-selectgroup-label d-flex align-items-center p-3">
                                    <span class="me-3">
                                        <span class="form-selectgroup-check"></span>
                                    </span>
                                    <span class="form-selectgroup-label-content">
                                        <span class="form-selectgroup-title strong mb-1">Commute</span>
                                    </span>
                                </span>
                            </label>
                        </div>
                    </div>
                    <div>
                        <div class="row mb-4">
                            <div class="col">
                                <label class="form-label mb-2">Type of Vehicle</label>
                                <input type="text" id="vehicleType" class="form-control" name="_vehicleType" placeholder="Type of Vehicle" asp-for="@Model.ReservationDetails.FirstOrDefault().VehicleType" readonly>
                            </div>
                        </div>
                    </div>
                    <div>
                        <div class="row mb-3">
                            <div class="col-lg-6">
                                <label class="form-label">Travel Time</label>
                                <input type="text" id="travelTime" class="form-control" name="_travelTime" placeholder="Travel Time" asp-for="@Model.ReservationDetails.FirstOrDefault().TravelTime" readonly>
                            </div>
                            <div class="col-lg-6">
                                <label class="form-label">Fare</label>
                                <input type="text" id="fare" class="form-control" name="_fare" placeholder="Fare" asp-for="@Model.ReservationDetails.FirstOrDefault().Fare" value="@Model.ReservationDetails.FirstOrDefault().Fare" readonly>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <label class="form-label">Civil Status</label>
            <div class="form-selectgroup-boxes row mb-3">
                <div class="col-lg-4">
                    <label class="form-selectgroup-item">
                        <input type="radio" name="_civilStat" value="SINGLE" class="form-selectgroup-input" asp-for="@Model.ReservationDetails.FirstOrDefault().CivilStatus" readonly>
                        <span class="form-selectgroup-label d-flex align-items-center p-3">
                            <span class="me-3">
                                <span class="form-selectgroup-check"></span>
                            </span>
                            <span class="form-selectgroup-label-content">
                                <span class="form-selectgroup-title strong mb-1">Single</span>
                            </span>
                        </span>
                    </label>
                </div>
                <div class="col-lg-4">
                    <label class="form-selectgroup-item">
                        <input type="radio" name="_civilStat" value="MARRIED" class="form-selectgroup-input" asp-for="@Model.ReservationDetails.FirstOrDefault().CivilStatus" readonly>
                        <span class="form-selectgroup-label d-flex align-items-center p-3">
                            <span class="me-3">
                                <span class="form-selectgroup-check"></span>
                            </span>
                            <span class="form-selectgroup-label-content">
                                <span class="form-selectgroup-title strong mb-1">Married</span>

                            </span>
                        </span>
                    </label>
                </div>
                <div class="col-lg-4">
                    <label class="form-selectgroup-item">
                        <input type="radio" name="_civilStat" value="WIDOWED" class="form-selectgroup-input" asp-for="@Model.ReservationDetails.FirstOrDefault().CivilStatus" readonly>
                        <span class="form-selectgroup-label d-flex align-items-center p-3">
                            <span class="me-3">
                                <span class="form-selectgroup-check"></span>
                            </span>
                            <span class="form-selectgroup-label-content">
                                <span class="form-selectgroup-title strong mb-1">Widowed</span>

                            </span>
                        </span>
                    </label>
                </div>
            </div>
            <div id="dynamic-rows-dependent-label">
                <label class="form-label">Dependents</label>
                <div class="row mb-3">
                    <div class="col-lg-2">
                        <label class="form-label">Name</label>
                    </div>
                    <div class="col-lg-1">
                        <label class="form-label">Age</label>
                    </div>
                    <div class="col-lg-4">
                        <label class="form-label">Other Information</label>
                    </div>
                    <div class="col-lg-2" id="location1">
                        <label class="form-label">Location</label>
                    </div>
                    <div class="col-lg-2" id="position1">
                        <label class="form-label">Position</label>
                    </div>
                </div>
            </div>
            <div id="dynamic-rows-dependent">
                <div class="row mb-3">
                    <div class="col-lg-2">
                        <input type="text" class="form-control" name="_dependents[]" placeholder="Name" readonly>
                    </div>
                    <div class="col-lg-1">
                        <input type="text" class="form-control" name="_age[]" placeholder="Age" readonly>
                    </div>
                    <div class="col-lg-2">
                        <label class="form-selectgroup-item">
                            <input type="radio" name="dependent-status" value="studying" class="form-selectgroup-input" readonly>
                            <span class="form-selectgroup-label d-flex align-items-center p-2">
                                <span class="me-3">
                                    <span class="form-selectgroup-check"></span>
                                </span>
                                <span class="form-selectgroup-label-content">
                                    <span class="form-selectgroup-title strong mb-1">Studying</span>

                                </span>
                            </span>
                        </label>
                    </div>
                    <div class="col-lg-2">
                        <label class="form-selectgroup-item">
                            <input type="radio" name="dependent-status" value="working" class="form-selectgroup-input" readonly>
                            <span class="form-selectgroup-label d-flex align-items-center p-2">
                                <span class="me-3">
                                    <span class="form-selectgroup-check"></span>
                                </span>
                                <span class="form-selectgroup-label-content">
                                    <span class="form-selectgroup-title strong mb-1">Working</span>

                                </span>
                            </span>
                        </label>
                    </div>
                    <div class="col-lg-4" id="position">
                        <input type="text" class="form-control" name="_position[]" placeholder="Position" readonly>
                    </div>
                    <div class="col-lg-4" id="location">
                        <input type="text" class="form-control" name="_location[]" placeholder="Location" readonly>
                    </div>
                    <div class="col-sm-1 d-flex align-items-end">
                        <button type="button" id="add-dependent" class="btn btn-primary ml-2 custom-padding" readonly>
                            <i class="ti ti-plus"></i>
                        </button>
                        <button type="button" class="btn btn-danger remove-row ml-2 custom-padding">
                            <i class="ti ti-trash"></i>
                        </button>
                    </div>
                </div>
            </div>
            <div class="col-lg-12">
                <div>
                    <label class="form-label">
                    Letter of Intent
                    </label>
                    <input type="hidden" name="filePath" id="filePath" />
                    <div id="uploadedFilesLinks">
                        <ul id="fileLinksList">
                            <li>
                                <a href="@Model.ReservationDetails.FirstOrDefault().FileAttachment" target="_blank">@Model.ReservationDetails.FirstOrDefault().FileAttachment</a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
            <h3 class="card-title">
                II. Department Head Remarks
            </h3>
            <div class="row mb-3">
                <div class="col-lg-6">
                    <label class="form-label">Current Position</label>
                    <input type="text" class="form-control" name="_currPosition" value="@Model.Position.PositionName" readonly>
                </div>
                <div class="col-lg-6">
                    <label class="form-label">Employment Level</label>
                    <input type="text" class="form-control" name="_empLevel" value="@Model.EmploymentLevel.Name" readonly>
                </div>
            </div>
            <div class="mb-3 d-flex justify-content-between align-items-center">
                <label class="form-label mb-0">Job performed by employee is critical to operations?</label>
                <span class="form-check form-check-single form-switch">
                    <input class="form-check-input" name="_isCritical" type="checkbox" value="true" @(Model.ReservationDetails.FirstOrDefault().isCritical == true ? "checked" : "") />
                </span>
            </div>
            <div class="mb-3 d-flex justify-content-between align-items-center">
                <label class="form-label mb-0">Employee is often on call to perform job function?</label>
                <span class="form-check form-check-single form-switch">
                    <input class="form-check-input" name="_isOnCall" type="checkbox" value="true" @(Model.ReservationDetails.FirstOrDefault().isOnCall == true ? "checked" : "") />
                </span>
            </div>
            <div class="mb-3">
                <div>
                    <label class="form-label">Remarks <span class="form-label-description"></span></label>
                    <textarea class="form-control" rows="2" name="_deptRemarks" value="@Model.ReservationDetails.FirstOrDefault().DeptHeadRemarks" required readonly>@Model.ReservationDetails.FirstOrDefault().DeptHeadRemarks</textarea>
                </div>
            </div>
        </div>
        <div class="modal-footer">
            <a href="@Url.Action("ReservationList", "Dorm")" class="btn btn-link link-secondary">
                Go Back
            </a>
            <div class="ms-auto">
                <button type="button" class="btn btn-red" data-bs-toggle="modal" data-bs-target="#modal-danger">
                    <i class="ti ti-ban m-1"></i> Disapprove
                </button>
                <button type="submit" name="action" value="Approve" class="btn btn-primary">
                    <i class="ti ti-check m-1"></i> Approve
                </button>
            </div>
        </div>
</form>
