@model PropertyManagementSystem.Models.ReservationViewModel
@inject PropertyManagementSystem.Services.IRoleService RoleService
@{
    var employee = await RoleService.GetUserName(User);
}
<div class="modal modal-blur fade" id="modal-newReservatoion" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content reservation-modal">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title">New Application</h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="fcFRM1" asp-controller="Dorm" asp-action="CreateReservation" method="post">
                <div class="modal-body">
                    <div class="reservation-modal-intro">
                        <i class="ti ti-home-check"></i>
                        <div>
                            <strong>Start with applicant details</strong>
                            <span>Confirm the employee profile and department before completing the housing application.</span>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-lg-6">
                            <label class="form-label required">Requestor Name</label>
                            <input class="form-control" name="_requestor" type="text" value="@employee.Fullname" readonly>
                        </div>
                        <div class="col-lg-6">
                            <label class="form-label required">Requestor Email</label>
                            <input class="form-control" name="_requestorEmail" type="email" required="required" value="@employee.Email" readonly>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label required">Company</label>
                        @(Html.Kendo().DropDownList()
                            .Name("_company")
                            .DataTextField("Company")
                            .DataValueField("Id")
                            .Value(employee.CompanyId.ToString())
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("getCompanies", "Global");
                                });
                            })
                            .HtmlAttributes(new { style = "width: 100%; font-size: 15px; font-weight: bold; border-color: var(--tblr-muted); opacity: .8;" })
                            .OptionLabel("Select Company")
                            )
                    </div>
                    <div class="mb-3">
                        <label class="form-label required">Department</label>
                        @(Html.Kendo().DropDownList()
                            .Name("_department")
                            .DataTextField("DepartmentName")
                            .DataValueField("Id")
                            .CascadeFrom("_company")
                            .Value(employee.DepartmentId.ToString())
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("getDepartments", "Global").Data("filterDepartments");
                                }).ServerFiltering(true);
                            })
                            .HtmlAttributes(new { style = "width: 100%; font-size: 15px; font-weight: bold; border-color: var(--tblr-muted); opacity: .8;" })
                            )
                    </div>
                </div>
                <div class="modal-footer">
                    <button id="svbtn15" type="submit" class="btn btn-primary ms-auto">
                        <i class="ti ti-arrow-right" aria-hidden="true"></i>
                        Continue
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
