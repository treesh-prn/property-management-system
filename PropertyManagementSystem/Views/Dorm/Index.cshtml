@model PropertyManagementSystem.Models.ReservationViewModel
@inject PropertyManagementSystem.Services.IRoleService RoleService

@{
    ViewData["Title"] = "Home Page";
    var rooms = ViewData["Rooms"] as List<PropertyManagementSystem.Models.GFMS_Rooms>;
    var facilities = ViewData["Facilities"] as List<PropertyManagementSystem.Models.GFMS_Facility>;
    //var rooms = ViewData["Rooms"] as List<GFMS_Rooms>;
    //var facilityNames = ViewData["Facility"] as List<GFMS_Facility>;

    var employee = await RoleService.GetUserName(User);
}
<div class="page-wrapper">
    <!-- Page header -->
    <div class="page-header d-print-none">
        <div class="container-xl">
            <div class="row g-2 align-items-center">
                <div class="col">
                    <!-- Page pre-title -->
                    <div class="page-pretitle">
                        ACCOMMODATION
                    </div>
                    <h2 class="page-title">
                        DORM and HOUSING
                    </h2>
                </div>
                <!-- Page title actions -->
                <div class="col-auto ms-auto d-print-none">
                    <div class="btn-list">
                        <span class="d-none d-sm-inline">
                            <a href="@Url.Action("ReservationList","Dorm")" class="btn">
                                Reservation List
                            </a>
                        </span>
                        <a href="#" class="btn btn-primary d-none d-sm-inline-block" data-bs-toggle="modal" data-bs-target="#modal-newReservatoion">
                            <i class="ti ti-plus"></i>
                            Create New Application
                        </a>
                        <a href="#" class="btn btn-primary d-sm-none btn-icon" data-bs-toggle="modal" data-bs-target="#modal-report" aria-label="Create New Reservation">
                            <i class="ti ti-plus"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Page body -->
    <div class="page-body">
        <div class="container-xl">
            <div class="row row-deck row-cards">
                <div class="row row-deck row-cards">
                    <div class="col-12">
                        <div class="row row-cards">
                            <div class="col-sm-6 col-lg-3">
                                <div class="card card-sm">
                                    <div class="card-body">
                                        <div class="row align-items-center">
                                            <div class="col-auto">
                                                <span class="bg-primary text-white avatar">
                                                    <i class="ti ti-user-star" style="font-size: 30px;"></i>
                                                </span>
                                            </div>
                                            <div class="col">
                                                <div class="font-weight-heavy">
                                                    @Model.NewReservationsCount
                                                </div>
                                                <div class="text-secondary">
                                                    New Reservations
                                                </div>
                                            </div>
                                            <div class="col-auto">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-6 col-lg-3">
                                <div class="card card-sm">
                                    <div class="card-body">
                                        <div class="row align-items-center">
                                            <div class="col-auto">
                                                <span class="bg-success text-white avatar">
                                                    <i class="ti ti-friends" style="font-size: 30px;"></i>
                                                </span>
                                            </div>
                                            <div class="col">
                                                <div class="font-weight-heavy">
                                                    10
                                                </div>
                                                <div class="text-secondary">
                                                    Active Guest Count
                                                </div>
                                            </div>
                                            <div class="col-auto">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-6 col-lg-3">
                                <div class="card card-sm">
                                    <div class="card-body">
                                        <div class="row align-items-center">
                                            <div class="col-auto">
                                                <span class="bg-danger text-white avatar">
                                                    <i class="ti ti-bed" style="font-size: 30px;"></i>
                                                </span>
                                            </div>
                                            <div class="col">
                                                <div class="font-weight-heavy">
                                                    @Model.OccupiedRoomsCount
                                                </div>
                                                <div class="text-secondary">
                                                    Occupied Rooms
                                                </div>
                                            </div>
                                            <div class="col-auto">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-6 col-lg-3">
                                <div class="card card-sm">
                                    <div class="card-body">
                                        <div class="row align-items-center">
                                            <div class="col-auto">
                                                <span class="bg-warning text-white avatar">
                                                    <i class="ti ti-home" style="font-size: 30px;"></i>
                                                </span>
                                            </div>
                                            <div class="col">
                                                <div class="font-weight-heavy">
                                                    @Model.AvailableRoomsCount
                                                </div>
                                                <div class="text-secondary">
                                                    Available Room
                                                </div>
                                            </div>
                                            <div class="col-auto">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            @(Html.Kendo().Scheduler<PropertyManagementSystem.Models.ReservationViewModel>()
                                .Name("scheduler")
                                .MajorTick(1440)
                                .MinorTickCount(1)
                                .DateHeaderTemplate("<strong>#=kendo.toString(date, 'D')#</strong>")
                                
                                .Timezone("Etc/UTC")
                                .Group(g => g.Resources("Rooms", "Facilities").Orientation(SchedulerGroupOrientation.Vertical))
                                .Resources(resource =>
                                {
                                    resource.Add(m => m.FacilityId)
                                    .Title("Facility")
                                    .Name("Facilities")
                                    .DataTextField("FacilityName")
                                    .DataValueField("FacilityId")
                                    .BindTo(facilities.Select(f => new
                                    {
                                        FacilityId = f.FacilityId,
                                        FacilityName = f.FacilityName
                                    }));

                                    resource.Add(m => m.RoomId)
                                    .Title("Room")
                                    .Name("Rooms")
                                    .DataTextField("RoomName")
                                    .DataValueField("RoomId")
                                    .DataParentValueField("FacilityId")
                                    .BindTo(rooms.Select(r => new
                                    {
                                        RoomId = r.RoomId,
                                        RoomName = r.RoomName,
                                        FacilityId = r.FacilityId
                                    }));


                                })
                                .DataSource(d => d
                                .Model(m =>
                                {
                                    m.Id(f => f.ReservationId);
                                    m.Field(f => f.Title).DefaultValue("No title");
                                    m.Field(f => f.GUID);
                                    m.RecurrenceId(f => f.RecurrenceID);
                                    m.Field(f => f.RoomId);
                                    m.Field(f => f.FacilityId);
                                })
                                .Read("ViewReservation", "Dorm")
                                .Update("ViewReservationDetails", "Dorm")
                                .Destroy(destroy => destroy.Action("DeleteReservationDetail", "Dorm"))
                                )
                                .Events(events => events
                                .DataBound("onDataBound")
                                .Edit("onEditViewG"))
                                )
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@*NEW APPLICATION FORM *@
<partial name="Shared/_newReservation" />
@*END - NEW Room MODAL *@