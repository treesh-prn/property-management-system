@{
    ViewData["Title"] = "Home Page";
    var activeRole = await RoleService.GetActiveRoleAsync(User);
    var isRequestorView = activeRole == "GFMS.Requestor";
}
<div class="page-wrapper reservation-page">
    <!-- Page header -->
    <div class="page-header d-print-none">
        <div class="container-xl">
            <div class="row g-2 align-items-center">
                <div class="col">
                    <!-- Page pre-title -->
                    <div class="page-pretitle">Reservation</div>
                    <h2 class="page-title">
                        Dorm and Housing Applications
                    </h2>
                    <div class="text-secondary mt-1">Review existing requests and their approval status.</div>
                </div>
                <!-- Page title actions -->
                <div class="col-auto ms-auto d-print-none">
                    <div class="btn-list">
                        <button type="button" class="btn btn-secondary" disabled aria-disabled="true" title="Dorm and Housing applications are coming soon">
                            <i class="ti ti-lock"></i>
                            Coming soon
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Page body -->
    <div class="page-body">
        <div class="container-xl">
            <div class="alert alert-info" role="status">
                <i class="ti ti-info-circle me-2" aria-hidden="true"></i>
                <strong>Dorm and Housing applications are coming soon.</strong>
                New applications are temporarily unavailable. Existing requests remain visible below.
            </div>
            <div class="row row-deck row-cards">
                <div class="col-lg-12 col-md-12">
                    <div class="card reservation-list-card">
                        <div class="card-header reservation-list-heading">
                            <div>
                                <span class="reservation-eyebrow">@(isRequestorView ? "My requests" : "Application workspace")</span>
                                <h3 class="card-title">Dorm and housing applications</h3>
                                <p class="card-subtitle">@(isRequestorView ? "Continue a draft or track approval progress." : "Review pending approvals or open your submitted applications.")</p>
                            </div>
                        </div>
                        @if (isRequestorView)
                        {
                            <div class="card-body">
                                <partial name="Shared/_myReservation" />
                            </div>
                        }
                        else
                        {
                        @(Html.Kendo().TabStrip()
                                .Name("tabstrip")
                                .Animation(animation =>
                                animation.Open(effect =>
                                effect.Fade(FadeDirection.In)))
                                .Items(tabstrip =>
                                {
                                if (!isRequestorView)
                                {
                                    tabstrip.Add().Text("Reservation Request")
                                    .Encoded(false)
                                    .Selected(true)
                                    .Content(@<text>
                                    <div id="reservationApproval">
                                        <partial name="Shared/_myApprovals" />   
                                    </div>
                                    </text>);
                                    tabstrip.Add().Text("My Reservation")
                                    .Encoded(false)
                                    .Content(@<text>
                                    <div id="myReservation">
                                        <partial name="Shared/_myReservation" />
                                    </div>
                                    </text>);
                                }else{
                                     tabstrip.Add().Text("My Reservation")
                                    .Encoded(false)
                                    .Selected(true)
                                    .Content(@<text>
                                    <div id="myReservation">
                                        <partial name="Shared/_myReservation" />
                                    </div>
                                    </text>);
                                }       
                                })
                            )
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@*DELETE MODAL*@
<div class="modal modal-blur fade" id="modal-danger" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered" role="document">
        <div class="modal-content">
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            <div class="modal-status bg-danger"></div>
            <div class="modal-body text-center py-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="icon mb-2 text-danger icon-lg" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M12 9v4" /><path d="M10.363 3.591l-8.106 13.534a1.914 1.914 0 0 0 1.636 2.871h16.214a1.914 1.914 0 0 0 1.636 -2.87l-8.106 -13.536a1.914 1.914 0 0 0 -3.274 0z" /><path d="M12 16h.01" /></svg>
                <h3>Are you sure?</h3>
                <div class="text-secondary">Do you really want to remove this record? This action cannot be undone.</div>
            </div>
            <form id="delete-form" action="@Url.Action("DeleteReservationDetail", "Dorm")" method="post">
                <div class="modal-footer">
                    <div class="w-100">
                        <div class="row">
                            <div class="col">
                                <a href="#" class="btn w-100" data-bs-dismiss="modal">
                                    Cancel
                                </a>
                            </div>
                            <div class="col">
                                <button type="submit" class="btn btn-danger w-100" id="confirm-delete">
                                    Delete
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                <input type="hidden" name="ReservationId" id="modal-reservation-id" />
            </form>
        </div>
    </div>
</div>
@*END DELETE MODAL*@
@inject PropertyManagementSystem.Services.IRoleService RoleService
