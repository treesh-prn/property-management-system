@inject PropertyManagementSystem.Services.IRoleService RoleService
@{
    ViewData["Title"] = "Home Page";
    var activeRole = await RoleService.GetActiveRoleAsync(User);
}
<div class="page-wrapper">
    <!-- Page header -->
    <div class="page-header d-print-none">
        <div class="container-xl">
            <div class="row g-2 align-items-center">
                <div class="col">
                    <!-- Page pre-title -->
                    <div class="page-pretitle">
                        Reservation
                    </div>
                    <h2 class="page-title">
                        DORM and HOUSING
                    </h2>
                </div>
                <!-- Page title actions -->
                <div class="col-auto ms-auto d-print-none">
                    <div class="btn-list">
                        @if (activeRole == "GFMS.Requestor")
                        {
                            <a href="#" class="btn btn-primary d-none d-sm-inline-block" data-bs-toggle="modal" data-bs-target="#modal-newReservatoion">
                                <i class="ti ti-plus"></i>
                                Create New Application
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Page body -->
    <div class="page-body">
        <div class="container-xl">
            <div class="row row-deck row-cards">
                <div class="col-lg-12 col-md-12">
                    <div class="card">
                       @(Html.Kendo().TabStrip()
                                .Name("tabstrip")
                                .Animation(animation =>
                                animation.Open(effect =>
                                effect.Fade(FadeDirection.In)))
                                .Items(tabstrip =>
                                {
                                if (activeRole != ("GFMS.Requestor"))
                                {
                                    tabstrip.Add().Text("Reservation Request")
                                    .Encoded(false)
                                    .Selected(true)
                                    .Content(@<text>
                                    <div id="reservationApproval">
                                        <partial name="Shared/_myApprovals" />   
                                    </div>
                                    </text>);
                                     if(activeRole == "GFMS.Admin Approver" || activeRole == "GFMS.Admin Manager"){
                                     tabstrip.Add().Text("Approved Reservations")
                                    .Encoded(false)
                                    .Content(@<text>
                                    <div id="approvedReservation">
                                        <partial name="Shared/_approvedReservation" />   
                                    </div>
                                    </text>);
                                }
                                }
                                else{
                                     tabstrip.Add().Text("My Reservation")
                                    .Encoded(false)
                                    .Selected(true)
                                    .Content(@<text>
                                    <div id="myReservation">
                                        <partial name="Shared/_myReservation" />
                                    </div>
                                    </text>);
                                }       
                                })
                            )
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<partial name="Shared/_newReservation" />
@*DELETE MODAL*@
<div class="modal modal-blur fade" id="deleteReservationModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered" role="document">
        <div class="modal-content">
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            <div class="modal-status bg-danger"></div>
            <div class="modal-body text-center py-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="icon mb-2 text-danger icon-lg" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M12 9v4" /><path d="M10.363 3.591l-8.106 13.534a1.914 1.914 0 0 0 1.636 2.871h16.214a1.914 1.914 0 0 0 1.636 -2.87l-8.106 -13.536a1.914 1.914 0 0 0 -3.274 0z" /><path d="M12 16h.01" /></svg>
                <h3>Are you sure?</h3>
                <div class="text-secondary">Do you really want to remove this record? This action cannot be undone.</div>
            </div>
            <form id="delete-form" action="@Url.Action("DeleteReservationDetail", "Dorm")" method="post">
                <div class="modal-footer">
                    <div class="w-100">
                        <div class="row">
                            <div class="col">
                                <a href="#" class="btn w-100" data-bs-dismiss="modal">
                                    Cancel
                                </a>
                            </div>
                            <div class="col">
                                <button type="submit" class="btn btn-danger w-100" id="confirm-delete">
                                    Delete
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                <input type="hidden" name="ReservationId" id="modal-reservation-id" />
            </form>
        </div>
    </div>
</div>
@*END DELETE MODAL*@
@*START WARNING MODAL*@
<div class="modal modal-blur fade" id="modal-confirmation" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered" role="document">
        <div class="modal-content">
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            <div class="modal-status bg-warning"></div>
            <div class="modal-body text-center py-4">
                <!-- Warning Icon -->
                <div class="mb-3">
                    <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                         stroke-linejoin="round" class="text-yellow">
                        <path d="M12 2L2 22h20L12 2z"></path>
                        <path d="M12 16h.01"></path>
                        <path d="M12 10h.01"></path>
                    </svg>
                </div>
                <h3>Renew Dorm Applications</h3>
                <p class="text-secondary">
                    This action will mark all dorm applications for renewal. Are you sure you want to continue?
                </p>
            </div>
            <div class="modal-footer">
                <div class="w-100">
                    <div class="row">
                        <div class="col">
                            <button type="button" class="btn btn-light w-100" data-bs-dismiss="modal">Cancel</button>
                        </div>
                        <div class="col">
                            <form id="renewalForm" method="post" asp-controller="Dorm" asp-action="TriggerDormRenewalNow">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-primary w-100" id="confirmSubmit">Confirm & Submit</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@*END WARNING MODAL*@