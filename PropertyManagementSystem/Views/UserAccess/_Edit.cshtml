@model GfmsUserAccessEditViewModel
@{
    var descriptions = new Dictionary<string, string>
    {
        [ReservationRoles.Requestor] = "Create reservations and manage personal requests.",
        [ReservationRoles.DepartmentHead] = "Review requests assigned for department approval.",
        [ReservationRoles.AdminApprover] = "Review requests, assign resources, and access Setup and Reports.",
        [ReservationRoles.SystemAdmin] = "Manage GFMS user access, Setup, and Reports."
    };
    var initials = string.Concat(Model.Name.Split(new[] { ' ', '.', '@', '_' }, StringSplitOptions.RemoveEmptyEntries).Take(2).Select(part => char.ToUpperInvariant(part[0])));
    var editableRoles = GfmsUserAccessPolicy.Roles.Where(role => role != ReservationRoles.AdminManager).ToArray();
}
<form method="post" asp-action="Edit" asp-controller="UserAccess" class="access-edit-form">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="ConcurrencyStamp" />
    <input type="hidden" asp-for="Search" />
    <input type="hidden" asp-for="Page" />
    @if (Model.SelectedRoles.Contains(ReservationRoles.AdminManager))
    {
        <input type="hidden" name="SelectedRoles" value="@ReservationRoles.AdminManager" />
    }
    <div class="access-edit-scroll">
    <div class="access-account-summary">
        <span class="access-profile" aria-hidden="true">@initials</span>
        <div><h3 class="mb-1">@Model.Name</h3><div class="text-secondary text-break">@Model.Email</div></div>
    </div>
    <fieldset class="access-role-fieldset">
        <legend>Assigned roles <span class="access-selection-count" data-selected-count>@Model.SelectedRoles.Count(role => role != ReservationRoles.AdminManager) selected</span></legend>
        <p class="text-secondary small mb-3">Choose the access this person needs. Changes apply when you save.</p>
        @for (var index = 0; index < editableRoles.Length; index++)
        {
            var role = editableRoles[index];
            var available = Model.AvailableRoles.Contains(role);
            <div class="access-role-option @(!available ? "access-role-unavailable" : "")">
                <label class="access-role-option-label" for="access-role-@index">
                    <span class="access-role-option-copy"><span class="access-role-option-name">@role.Replace("GFMS.", "")</span>
                        <span class="access-role-description" id="access-role-description-@index">@(available ? descriptions[role] : "This role is not configured in the Identity database.")</span>
                    </span>
                    <span class="form-check form-switch m-0">
                    <input type="checkbox" role="switch" class="form-check-input" id="access-role-@index" name="SelectedRoles" value="@role" aria-describedby="access-role-description-@index"
                           checked="@Model.SelectedRoles.Contains(role)" disabled="@(!available)" />
                    </span>
                </label>
            </div>
        }
    </fieldset>
    <div class="access-scope-note"><i class="ti ti-shield-check" aria-hidden="true"></i><div><strong>GFMS access only</strong><p>Roles for other applications are preserved. You must retain your own System Admin role.</p></div></div>
    @if (Model.SelectedRoles.Contains(ReservationRoles.AdminManager))
    {
        <p class="text-secondary small mt-3 mb-0">Existing Admin Manager access is preserved and cannot be changed in this form.</p>
    }
    <div class="alert alert-warning mt-3 mb-0" data-no-roles hidden>No roles selected. Saving will remove the GFMS roles shown above.</div>
    <p class="text-secondary small mt-3 mb-0">After saving, ask the user to sign out and sign in again, then select their active role. Approval also depends on the request's workflow and assigned approver.</p>
    </div>
    <div class="access-edit-footer">
        <div class="access-edit-status" data-edit-status role="status">No changes to save</div>
        <div class="d-flex justify-content-end gap-2">
            <button type="button" class="btn" data-bs-dismiss="offcanvas">Cancel</button>
            <button type="submit" class="btn btn-primary">Save changes</button>
        </div>
    </div>
</form>
