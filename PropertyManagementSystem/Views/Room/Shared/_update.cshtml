@model PropertyManagementSystem.Models.RoomViewModel;

    <input type="hidden" name="_roomId" asp-for="RoomId" />
    <input type="hidden" name="_roomType" asp-for="RoomType" />

    <div class="mb-3">
        <label class="form-label required">Room Name </label>
        <input class="form-control" name="_roomName" type="text" required="required" asp-for="RoomName">
    </div>
    <div class="mb-3">
        <label class="form-label required">Facility</label>
        @(Html.Kendo().DropDownList()
            .Name("_facility")
            .DataTextField("FacilityName")
            .DataValueField("FacilityId")
            .DataSource(source =>
            {
                source.Read(read => read.Action(Model.RoomType == 0 ? "getGHList" : Model.RoomType == 1 ? "getFNList" : "getDMList", "Facility"));
            })
            .Value(Model.FacilityId.ToString())
            .HtmlAttributes(new { style = "width: 100%" })
            )
    </div>
    <div class="mb-3">
        <label class="form-label required">Status</label>
        @(Html.Kendo().DropDownList()
            .Name("_roomStatus")
            .BindTo(new List<SelectListItem>
        {
        new SelectListItem() { Text = "Open", Value = "Open" },
        new SelectListItem() { Text = "Occupied", Value = "Occupied" },
        new SelectListItem() { Text = "Under Maintenance", Value = "Under Maintenance" }
        })
            .Value(Model.RoomStatus)
            .HtmlAttributes(new { style = "width: 100%" })
            )
    </div>
    <div class="mb-3">
        <label class="form-label required">Capacity</label>
        <input class="form-control" name="_capacity" type="number" required="required" asp-for="Capacity">
    </div>
    <div class="mb-3">
        <label class="form-label required">Cost Per Day</label>
        <input class="form-control" name="_costPerDay" type="number" step="0.01" asp-for="CostPerDay">
    </div>
    <div class="mb-3">
        <label class="form-label required">Cost Per Week</label>
        <input class="form-control" name="_costPerWeek" type="number"  asp-for="CostPerWeek">
    </div>
    <div class="mb-3">
        <label class="form-label required">Cost Per Month</label>
        <input class="form-control" name="_costPerMonth" type="number" asp-for="CostPerMonth">
    </div>
   
@if (Model.RoomType.Equals(1))
{
    <div class="mb-3">
        <label for="equipmentMultiSelect" class="form-label">Select Equipments</label>
        @(Html.Kendo().MultiSelect()
            .Name("SelectedEquipmentIds")
            .Placeholder("Select Equipments...")
            .DataTextField("EquipmentName")
            .DataValueField("Id")
            .Value(Model.SelectedEquipmentIds)
            .AutoBind(true)
            .DataSource(source =>
            {
                source.Read(read =>
                {
                    read.Action("GetEquipmentList", "Equipment");
                });
            })
            .AutoClose(false)
            .TagMode(MultiSelectTagMode.Multiple)
            )
    </div>
}
<label class="row">
    <span class="col form-label">Is Active</span>
    <span class="col-auto">
        <label class="form-check form-check-single form-switch">
            <input class="form-check-input" name="_isActive" type="checkbox" value="true" @(Model.isActive == true ? "checked" : "") />
        </label>
    </span>
</label>

