@model PropertyManagementSystem.Models.RoomViewModel;
<form asp-action="EditGHRoom" asp-controller="Room" method="post" class="management-update-form">
    <input type="hidden" name="_roomId" asp-for="RoomId" />
    <input type="hidden" name="_roomType" asp-for="RoomType" />

    <div class="management-form-section-title">Room information</div>
    <div class="mb-3">
        <label class="form-label required">Room Name </label>
        <input class="form-control" name="_roomName" type="text" required="required" asp-for="RoomName">
    </div>
    <div class="mb-3">
        <label class="form-label required">Facility</label>
        @(Html.Kendo().DropDownList()
            .Name("_facility")
            .DataTextField("FacilityName")
            .DataValueField("FacilityId")
            .DataSource(source =>
            {
                source.Read(read => read.Action(Model.RoomType == 0 ? "getGHList" : Model.RoomType == 1 ? "getFNList" : "getDMList", "Facility"));
            })
            .Value(Model.FacilityId.ToString())
            .HtmlAttributes(new { style = "width: 100%" })
            )
    </div>
    <div class="mb-3">
        <label class="form-label required">Status</label>
        @(Html.Kendo().DropDownList()
            .Name("_roomStatus")
            .BindTo(new List<SelectListItem>
        {
        new SelectListItem() { Text = "Open", Value = "Open" },
        new SelectListItem() { Text = "Occupied", Value = "Occupied" },
        new SelectListItem() { Text = "Under Maintenance", Value = "Under Maintenance" }
        })
            .Value(Model.RoomStatus)
            .HtmlAttributes(new { style = "width: 100%" })
            )
    </div>
    <div class="mb-3">
        <label class="form-label required">Capacity</label>
        <input class="form-control" name="_capacity" type="number" min="1" max="1000" step="1" inputmode="numeric" required="required" asp-for="Capacity" aria-describedby="edit-room-capacity-help">
        <div id="edit-room-capacity-help" class="form-hint">Enter a whole number from 1 to 1,000.</div>
    </div>
    <div class="mb-3">
        <label class="form-label">Cost Per Day <span class="text-secondary">Optional</span></label>
        <input class="form-control" name="_costPerDay" type="number" min="0" step="0.01" inputmode="decimal" asp-for="CostPerDay">
    </div>
    <div class="mb-3">
        <label class="form-label">Cost Per Week <span class="text-secondary">Optional</span></label>
        <input class="form-control" name="_costPerWeek" type="number" min="0" step="0.01" inputmode="decimal" asp-for="CostPerWeek">
    </div>
    <div class="mb-3">
        <label class="form-label">Cost Per Month <span class="text-secondary">Optional</span></label>
        <input class="form-control" name="_costPerMonth" type="number" min="0" step="0.01" inputmode="decimal" asp-for="CostPerMonth">
        <div class="form-hint">Leave rate fields blank when no standard room charge applies.</div>
    </div>
    <div class="management-form-section-title">Availability</div>
    <label class="management-toggle-row">
        <span class="col form-label">Is Active</span>
        <span class="col-auto">
            <label class="form-check form-check-single form-switch">
                <input class="form-check-input" name="_isActive" type="checkbox" value="true" @(Model.isActive == true ? "checked" : "") />
            </label>
        </span>
    </label>
    <div class="management-form-actions">
        <button type="submit" class="btn btn-primary"><i class="ti ti-device-floppy" aria-hidden="true"></i> Save Changes</button>
    </div>
</form>
