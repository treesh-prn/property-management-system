@{
    ViewData["Title"] = "Home Page";

}
<div class="page-wrapper management-page management-list-page">
    <!-- Page header -->
    <div class="page-header d-print-none">
        <div class="container-xl">
            <div class="row g-2 align-items-center">
                <div class="col">
                    <!-- Page pre-title -->
                    <div class="page-pretitle">
                        Room
                    </div>
                    <h2 class="page-title">
                        Guest Rooms
                    </h2>
                    <div class="text-secondary mt-1">Manage guest accommodations, capacities, availability, and facility assignments.</div>
                </div>
                <!-- Page title actions -->
                <div class="col-auto ms-auto d-print-none">
                    <div class="btn-list">
                        @*   <span class="d-none d-sm-inline">
                        <a href="#" class="btn">
                        New view
                        </a>
                        </span>
                        <a href="#" class="btn btn-primary d-none d-sm-inline-block" data-bs-toggle="modal" data-bs-target="#modal-report">
                        <!-- Download SVG icon from http://tabler-icons.io/i/plus -->
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M12 5l0 14" /><path d="M5 12l14 0" /></svg>
                        Create new report
                        </a>
                        <a href="#" class="btn btn-primary d-sm-none btn-icon" data-bs-toggle="modal" data-bs-target="#modal-report" aria-label="Create new report">
                        <!-- Download SVG icon from http://tabler-icons.io/i/plus -->
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M12 5l0 14" /><path d="M5 12l14 0" /></svg>
                        </a> *@
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Page body -->
    <div class="page-body">
        <div class="container-xl">
            <div class="row row-deck row-cards">
                <div class="col-lg-12 col-md-12">
                    <div class="card management-list-card">
                        <div class="card-header management-card-header">
                            <div>
                                <span class="reservation-eyebrow">Room directory</span>
                                <h3 class="card-title">Guest rooms</h3>
                                <p class="card-subtitle">Search, review, and maintain guest room records.</p>
                            </div>
                            <div class="card-actions">
                                <a href="#offcanvasEnd" class="btn btn-primary" data-bs-toggle="offcanvas" data-bs-target="#offcanvasEnd" aria-controls="offcanvasEnd">
                                    <i class="ti ti-home-plus icon"></i>
                                    New Guest Room
                                </a>
                            </div>
                        </div>
                        <div class="card-body p-0">
                            @(
                                Html.Kendo().Grid<PropertyManagementSystem.Models.GFMS_Rooms>()
                                .Name("roomGrid")
                                .HtmlAttributes(new { @class = "management-grid setup-grid" })
                                .Excel(excel => excel
                                .FileName("Rooms.xlsx")
                                .AllPages(true))
                                .Columns(columns =>
                                {
                                    columns.Bound(c => c.RoomId).Visible(false).Exportable(false);
                                    columns.ForeignKey(c => c.FacilityId, ds => ds.Read(r => r.Action("getGHList", "Facility")), "FacilityId", "FacilityName").Title("Facility").Width(260).Filterable(ftb => ftb.Cell(cell => cell.ShowOperators(false)));
                                    columns.Bound(c => c.RoomName).Title("Room").Width(240);
                                    columns.Bound(c => c.Capacity).Width(120);
                                    columns.Bound(c => c.isActive).ClientTemplate(
                                    "# if(isActive == 1) { #" +
                                    "<span class='status status-teal'><span class='status-dot'></span>Active</span>" +
                                    "# } else { #" +
                                    "<span class='status status-red'><span class='status-dot'></span>Inactive</span>" +
                                    "# } #"
                                    ).Title("Status").Width(130);
                                    columns.Bound(c => c.RoomStatus).ClientTemplate(
                                    "# if(RoomStatus === 'Open') { #" +
                                    "<span class='status status-teal'><span class='status-dot'></span>Open</span>" +
                                    "# } else if(RoomStatus === 'Occupied') { #" +
                                    "<span class='status status-red'><span class='status-dot'></span>Occupied</span>" +
                                    "# } else if(RoomStatus === 'Under Maintenance') { #" +
                                    "<span class='status status-yellow'><span class='status-dot'></span>Under Maintenance</span>" +
                                    "# } #"
                                    ).Title("Availability").Width(190);
                                    columns.Command(command =>
                                    {
                                        command.Custom("view")
                                    .Text("<i class='ti ti-eye'></i> View")
                                    .Click("onViewClick")
                                    .HtmlAttributes(new { @class = "k-button k-grid-View setup-action setup-action-view" });
                                    })
                                    .Title("Actions")
                                    .Width(140)
                                    .Exportable(false);
                                })
                                .ToolBar(toolbar =>
                                {
                                    toolbar.Excel();
                                    toolbar.Search();
                                })
                                .Pageable()
                                .Scrollable(scrollable => scrollable.Height("auto"))
                                .Filterable()
                                .DataSource(dataSource => dataSource
                                .Ajax()
                                .Model(model => model.Id(p => p.RoomId))
                                .Read(read => read.Action("getGHRooms", "Room").Type(HttpVerbs.Get))
                                .PageSize(50)
                                )
                                )

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>
@*off canvas edit form*@
<form id="fcFRM1" asp-controller="Room" asp-action="newGHRoom" enctype="multipart/form-data" method="post">
<div class="offcanvas offcanvas-end management-offcanvas" tabindex="-1" id="offcanvasEnd" aria-labelledby="offcanvasEndLabel">
    <div class="offcanvas-header">
        <div>
            <span class="reservation-eyebrow">Room setup</span>
            <h2 class="offcanvas-title" id="offcanvasEndLabel">New Guest Room</h2>
            <p>Add guest accommodation and define its facility, capacity, and status.</p>
        </div>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
            <div class="management-form-section-title">Room information</div>
            <div class="mb-3">
                <label class="form-label required">Room Name </label>
                <input class="form-control" name="_name" type="text" required="required">
            </div>
            <div class="mb-3">
                <label class="form-label required">Facility</label>
                @(Html.Kendo().DropDownList()
                    .Name("_facility")
                    .DataTextField("FacilityName")
                    .DataValueField("FacilityId")
                    .DataSource(source =>
                    {
                        source.Read(read =>
                        {
                            read.Action("getGHList", "Facility");
                        });
                    })
                    .HtmlAttributes(new { style = "width: 100%" })
                    )
            </div>
            <div class="mb-3">
                <label class="form-label required">Status</label>
                @(Html.Kendo().DropDownList()
                    .Name("_status")
                    .BindTo(new List<SelectListItem>
                {
                new SelectListItem() {
                Text = "Open",
                Value = "Open"
                },
                new SelectListItem() {
                Text = "Occupied",
                Value = "Occupied"
                },
                new SelectListItem() {
                Text = "Under Maintenance",
                Value = "Under Maintenance"
                },
                })
                    .HtmlAttributes(new { style = "width: 100%" })
                    )
            </div>
            <div class="mb-3">
                <label class="form-label required">Capacity</label>
                <input class="form-control" name="_capacity" type="number" min="1" max="1000" step="1" inputmode="numeric" required="required" aria-describedby="guest-room-capacity-help">
                <div id="guest-room-capacity-help" class="form-hint">Enter a whole number from 1 to 1,000.</div>
            </div>
            <div class="management-form-section-title">Rates <span class="text-secondary">Optional</span></div>
            <div class="mb-3">
                <label class="form-label" for="guestRoomCostPerDay">Cost Per Day <span class="text-secondary">Optional</span></label>
                <input id="guestRoomCostPerDay" class="form-control" name="_costPerDay" type="number" min="0" step="0.01" inputmode="decimal" placeholder="0.00">
            </div>
            <div class="mb-3">
                <label class="form-label" for="guestRoomCostPerWeek">Cost Per Week <span class="text-secondary">Optional</span></label>
                <input id="guestRoomCostPerWeek" class="form-control" name="_costPerWeek" type="number" min="0" step="0.01" inputmode="decimal" placeholder="0.00">
            </div>
            <div class="mb-3">
                <label class="form-label" for="guestRoomCostPerMonth">Cost Per Month <span class="text-secondary">Optional</span></label>
                <input id="guestRoomCostPerMonth" class="form-control" name="_costPerMonth" type="number" min="0" step="0.01" inputmode="decimal" placeholder="0.00">
                <div class="form-hint">Leave rate fields blank when no standard room charge applies.</div>
            </div>
            <div class="management-form-section-title">Availability</div>
            <div class="management-toggle-row">
                <label for="isActiveCheckbox" class="form-label me-auto">Is Active</label>
                <div class="form-check form-switch">
                    <input class="form-check-input" id="switch" name="_isActive" type="checkbox" value="true" checked>
                </div>
            </div>
    </div>
    <div class="offcanvas-footer">
            <button type="submit" class="btn btn-primary" form="fcFRM1">Add Room</button>
    </div>
</div>
</form>

@*DELETE MODAL*@
<div class="modal modal-blur fade" id="modal-danger" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered" role="document">
        <div class="modal-content">
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            <div class="modal-status bg-danger"></div>
            <div class="modal-body text-center py-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="icon mb-2 text-danger icon-lg" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M12 9v4" /><path d="M10.363 3.591l-8.106 13.534a1.914 1.914 0 0 0 1.636 2.871h16.214a1.914 1.914 0 0 0 1.636 -2.87l-8.106 -13.536a1.914 1.914 0 0 0 -3.274 0z" /><path d="M12 16h.01" /></svg>
                <h3>Are you sure?</h3>
                <div class="text-secondary">Do you really want to remove this record? This action cannot be undone.</div>
            </div>
            <form id="delete-form" action="@Url.Action("DeleteGHRoom", "Room")" method="post">
                <div class="modal-footer">
                    <div class="w-100">
                        <div class="row">
                            <div class="col">
                                <a href="#" class="btn w-100" data-bs-dismiss="modal">
                                    Cancel
                                </a>
                            </div>
                            <div class="col">
                                <button type="submit" class="btn btn-danger w-100" id="confirm-delete">
                                    Delete
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                <input type="hidden" name="RoomId" id="modal-room-id" />
            </form>
        </div>
    </div>
</div>
@*END DELETE MODAL*@
