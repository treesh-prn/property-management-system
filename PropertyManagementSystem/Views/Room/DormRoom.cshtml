@{
    ViewData["Title"] = "Home Page";

}
<div class="page-wrapper">
    <!-- Page header -->
    <div class="page-header d-print-none">
        <div class="container-xl">
            <div class="row g-2 align-items-center">
                <div class="col">
                    <!-- Page pre-title -->
                    <div class="page-pretitle">
                        Room
                    </div>
                    <h2 class="page-title">
                        DORMITORY
                    </h2>
                </div>
                <!-- Page title actions -->
                <div class="col-auto ms-auto d-print-none">
                    <div class="btn-list">
                        @*   <span class="d-none d-sm-inline">
                        <a href="#" class="btn">
                        New view
                        </a>
                        </span>
                        <a href="#" class="btn btn-primary d-none d-sm-inline-block" data-bs-toggle="modal" data-bs-target="#modal-report">
                        <!-- Download SVG icon from http://tabler-icons.io/i/plus -->
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M12 5l0 14" /><path d="M5 12l14 0" /></svg>
                        Create new report
                        </a>
                        <a href="#" class="btn btn-primary d-sm-none btn-icon" data-bs-toggle="modal" data-bs-target="#modal-report" aria-label="Create new report">
                        <!-- Download SVG icon from http://tabler-icons.io/i/plus -->
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M12 5l0 14" /><path d="M5 12l14 0" /></svg>
                        </a> *@
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Page body -->
    <div class="page-body">
        <div class="container-xl">
            <div class="row row-deck row-cards">
                <div class="col-lg-12 col-md-12">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title"></h3>
                            <div class="card-actions">
                                <a href="#" data-bs-toggle="modal" data-bs-target="#modal-newRoom" class="btn btn-primary">
                                    <i class="ti ti-home-plus icon"></i>
                                    New Dorm Room
                                </a>
                            </div>
                        </div>
                        <div class="card-body p-0">
                            @(
                                Html.Kendo().Grid<PropertyManagementSystem.Models.GFMS_Rooms>()
                                .Name("roomGrid")
                                .ToolBar(tools => tools.Excel())
                                .Excel(excel => excel
                                .FileName("Rooms.xlsx")
                                .AllPages(true))
                                .Columns(columns =>
                                {
                                    columns.Bound(c => c.RoomId).Visible(false).Exportable(false);
                                    columns.ForeignKey(c => c.FacilityId, ds => ds.Read(r => r.Action("getDMList", "Facility")), "FacilityId", "FacilityName").Title("Facility").Filterable(ftb => ftb.Cell(cell => cell.ShowOperators(false)));
                                    columns.Bound(c => c.RoomName);
                                    columns.Bound(c => c.Capacity);
                                    columns.Bound(c => c.isActive).Hidden(true).Width(100);
                                    columns.Bound(c => c.RoomStatus).Hidden(true).ClientTemplate(
                                    "# if(RoomStatus === 'Open') { #" +
                                    "<span class='status status-teal''><span class='status-dot status-dot-animated'></span>Open</span>" +
                                    "# } else if(RoomStatus === 'Occupied') { #" +
                                    "<span class='status status-red''><span class='status-dot status-dot-animated'></span>Occupied</span>" +
                                    "# } else if(RoomStatus === 'Under Maintenance') { #" +
                                    "<span class='status status-yellow''><span class='status-dot status-dot-animated'></span>Under Maintenance</span>" +
                                    "# } #"
                                    ).Title("Room Status");
                                    columns.Bound(c => c.RoomId)
                                    .ClientTemplate(
                                    "<div style='display: inline-block;'>" +
                                    "   <a href='" + Url.Action("ViewGuestRoom", "Room", new { RoomId = "#= RoomId #" }) + "' class='k-button k-grid-View k-button-sm k-rounded-md k-button-solid k-button-solid-success'><i class='ti ti-eye'></i>&nbsp;View</a>" +
                                    "</div>" +
                                    "<form class='delete-form' action='" + Url.Action("DeleteDMRoom", "Room") + "' method='post' style='display: inline-block;'>" +
                                    "   <button type='submit' class='k-button k-grid-delete k-button-sm k-rounded-md k-button-solid k-button-solid-danger'><i class='ti ti-trash'></i>&nbsp;Delete</button>" +
                                    "   <input type='hidden' name='RoomId' value='#= RoomId #' />" +
                                    "</form>"
                                    )
                                    .Title("Actions")
                                    .Exportable(false)
                                    .Filterable(false);

                                })
                                .Scrollable()
                                .ToolBar(toolbar =>
                                {
                                    toolbar.Search();
                                })
                                .DataSource(dataSource => dataSource
                                .Ajax()
                                .Model(model => model.Id(p => p.FacilityId))
                                .Group(group => group.Add(c => c.FacilityId))
                                .Read(read => read.Action("getDMRooms", "Room"))
                                .PageSize(50)
                                )
                                )


                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>



@*NEW ROOM MODAL *@
<div class="modal modal-blur fade" id="modal-newRoom" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">New Dorm Room</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="fcFRM1" asp-controller="Room" asp-action="newDMRoom" enctype="multipart/form-data" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label required">Name </label>
                        <input class="form-control" name="_name" type="text" required="required">
                    </div>
                    <div class="mb-3">
                        <label class="form-label required">Facility</label>
                        @(Html.Kendo().DropDownList()
                            .Name("_facility")
                            .DataTextField("FacilityName")
                            .DataValueField("FacilityId")
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("getDMList", "Facility");
                                });
                            })
                            .HtmlAttributes(new { style = "width: 100%" })
                            )
                    </div>
                    <div class="mb-3">
                        <label class="form-label required">Status</label>
                        @(Html.Kendo().DropDownList()
                            .Name("_status")
                            .BindTo(new List<SelectListItem>
                        {
                        new SelectListItem() {
                        Text = "Open",
                        Value = "Open"
                        },
                        new SelectListItem() {
                        Text = "Occupied",
                        Value = "Occupied"
                        },
                        new SelectListItem() {
                        Text = "Under Maintenance",
                        Value = "Under Maintenance"
                        },
                        })
                            .HtmlAttributes(new { style = "width: 100%" })
                            )
                    </div>
                    <div class="mb-3">
                        <label class="form-label required">Capacity</label>
                        <input class="form-control" name="_capacity" type="number" required="required">
                    </div>
                    <label class="row">
                        <span class="col form-label">Is Active</span>
                        <span class="col-auto">
                            <label class="form-check form-check-single form-switch">
                                <input class="form-check-input" id="switch" name="_isActive" type="checkbox" value="true" checked>
                            </label>
                        </span>
                    </label>
                </div>


                <div class="modal-footer">
                    <button id="svbtn15" type="submit" class="btn btn btn-success ms-auto">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>
@*END - NEW FACILITY MODAL *@