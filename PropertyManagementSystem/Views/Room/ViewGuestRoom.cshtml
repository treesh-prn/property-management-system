<div class="page-wrapper">
    <!-- Page header -->
    <div class="page-header d-print-none">
        <div class="container-xl">
            <div class="row g-2 align-items-center">
                <div class="col">
                    <!-- Page pre-title -->
                    <div class="page-pretitle">
                        View Room
                    </div>
                    @if (@Model.RoomType.Equals(0))
                    {
                        <h2 class="page-title">
                            Guest Room Details
                        </h2>
                    }
                    else if (Model.RoomType.Equals(1))
                    {
                        <h2 class="page-title">
                            Function Room Details
                        </h2>
                    }
                    else if (Model.RoomType.Equals(2))
                    {
                        <h2 class="page-title">
                            Dorm Room Details
                        </h2>
                    }
                </div>
                <!-- Page title actions -->
                <div class="col-auto ms-auto d-print-none">
                    <a id="editRoomButton" href="#offcanvasEnd" class="btn btn-primary" data-bs-toggle="offcanvas" data-bs-target="#offcanvasEnd" aria-controls="offcanvasEnd">
                        Edit Room
                    </a>
                </div>
            </div>
        </div>
    </div>
    <div class="page-body">
        <div class="container-xl">
            <div class="row row-cards">
                <div class="col-md-3">
                    <div class="card">
                        <div class="card-header card-header-light">
                            <h3 class="card-title">@Model.FacilityName</h3>
                        </div>
                        @if (Model.RoomType.Equals(0))
                        {
                            <img class="img-responsive2" src="@Url.Content("~/img/guest-room.jpg")">
                        }
                        else if (Model.RoomType.Equals(1))
                        {
                            <img class="img-responsive2" src="@Url.Content("~/img/facility-room.jpg")">
                        }
                        else if (Model.RoomType.Equals(2))
                        {
                            <img class="img-responsive2" src="@Url.Content("~/img/dorm-room.jpg")">
                        }
                    </div>
                </div>
                <div class="col-lg-9">
                    <div class="card">
                        @(Html.Kendo().TabStrip()
                                .Name("tabstrip")
                                .Animation(animation =>
                                animation.Open(effect =>
                                effect.Fade(FadeDirection.In)))
                                .Items(tabstrip =>
                                {
                                    tabstrip.Add().Text("Details")
                                .Encoded(false)
                                .Selected(true)
                                .Content(@<text>
                            <div id="details">
                                <partial name="Shared/_view" model="Model" />
                            </div>
                        </text>);
                                    @*tabstrip.Add().Text("Occupants")
                        .Encoded(false)
                        .Content(@<text>
                        <div id="occupants">
                        <partial name="Shared/_occupants" />
                        </div>
                        </text>); *@
                                })
                            )
                        <div class="card-footer">
                            @if (Model.RoomType.Equals(0))
                            {
                                <a href="@Url.Action("GuestRoom", "Room")" class="btn btn-link link-secondary">
                                    Go Back
                                </a>
                            }
                            else if (Model.RoomType.Equals(1))
                            {
                                <a href="@Url.Action("FunctionRoom", "Room")" class="btn btn-link link-secondary">
                                    Go Back
                                </a>
                            }
                            else if (Model.RoomType.Equals(2))
                            {
                                <a href="@Url.Action("DormRoom", "Room")" class="btn btn-link link-secondary">
                                    Go Back
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
            @*<button class="btn btn-primary" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasRight" aria-controls="offcanvasRight">Toggle right offcanvas</button>*@
            @*off canvas edit form*@
            <form asp-action="EditGHRoom" asp-controller="Room" method="post">
                <div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasEnd" aria-labelledby="offcanvasEndLabel">
                    <div class="offcanvas-header">
                        <h2 class="offcanvas-title" id="offcanvasEndLabel">Edit Room</h2>
                        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                    </div>
                    <div class="offcanvas-body">
                        <partial name="Shared/_update" />
                    </div>
                    <div class="offcanvas-footer border-top p-3">
                        <div class="mt-2 text-end">
                            <button type="submit" class="btn btn-primary">Save Changes</button>
                        </div>
                    </div>
                </div>
            </form>
            @*end of off canvas edit form*@
        </div>
    </div>
</div>