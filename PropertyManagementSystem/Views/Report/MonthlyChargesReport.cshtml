@using System.Globalization
@model IEnumerable<ReservationReport>

<div class="page-wrapper">
    <!-- Page header -->
    <div class="page-header d-print-none">
        <div class="container-xl">
            <div class="row g-2 align-items-center">
                <div class="col">
                    <!-- Page pre-title -->
                    <div class="page-pretitle">
                        REPORTS
                    </div>
                    <h2 class="page-title">
                        VIEW REPORT
                    </h2>
                </div>
                <!-- Page title actions -->
                <div class="col-auto ms-auto d-print-none">
                    <button type="button" class="btn btn-primary" onclick="javascript:window.print();">
                        <!-- Download SVG icon from http://tabler-icons.io/i/printer -->
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M17 17h2a2 2 0 0 0 2 -2v-4a2 2 0 0 0 -2 -2h-14a2 2 0 0 0 -2 2v4a2 2 0 0 0 2 2h2" /><path d="M17 9v-4a2 2 0 0 0 -2 -2h-6a2 2 0 0 0 -2 2v4" /><path d="M7 13m0 2a2 2 0 0 1 2 -2h6a2 2 0 0 1 2 2v4a2 2 0 0 1 -2 2h-6a2 2 0 0 1 -2 -2z" /></svg>
                        Print Report
                    </button>
                </div>
            </div>
        </div>
    </div>
    <!-- Page body -->
    <div class="page-body">
        <div class="container-xl">
            <div class="card card-lg">
                <div class="card-header">
                    <h3 class="card-title">Charge to Company Report</h3>
                </div>
                <div class="card-body">
                    <table class="table table-striped table-responsive">
                        <thead>
                            <tr>
                                <th>Charge to Company</th>
                                <th>Equipment Total Cost</th>
                                <th>Room Total Cost</th>
                                <th>Subtotal Cost</th>
                                <th>Total Cost</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var report in Model)
                            {
                                <tr>
                                    <td>@report.CompanyName</td>
                                    <td>@report.EquipmentTotalCost.ToString("C", new CultureInfo("en-PH"))</td>
                                    <td>@report.RoomTotalCost.ToString("C", new CultureInfo("en-PH"))</td>
                                    <td>@report.SubTotalCost.ToString("C", new CultureInfo("en-PH"))</td>
                                    <td>@report.TotalCost.ToString("C", new CultureInfo("en-PH"))</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="card-footer text-center">
                    <p class="text-secondary mt-9 mb-0">
                        This report is system generated. © 2024 TIPCO Estates Corporation. All rights reserved.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
