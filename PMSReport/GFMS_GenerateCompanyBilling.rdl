    <DataSet Name="FacilityClassification">
      <Query>
        <DataSourceName>TGI_Source</DataSourceName>
        <CommandText>SELECT DISTINCT FacilityClassification 
FROM GFMS_Facility 
WHERE FacilityClassification &lt;&gt; 'DORM'
ORDER BY FacilityClassification
</CommandText>
      </Query>
      <Fields>
        <Field Name="FacilityClassification">
          <DataField>FacilityClassification</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
